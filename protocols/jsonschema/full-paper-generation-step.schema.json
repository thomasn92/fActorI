{
  "$defs": {
    "FullPaperGenerationStepStatus": {
      "description": "Status of one full-paper generation orchestration step.",
      "enum": [
        "Pending",
        "Skipped",
        "Succeeded",
        "SucceededWithWarnings",
        "Blocked",
        "Failed"
      ],
      "title": "FullPaperGenerationStepStatus",
      "type": "string"
    }
  },
  "$id": "https://schemas.factori.local/0.10.0/full-paper-generation-step.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One step in the full-paper generation workflow.",
  "properties": {
    "artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Ids",
      "type": "array"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "status": {
      "$ref": "#/$defs/FullPaperGenerationStepStatus"
    },
    "step_name": {
      "minLength": 1,
      "title": "Step Name",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "step_name",
    "status",
    "summary"
  ],
  "title": "FullPaperGenerationStep",
  "type": "object",
  "x-factori-protocol-version": "0.10.0",
  "x-factori-source-model": "factori.schemas.FullPaperGenerationStep",
  "x-factori-verification-evidence": false
}
