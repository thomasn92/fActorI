{
  "$id": "https://schemas.factori.local/0.70.0/proof-verification-contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Provider-neutral proof verification request contract.",
  "properties": {
    "allow_external_calls": {
      "default": false,
      "title": "Allow External Calls",
      "type": "boolean"
    },
    "allow_external_tools": {
      "default": false,
      "title": "Allow External Tools",
      "type": "boolean"
    },
    "allowed_imports": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Imports",
      "type": "array"
    },
    "backend": {
      "default": "fake",
      "title": "Backend",
      "type": "string"
    },
    "candidate_id": {
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "claim_id": {
      "default": "claim-unspecified",
      "title": "Claim Id",
      "type": "string"
    },
    "claim_text": {
      "default": "",
      "title": "Claim Text",
      "type": "string"
    },
    "expected_output_type": {
      "default": "proof_transcript",
      "title": "Expected Output Type",
      "type": "string"
    },
    "fake_default": {
      "default": true,
      "title": "Fake Default",
      "type": "boolean"
    },
    "forbidden_tokens": {
      "items": {
        "type": "string"
      },
      "title": "Forbidden Tokens",
      "type": "array"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "proof_language": {
      "default": "Lean",
      "title": "Proof Language",
      "type": "string"
    },
    "proof_payload": {
      "additionalProperties": true,
      "title": "Proof Payload",
      "type": "object"
    },
    "proof_payload_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proof Payload Path"
    },
    "proof_payload_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proof Payload Text"
    },
    "timeout_seconds": {
      "default": 10,
      "maximum": 60,
      "minimum": 1,
      "title": "Timeout Seconds",
      "type": "integer"
    },
    "tool_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Name"
    }
  },
  "required": [
    "candidate_id"
  ],
  "title": "ProofVerificationContract",
  "type": "object",
  "x-factori-protocol-version": "0.70.0",
  "x-factori-source-model": "factori.schemas.ProofVerificationContract",
  "x-factori-verification-evidence": false
}
