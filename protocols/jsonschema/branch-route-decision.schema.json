{
  "$defs": {
    "BranchRouteExecutionHint": {
      "additionalProperties": false,
      "description": "Non-executing description of the next command class for a branch.",
      "properties": {
        "command_class_optional": {
          "anyOf": [
            {
              "enum": [
                "generate-experiment-spec",
                "run-benchmark-tournament",
                "search-counterexamples",
                "derive-symbolic-reduction",
                "build-proof-plan",
                "run-literature-novelty-check"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command Class Optional"
        },
        "executes_now": {
          "default": false,
          "title": "Executes Now",
          "type": "boolean"
        },
        "network_required": {
          "default": false,
          "title": "Network Required",
          "type": "boolean"
        },
        "ready_for_execution": {
          "title": "Ready For Execution",
          "type": "boolean"
        },
        "safety_notes": {
          "items": {
            "type": "string"
          },
          "title": "Safety Notes",
          "type": "array"
        },
        "suggested_arguments": {
          "items": {
            "type": "string"
          },
          "title": "Suggested Arguments",
          "type": "array"
        }
      },
      "required": [
        "ready_for_execution"
      ],
      "title": "BranchRouteExecutionHint",
      "type": "object"
    },
    "BranchRouteType": {
      "description": "Deterministic next-action classes for concrete scientific branches.",
      "enum": [
        "synthetic_experiment",
        "benchmark_tournament",
        "counterexample_search",
        "symbolic_derivation",
        "applied_math_reduction",
        "proof_plan",
        "literature_novelty_check",
        "defer_insufficient_substrate",
        "reject_false_bridge"
      ],
      "title": "BranchRouteType",
      "type": "string"
    }
  },
  "$id": "https://schemas.factori.local/0.83.0/branch-route-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One context-only route decision for a ScientificSubstrate.",
  "properties": {
    "branch_family": {
      "minLength": 1,
      "title": "Branch Family",
      "type": "string"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "defer_or_reject_reason_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Defer Or Reject Reason Optional"
    },
    "execution_hint": {
      "$ref": "#/$defs/BranchRouteExecutionHint"
    },
    "expected_outputs": {
      "items": {
        "type": "string"
      },
      "title": "Expected Outputs",
      "type": "array"
    },
    "idea_node_id_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idea Node Id Optional"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "method_lens": {
      "minLength": 1,
      "title": "Method Lens",
      "type": "string"
    },
    "publication_ready": {
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "required_artifacts": {
      "items": {
        "type": "string"
      },
      "title": "Required Artifacts",
      "type": "array"
    },
    "route_confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Route Confidence",
      "type": "number"
    },
    "route_id": {
      "minLength": 1,
      "title": "Route Id",
      "type": "string"
    },
    "route_type": {
      "$ref": "#/$defs/BranchRouteType"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "substrate_id": {
      "minLength": 1,
      "title": "Substrate Id",
      "type": "string"
    }
  },
  "required": [
    "route_id",
    "run_id",
    "substrate_id",
    "method_lens",
    "branch_family",
    "route_type",
    "route_confidence",
    "reason",
    "execution_hint"
  ],
  "title": "BranchRouteDecision",
  "type": "object",
  "x-factori-protocol-version": "0.83.0",
  "x-factori-source-model": "factori.schemas.BranchRouteDecision",
  "x-factori-verification-evidence": false
}
