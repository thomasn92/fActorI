{
  "$defs": {
    "BackendKind": {
      "description": "Authority classification for scientific and infrastructure backends.",
      "enum": [
        "fake",
        "fixture",
        "deterministic_template",
        "curated_catalog",
        "heuristic",
        "llm_openai",
        "llm_other",
        "retrieval_real",
        "local_execution",
        "symbolic_checker",
        "human"
      ],
      "title": "BackendKind",
      "type": "string"
    },
    "DomainAtlasEntry": {
      "additionalProperties": false,
      "description": "One curated domain entry used as production search infrastructure.",
      "properties": {
        "canonical_objects": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Canonical Objects",
          "type": "array"
        },
        "common_failure_modes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Common Failure Modes",
          "type": "array"
        },
        "data_types": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Data Types",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "domain_family": {
          "minLength": 1,
          "title": "Domain Family",
          "type": "string"
        },
        "domain_id": {
          "minLength": 1,
          "title": "Domain Id",
          "type": "string"
        },
        "example_questions": {
          "items": {
            "type": "string"
          },
          "title": "Example Questions",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "natural_baselines": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Natural Baselines",
          "type": "array"
        },
        "standard_metrics": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Standard Metrics",
          "type": "array"
        },
        "verification_modes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Verification Modes",
          "type": "array"
        }
      },
      "required": [
        "domain_id",
        "name",
        "domain_family",
        "description",
        "canonical_objects",
        "data_types",
        "natural_baselines",
        "verification_modes",
        "standard_metrics",
        "common_failure_modes"
      ],
      "title": "DomainAtlasEntry",
      "type": "object"
    },
    "DomainMethodPair": {
      "additionalProperties": false,
      "description": "One domain-method pair after exclusion-only compatibility analysis.",
      "properties": {
        "baseline_candidates": {
          "items": {
            "type": "string"
          },
          "title": "Baseline Candidates",
          "type": "array"
        },
        "compatibility_status": {
          "enum": [
            "compatible",
            "weak_compatible",
            "excluded"
          ],
          "title": "Compatibility Status",
          "type": "string"
        },
        "data_or_simulation_candidates": {
          "items": {
            "type": "string"
          },
          "title": "Data Or Simulation Candidates",
          "type": "array"
        },
        "domain_family": {
          "minLength": 1,
          "title": "Domain Family",
          "type": "string"
        },
        "domain_id": {
          "minLength": 1,
          "title": "Domain Id",
          "type": "string"
        },
        "method_family": {
          "minLength": 1,
          "title": "Method Family",
          "type": "string"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "object_mapping_candidates": {
          "items": {
            "type": "string"
          },
          "title": "Object Mapping Candidates",
          "type": "array"
        },
        "pair_id": {
          "minLength": 1,
          "title": "Pair Id",
          "type": "string"
        },
        "verification_path_candidates": {
          "items": {
            "type": "string"
          },
          "title": "Verification Path Candidates",
          "type": "array"
        }
      },
      "required": [
        "pair_id",
        "domain_id",
        "method_id",
        "domain_family",
        "method_family",
        "compatibility_status"
      ],
      "title": "DomainMethodPair",
      "type": "object"
    },
    "LLMPairRankingResult": {
      "additionalProperties": false,
      "description": "Non-fake LLM scientific judgment for one surviving atlas pair.",
      "properties": {
        "baseline_clarity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Baseline Clarity",
          "type": "number"
        },
        "false_bridge_risk": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "False Bridge Risk",
          "type": "number"
        },
        "novelty_hypothesis": {
          "minLength": 1,
          "title": "Novelty Hypothesis",
          "type": "string"
        },
        "pair_id": {
          "minLength": 1,
          "title": "Pair Id",
          "type": "string"
        },
        "paper_shape_clarity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Paper Shape Clarity",
          "type": "number"
        },
        "question_abundance": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Question Abundance",
          "type": "number"
        },
        "rank_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Rank Score",
          "type": "number"
        },
        "ranking_explanation": {
          "minLength": 1,
          "title": "Ranking Explanation",
          "type": "string"
        },
        "recommended_for_deep_discovery": {
          "title": "Recommended For Deep Discovery",
          "type": "boolean"
        },
        "scientific_fit": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Scientific Fit",
          "type": "number"
        },
        "tautology_risk": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Tautology Risk",
          "type": "number"
        },
        "tractability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Tractability",
          "type": "number"
        },
        "underuse_hypothesis": {
          "minLength": 1,
          "title": "Underuse Hypothesis",
          "type": "string"
        },
        "verification_feasibility": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Verification Feasibility",
          "type": "number"
        }
      },
      "required": [
        "pair_id",
        "rank_score",
        "scientific_fit",
        "tractability",
        "question_abundance",
        "baseline_clarity",
        "verification_feasibility",
        "paper_shape_clarity",
        "false_bridge_risk",
        "tautology_risk",
        "novelty_hypothesis",
        "underuse_hypothesis",
        "ranking_explanation",
        "recommended_for_deep_discovery"
      ],
      "title": "LLMPairRankingResult",
      "type": "object"
    },
    "MethodAtlasEntry": {
      "additionalProperties": false,
      "description": "One curated method lens used as production search infrastructure.",
      "properties": {
        "canonical_objects": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Canonical Objects",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "false_bridge_patterns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "False Bridge Patterns",
          "type": "array"
        },
        "method_family": {
          "minLength": 1,
          "title": "Method Family",
          "type": "string"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "natural_baselines": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Natural Baselines",
          "type": "array"
        },
        "natural_problem_types": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Natural Problem Types",
          "type": "array"
        },
        "required_inputs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Inputs",
          "type": "array"
        },
        "typical_outputs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Typical Outputs",
          "type": "array"
        },
        "verification_modes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Verification Modes",
          "type": "array"
        }
      },
      "required": [
        "method_id",
        "name",
        "method_family",
        "description",
        "canonical_objects",
        "natural_problem_types",
        "required_inputs",
        "typical_outputs",
        "verification_modes",
        "natural_baselines",
        "false_bridge_patterns"
      ],
      "title": "MethodAtlasEntry",
      "type": "object"
    },
    "ScientificStageKind": {
      "description": "Scientific-generation, judgment, execution, and validation stage classes.",
      "enum": [
        "opportunity_discovery",
        "atlas_construction",
        "compatibility_filter",
        "pair_ranking",
        "diversity_selection",
        "idea_tree_construction",
        "variance_generation",
        "substrate_construction",
        "substrate_selection",
        "branch_routing",
        "experiment_design",
        "spec_validation",
        "experiment_code_generation",
        "code_safety_audit",
        "experiment_execution",
        "metric_computation",
        "hybrid_evidence_planning",
        "symbolic_derivation",
        "adjudication",
        "adjudication_score_aggregation",
        "critic_review",
        "literature_retrieval",
        "novelty_assessment",
        "manuscript_planning",
        "manuscript_synthesis",
        "manuscript_artifact_assembly",
        "claim_audit",
        "bundle_verification"
      ],
      "title": "ScientificStageKind",
      "type": "string"
    },
    "StageBackendRecord": {
      "additionalProperties": false,
      "description": "Explicit authority classification for one pipeline stage backend.",
      "properties": {
        "allowed_in_production": {
          "title": "Allowed In Production",
          "type": "boolean"
        },
        "artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "backend_kind": {
          "$ref": "#/$defs/BackendKind"
        },
        "backend_name": {
          "minLength": 1,
          "title": "Backend Name",
          "type": "string"
        },
        "fallback_disclosed": {
          "default": true,
          "title": "Fallback Disclosed",
          "type": "boolean"
        },
        "fallback_used": {
          "default": false,
          "title": "Fallback Used",
          "type": "boolean"
        },
        "is_execution_or_verification": {
          "title": "Is Execution Or Verification",
          "type": "boolean"
        },
        "is_scientific_generation": {
          "title": "Is Scientific Generation",
          "type": "boolean"
        },
        "is_scientific_judgment": {
          "title": "Is Scientific Judgment",
          "type": "boolean"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "stage_id": {
          "minLength": 1,
          "title": "Stage Id",
          "type": "string"
        },
        "stage_kind": {
          "$ref": "#/$defs/ScientificStageKind"
        }
      },
      "required": [
        "stage_id",
        "stage_kind",
        "backend_kind",
        "backend_name",
        "is_scientific_generation",
        "is_scientific_judgment",
        "is_execution_or_verification",
        "allowed_in_production",
        "reason"
      ],
      "title": "StageBackendRecord",
      "type": "object"
    }
  },
  "$id": "https://schemas.factori.local/0.78.0/atlas-scan-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Curated atlas build or diversity-constrained LLM pair-scan report.",
  "properties": {
    "backend_records": {
      "items": {
        "$ref": "#/$defs/StageBackendRecord"
      },
      "title": "Backend Records",
      "type": "array"
    },
    "compatibility_filter_path_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compatibility Filter Path Optional"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "domain_count": {
      "minimum": 0,
      "title": "Domain Count",
      "type": "integer"
    },
    "domain_family_coverage": {
      "minimum": 0,
      "title": "Domain Family Coverage",
      "type": "integer"
    },
    "domains": {
      "items": {
        "$ref": "#/$defs/DomainAtlasEntry"
      },
      "title": "Domains",
      "type": "array"
    },
    "excluded_pair_count": {
      "minimum": 0,
      "title": "Excluded Pair Count",
      "type": "integer"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "llm_pair_ranking_path_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Llm Pair Ranking Path Optional"
    },
    "llm_ranked_pair_count": {
      "minimum": 0,
      "title": "Llm Ranked Pair Count",
      "type": "integer"
    },
    "method_count": {
      "minimum": 0,
      "title": "Method Count",
      "type": "integer"
    },
    "method_family_coverage": {
      "minimum": 0,
      "title": "Method Family Coverage",
      "type": "integer"
    },
    "methods": {
      "items": {
        "$ref": "#/$defs/MethodAtlasEntry"
      },
      "title": "Methods",
      "type": "array"
    },
    "production_ready": {
      "title": "Production Ready",
      "type": "boolean"
    },
    "publication_ready": {
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "raw_pair_count": {
      "minimum": 0,
      "title": "Raw Pair Count",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "scan_id": {
      "minLength": 1,
      "title": "Scan Id",
      "type": "string"
    },
    "scan_status": {
      "enum": [
        "atlas_built",
        "completed",
        "completed_with_warnings"
      ],
      "title": "Scan Status",
      "type": "string"
    },
    "selected_pair_count": {
      "minimum": 0,
      "title": "Selected Pair Count",
      "type": "integer"
    },
    "selected_pairs": {
      "items": {
        "$ref": "#/$defs/DomainMethodPair"
      },
      "title": "Selected Pairs",
      "type": "array"
    },
    "selected_rankings": {
      "items": {
        "$ref": "#/$defs/LLMPairRankingResult"
      },
      "title": "Selected Rankings",
      "type": "array"
    },
    "source_atlas_path_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Atlas Path Optional"
    },
    "surviving_pair_count": {
      "minimum": 0,
      "title": "Surviving Pair Count",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "scan_id",
    "scan_status",
    "domain_count",
    "method_count",
    "raw_pair_count",
    "excluded_pair_count",
    "surviving_pair_count",
    "llm_ranked_pair_count",
    "selected_pair_count",
    "domain_family_coverage",
    "method_family_coverage",
    "production_ready"
  ],
  "title": "AtlasScanReport",
  "type": "object",
  "x-factori-protocol-version": "0.78.0",
  "x-factori-source-model": "factori.schemas.AtlasScanReport",
  "x-factori-verification-evidence": false
}
