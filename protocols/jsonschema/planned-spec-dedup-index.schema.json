{
  "$defs": {
    "PlannedSpecDuplicateRecord": {
      "additionalProperties": false,
      "description": "One duplicate planned spec skipped by stable fingerprint.",
      "properties": {
        "creates_scientific_validation": {
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "duplicate_spec_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Duplicate Spec Fingerprint",
          "type": "string"
        },
        "duplicate_spec_path_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Spec Path Optional"
        },
        "existing_spec_path": {
          "minLength": 1,
          "title": "Existing Spec Path",
          "type": "string"
        },
        "gap_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap Fingerprint"
        },
        "implies_publication_readiness": {
          "default": false,
          "title": "Implies Publication Readiness",
          "type": "boolean"
        },
        "is_verification_evidence": {
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "skipped_new_spec_reason": {
          "minLength": 1,
          "title": "Skipped New Spec Reason",
          "type": "string"
        }
      },
      "required": [
        "duplicate_spec_fingerprint",
        "existing_spec_path",
        "skipped_new_spec_reason"
      ],
      "title": "PlannedSpecDuplicateRecord",
      "type": "object"
    }
  },
  "$id": "https://schemas.factori.local/0.58.0/planned-spec-dedup-index.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Derived de-duplication index over planned proof, experiment, and retrieval specs.",
  "properties": {
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "duplicate_records": {
      "items": {
        "$ref": "#/$defs/PlannedSpecDuplicateRecord"
      },
      "title": "Duplicate Records",
      "type": "array"
    },
    "duplicate_spec_count": {
      "default": 0,
      "minimum": 0,
      "title": "Duplicate Spec Count",
      "type": "integer"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "latest_updated_at": {
      "minLength": 1,
      "title": "Latest Updated At",
      "type": "string"
    },
    "publication_ready": {
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "spec_count": {
      "default": 0,
      "minimum": 0,
      "title": "Spec Count",
      "type": "integer"
    },
    "spec_fingerprints": {
      "items": {
        "type": "string"
      },
      "title": "Spec Fingerprints",
      "type": "array"
    },
    "unique_spec_count": {
      "default": 0,
      "minimum": 0,
      "title": "Unique Spec Count",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "latest_updated_at"
  ],
  "title": "PlannedSpecDedupIndex",
  "type": "object",
  "x-factori-protocol-version": "0.58.0",
  "x-factori-source-model": "factori.schemas.PlannedSpecDedupIndex",
  "x-factori-verification-evidence": false
}
