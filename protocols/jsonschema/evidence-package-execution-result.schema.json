{
  "$defs": {
    "EvidenceArtifactType": {
      "description": "Hybrid evidence-package artifact roles.",
      "enum": [
        "symbolic_reduction",
        "symbolic_derivation",
        "proof_plan",
        "numerical_illustration",
        "synthetic_experiment",
        "benchmark_tournament",
        "counterexample_search",
        "literature_novelty_check",
        "negative_control",
        "robustness_sweep",
        "defer_unavailable_checker",
        "defer_insufficient_support",
        "reject_false_bridge"
      ],
      "title": "EvidenceArtifactType",
      "type": "string"
    }
  },
  "$id": "https://schemas.factori.local/0.72.0/evidence-package-execution-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One executed, drafted, or deferred hybrid evidence-package artifact outcome.",
  "properties": {
    "artifact_plan_id": {
      "minLength": 1,
      "title": "Artifact Plan Id",
      "type": "string"
    },
    "artifact_type": {
      "$ref": "#/$defs/EvidenceArtifactType"
    },
    "baseline_summary": {
      "minLength": 1,
      "title": "Baseline Summary",
      "type": "string"
    },
    "control_summary": {
      "minLength": 1,
      "title": "Control Summary",
      "type": "string"
    },
    "creates_real_world_validation": {
      "const": false,
      "default": false,
      "title": "Creates Real World Validation",
      "type": "boolean"
    },
    "creates_scientific_validation": {
      "const": false,
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "creates_verified_theorem": {
      "const": false,
      "default": false,
      "title": "Creates Verified Theorem",
      "type": "boolean"
    },
    "draft_payload": {
      "additionalProperties": true,
      "title": "Draft Payload",
      "type": "object"
    },
    "evidence_label": {
      "enum": [
        "SyntheticExperimentEvidence",
        "BenchmarkEvidence",
        "CounterexampleEvidence",
        "SymbolicDerivationDraft",
        "SymbolicReductionDraft",
        "ProofPlanDraft",
        "RetrievalNoveltyAssessment",
        "NumericalIllustrationEvidence",
        "NegativeControlEvidence",
        "RobustnessSweepEvidence",
        "NegativeResult",
        "InconclusiveResult",
        "UnsupportedRouteDeferred",
        "RejectedFalseBridge"
      ],
      "title": "Evidence Label",
      "type": "string"
    },
    "failure_criteria_satisfied": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Criteria Satisfied"
    },
    "failure_reason_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason Optional"
    },
    "is_verification_evidence": {
      "const": false,
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "metric_sources": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Metric Sources",
      "type": "object"
    },
    "metrics": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          }
        ]
      },
      "title": "Metrics",
      "type": "object"
    },
    "negative_control_summary": {
      "minLength": 1,
      "title": "Negative Control Summary",
      "type": "string"
    },
    "novelty_proven": {
      "const": false,
      "default": false,
      "title": "Novelty Proven",
      "type": "boolean"
    },
    "package_id": {
      "minLength": 1,
      "title": "Package Id",
      "type": "string"
    },
    "publication_ready": {
      "const": false,
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "result_id": {
      "minLength": 1,
      "title": "Result Id",
      "type": "string"
    },
    "scope_label": {
      "minLength": 1,
      "title": "Scope Label",
      "type": "string"
    },
    "source_substrate_id": {
      "minLength": 1,
      "title": "Source Substrate Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "draft_created",
        "negative_result",
        "inconclusive",
        "failed",
        "blocked_safety_audit",
        "deferred_unavailable_checker",
        "deferred_insufficient_support",
        "rejected_false_bridge"
      ],
      "title": "Status",
      "type": "string"
    },
    "success_criteria_satisfied": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Success Criteria Satisfied"
    },
    "unresolved_obligations": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Obligations",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "result_id",
    "package_id",
    "artifact_plan_id",
    "source_substrate_id",
    "artifact_type",
    "status",
    "evidence_label",
    "scope_label",
    "baseline_summary",
    "control_summary",
    "negative_control_summary"
  ],
  "title": "EvidencePackageExecutionResult",
  "type": "object",
  "x-factori-protocol-version": "0.72.0",
  "x-factori-source-model": "factori.schemas.EvidencePackageExecutionResult",
  "x-factori-verification-evidence": false
}
