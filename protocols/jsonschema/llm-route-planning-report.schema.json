        },
        "scope_label": {
          "minLength": 1,
          "title": "Scope Label",
          "type": "string"
        },
        "success_criterion": {
          "minLength": 1,
          "title": "Success Criterion",
          "type": "string"
        }
      },
      "required": [
        "scope_label",
        "success_criterion",
        "failure_criterion"
      ],
      "title": "RouteExecutionOutputContract",
      "type": "object"
    },
    "ScientificStageKind": {
