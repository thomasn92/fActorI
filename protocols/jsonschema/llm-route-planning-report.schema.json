  "$id": "https://schemas.factori.local/0.83.0/llm-route-planning-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Append-only non-fake LLM route and execution-spec planning report.",
  "properties": {
    "backend_records": {
      "items": {
        "$ref": "#/$defs/StageBackendRecord"
      },
      "title": "Backend Records",
      "type": "array"
    },
    "compatibility_branch_route_plan_path": {
      "minLength": 1,
      "title": "Compatibility Branch Route Plan Path",
      "type": "string"
    },
    "compatibility_route_execution_specs_path": {
      "minLength": 1,
      "title": "Compatibility Route Execution Specs Path",
      "type": "string"
    },
    "config": {
      "$ref": "#/$defs/LLMRoutePlanningConfig"
    },
    "creates_real_world_validation": {
      "const": false,
      "default": false,
      "title": "Creates Real World Validation",
      "type": "boolean"
    },
    "creates_scientific_validation": {
      "const": false,
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/LLMRouteDecisionCandidate"
      },
      "title": "Decisions",
      "type": "array"
    },
    "execution_spec_count": {
      "minimum": 0,
      "title": "Execution Spec Count",
      "type": "integer"
    },
    "execution_specs": {
      "items": {
        "$ref": "#/$defs/LLMExecutionSpecCandidate"
      },
      "title": "Execution Specs",
      "type": "array"
    },
    "implies_publication_readiness": {
      "const": false,
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "const": false,
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "planning_status": {
      "enum": [
        "completed",
        "completed_with_warnings",
        "failed"
      ],
      "title": "Planning Status",
      "type": "string"
    },
    "production_ready": {
      "title": "Production Ready",
      "type": "boolean"
    },
    "publication_ready": {
      "const": false,
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "raw_artifact_paths": {
      "items": {
