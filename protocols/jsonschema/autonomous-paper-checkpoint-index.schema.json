{
  "$id": "https://schemas.factori.local/0.51.0/autonomous-paper-checkpoint-index.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable index snapshot over autonomous paper checkpoints.",
  "properties": {
    "checkpoint_count": {
      "minimum": 0,
      "title": "Checkpoint Count",
      "type": "integer"
    },
    "checkpoints": {
      "items": {
        "type": "string"
      },
      "title": "Checkpoints",
      "type": "array"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "latest_completed_stage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Completed Stage"
    },
    "latest_controller_run_id": {
      "minLength": 1,
      "title": "Latest Controller Run Id",
      "type": "string"
    },
    "publication_ready": {
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "resume_allowed": {
      "default": false,
      "title": "Resume Allowed",
      "type": "boolean"
    },
    "resume_blockers": {
      "items": {
        "type": "string"
      },
      "title": "Resume Blockers",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "latest_controller_run_id",
    "checkpoint_count"
  ],
  "title": "AutonomousPaperCheckpointIndex",
  "type": "object",
  "x-factori-protocol-version": "0.51.0",
  "x-factori-source-model": "factori.schemas.AutonomousPaperCheckpointIndex",
  "x-factori-verification-evidence": false
}
