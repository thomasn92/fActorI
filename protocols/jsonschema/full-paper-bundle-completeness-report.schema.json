{
  "$id": "https://schemas.factori.local/0.85.0/full-paper-bundle-completeness-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Artifact completeness and provenance report for a paper bundle.",
  "properties": {
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "hash_mismatch_artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Hash Mismatch Artifact Ids",
      "type": "array"
    },
    "missing_artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Missing Artifact Ids",
      "type": "array"
    },
    "missing_ledger_link_artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Missing Ledger Link Artifact Ids",
      "type": "array"
    },
    "present_artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Present Artifact Ids",
      "type": "array"
    },
    "required_artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Required Artifact Ids",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "complete"
  ],
  "title": "FullPaperBundleCompletenessReport",
  "type": "object",
  "x-factori-protocol-version": "0.85.0",
  "x-factori-source-model": "factori.schemas.FullPaperBundleCompletenessReport",
  "x-factori-verification-evidence": false
}
