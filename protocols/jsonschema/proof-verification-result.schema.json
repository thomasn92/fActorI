{
  "$defs": {
    "VerificationLabel": {
      "description": "Verification and epistemic labels required by the specification.",
      "enum": [
        "LeanVerified",
        "ExperimentVerified",
        "SyntheticExperimentVerified",
        "RealDataExperimentVerified",
        "Conjecture",
        "NegativeResult",
        "Limitation",
        "Unsupported"
      ],
      "title": "VerificationLabel",
      "type": "string"
    }
  },
  "$id": "https://schemas.factori.local/0.85.0/proof-verification-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Provider-neutral proof verification result for gated real proof backends.",
  "properties": {
    "backend": {
      "minLength": 1,
      "title": "Backend",
      "type": "string"
    },
    "candidate_id": {
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "claim_id": {
      "minLength": 1,
      "title": "Claim Id",
      "type": "string"
    },
    "elapsed_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Elapsed Ms"
    },
    "exit_code": {
      "title": "Exit Code",
      "type": "integer"
    },
    "fake": {
      "default": false,
      "title": "Fake",
      "type": "boolean"
    },
    "forbidden_tokens_present": {
      "title": "Forbidden Tokens Present",
      "type": "boolean"
    },
    "label": {
      "$ref": "#/$defs/VerificationLabel"
    },
    "proof_language": {
      "minLength": 1,
      "title": "Proof Language",
      "type": "string"
    },
    "proof_payload_hash": {
      "title": "Proof Payload Hash",
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "raw_trace_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Trace Artifact Id"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "safety_report_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Safety Report Artifact Id"
    },
    "stderr_hash": {
      "title": "Stderr Hash",
      "type": "string"
    },
    "stdout_hash": {
      "title": "Stdout Hash",
      "type": "string"
    },
    "tool_name": {
      "minLength": 1,
      "title": "Tool Name",
      "type": "string"
    },
    "tool_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Version"
    },
    "verified": {
      "title": "Verified",
      "type": "boolean"
    }
  },
  "required": [
    "candidate_id",
    "claim_id",
    "backend",
    "provider",
    "proof_language",
    "tool_name",
    "exit_code",
    "stdout_hash",
    "stderr_hash",
    "proof_payload_hash",
    "forbidden_tokens_present",
    "verified",
    "label",
    "reason"
  ],
  "title": "ProofVerificationResult",
  "type": "object",
  "x-factori-protocol-version": "0.85.0",
  "x-factori-source-model": "factori.schemas.ProofVerificationResult",
  "x-factori-verification-evidence": false
}
