{
  "$defs": {
    "CreativeMutationCandidate": {
      "additionalProperties": false,
      "description": "One tournament-driven scientific mutation candidate.",
      "properties": {
        "baseline": {
          "minLength": 1,
          "title": "Baseline",
          "type": "string"
        },
        "creates_scientific_validation": {
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "equations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Equations",
          "type": "array"
        },
        "expected_result_pattern": {
          "minLength": 1,
          "title": "Expected Result Pattern",
          "type": "string"
        },
        "experiment_design": {
          "minLength": 1,
          "title": "Experiment Design",
          "type": "string"
        },
        "implies_publication_readiness": {
          "default": false,
          "title": "Implies Publication Readiness",
          "type": "boolean"
        },
        "is_verification_evidence": {
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "model_object": {
          "minLength": 1,
          "title": "Model Object",
          "type": "string"
        },
        "mutation_id": {
          "minLength": 1,
          "title": "Mutation Id",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/CreativeMutationOperator"
        },
        "parent_tournament_result_id_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Tournament Result Id Optional"
        },
        "publication_ready": {
          "default": false,
          "title": "Publication Ready",
          "type": "boolean"
        },
        "research_question": {
          "minLength": 1,
          "title": "Research Question",
          "type": "string"
        },
        "risk_or_failure_mode": {
          "minLength": 1,
          "title": "Risk Or Failure Mode",
          "type": "string"
        },
        "selected_for_substrate_build": {
          "default": false,
          "title": "Selected For Substrate Build",
          "type": "boolean"
        },
        "source_idea_node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Idea Node Ids",
          "type": "array"
        },
        "source_substrate_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Substrate Ids",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "why_scientifically_distinct": {
          "minLength": 1,
          "title": "Why Scientifically Distinct",
          "type": "string"
        }
      },
      "required": [
        "mutation_id",
        "operator",
        "title",
        "domain",
        "research_question",
        "model_object",
        "equations",
        "baseline",
        "experiment_design",
        "expected_result_pattern",
        "why_scientifically_distinct",
        "risk_or_failure_mode"
      ],
      "title": "CreativeMutationCandidate",
      "type": "object"
    },
    "CreativeMutationOperator": {
      "description": "Tournament-driven scientific mutation operators.",
      "enum": [
        "winner_refinement",
        "loser_repair",
        "winner_loser_hybrid",
        "missing_axis_injection",
        "robustness_stress_test",
        "scale_change",
        "baseline_strengthening",
        "mechanism_change",
        "representation_change",
        "limitation_to_parameter"
      ],
      "title": "CreativeMutationOperator",
      "type": "string"
    },
    "CreativeMutationPlan": {
      "additionalProperties": false,
      "description": "Context-only plan for tournament-driven creative mutations.",
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/CreativeMutationCandidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "creates_scientific_validation": {
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "implies_publication_readiness": {
          "default": false,
          "title": "Implies Publication Readiness",
          "type": "boolean"
        },
        "is_verification_evidence": {
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "max_mutations": {
          "minimum": 1,
          "title": "Max Mutations",
          "type": "integer"
        },
        "mutation_count": {
          "minimum": 0,
          "title": "Mutation Count",
          "type": "integer"
        },
        "operators_used": {
          "items": {
            "$ref": "#/$defs/CreativeMutationOperator"
          },
          "title": "Operators Used",
          "type": "array"
        },
        "plan_id": {
          "minLength": 1,
          "title": "Plan Id",
          "type": "string"
        },
        "planning_status": {
          "enum": [
            "completed",
            "completed_with_warnings",
            "failed"
          ],
          "title": "Planning Status",
          "type": "string"
        },
        "publication_ready": {
          "default": false,
          "title": "Publication Ready",
          "type": "boolean"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "selected_for_substrate_build_count": {
          "minimum": 0,
          "title": "Selected For Substrate Build Count",
          "type": "integer"
        },
        "source_idea_space_report_path_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Idea Space Report Path Optional"
        },
        "source_idea_tree_present": {
          "title": "Source Idea Tree Present",
          "type": "boolean"
        },
        "source_scientific_substrate_build_path_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Scientific Substrate Build Path Optional"
        },
        "source_substrate_tournament_result_path_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Substrate Tournament Result Path Optional"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "plan_id",
        "planning_status",
        "source_idea_tree_present",
        "max_mutations",
        "mutation_count",
        "selected_for_substrate_build_count"
      ],
      "title": "CreativeMutationPlan",
      "type": "object"
    },
    "CreativeMutationReport": {
      "additionalProperties": false,
      "description": "Append-only report for applied creative mutations.",
      "properties": {
        "applied_mutation_count": {
          "minimum": 0,
          "title": "Applied Mutation Count",
          "type": "integer"
        },
        "apply_status": {
          "enum": [
            "completed",
            "completed_with_warnings",
            "failed"
          ],
          "title": "Apply Status",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/CreativeMutationCandidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "creates_scientific_validation": {
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "idea_tree_node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Idea Tree Node Ids",
          "type": "array"
        },
        "implies_publication_readiness": {
          "default": false,
          "title": "Implies Publication Readiness",
          "type": "boolean"
        },
        "is_verification_evidence": {
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "mutation_report_id": {
          "minLength": 1,
          "title": "Mutation Report Id",
          "type": "string"
        },
        "new_idea_tree_node_count": {
          "minimum": 0,
          "title": "New Idea Tree Node Count",
          "type": "integer"
        },
        "new_scientific_substrate_count": {
          "minimum": 0,
          "title": "New Scientific Substrate Count",
          "type": "integer"
        },
        "publication_ready": {
          "default": false,
          "title": "Publication Ready",
          "type": "boolean"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "scientific_substrate_build_report_path_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scientific Substrate Build Report Path Optional"
        },
        "scientific_substrate_paths": {
          "items": {
            "type": "string"
          },
          "title": "Scientific Substrate Paths",
          "type": "array"
        },
        "selected_for_substrate_build_count": {
          "minimum": 0,
          "title": "Selected For Substrate Build Count",
          "type": "integer"
        },
        "source_plan_path": {
          "minLength": 1,
          "title": "Source Plan Path",
          "type": "string"
        },
        "source_tournament_result_id_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Tournament Result Id Optional"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "mutation_report_id",
        "apply_status",
        "source_plan_path",
        "applied_mutation_count",
        "selected_for_substrate_build_count",
        "new_idea_tree_node_count",
        "new_scientific_substrate_count"
      ],
      "title": "CreativeMutationReport",
      "type": "object"
    }
  },
  "$id": "https://schemas.factori.local/0.64.0/creative-mutation-inspection-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Read-only inspection report for creative mutation planning and application.",
  "properties": {
    "applied_mutation_count": {
      "minimum": 0,
      "title": "Applied Mutation Count",
      "type": "integer"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/CreativeMutationCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "creative_mutation_plan_present": {
      "title": "Creative Mutation Plan Present",
      "type": "boolean"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "includes_boundary_perturbation_robustness": {
      "default": false,
      "title": "Includes Boundary Perturbation Robustness",
      "type": "boolean"
    },
    "includes_gravity_low_rank_hybrid": {
      "default": false,
      "title": "Includes Gravity Low Rank Hybrid",
      "type": "boolean"
    },
    "includes_hierarchical_alpha_mutation": {
      "default": false,
      "title": "Includes Hierarchical Alpha Mutation",
      "type": "boolean"
    },
    "includes_kernelized_spatial_interaction": {
      "default": false,
      "title": "Includes Kernelized Spatial Interaction",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "latest_apply_report_id_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Apply Report Id Optional"
    },
    "latest_plan_id_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Plan Id Optional"
    },
    "latest_plan_optional": {
      "anyOf": [
        {
          "$ref": "#/$defs/CreativeMutationPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "latest_report_optional": {
      "anyOf": [
        {
          "$ref": "#/$defs/CreativeMutationReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mutation_count": {
      "minimum": 0,
      "title": "Mutation Count",
      "type": "integer"
    },
    "new_idea_tree_nodes_added": {
      "default": false,
      "title": "New Idea Tree Nodes Added",
      "type": "boolean"
    },
    "new_scientific_substrates_created": {
      "default": false,
      "title": "New Scientific Substrates Created",
      "type": "boolean"
    },
    "publication_ready": {
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "selected_for_substrate_build_count": {
      "minimum": 0,
      "title": "Selected For Substrate Build Count",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "creative_mutation_plan_present",
    "mutation_count",
    "selected_for_substrate_build_count",
    "applied_mutation_count"
  ],
  "title": "CreativeMutationInspectionReport",
  "type": "object",
  "x-factori-protocol-version": "0.64.0",
  "x-factori-source-model": "factori.schemas.CreativeMutationInspectionReport",
  "x-factori-verification-evidence": false
}
