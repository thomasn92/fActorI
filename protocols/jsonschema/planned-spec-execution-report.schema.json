{
  "$defs": {
    "PlannedSpecExecutionItem": {
      "additionalProperties": false,
      "description": "One bounded disposition of a planned proof/experiment/retrieval spec.",
      "properties": {
        "created_artifact_path_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created Artifact Path Optional"
        },
        "creates_scientific_validation": {
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "deferred_reason_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deferred Reason Optional"
        },
        "execution_attempt_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Attempt Fingerprint"
        },
        "execution_status": {
          "enum": [
            "planned",
            "executed",
            "deferred",
            "rejected",
            "failed",
            "skipped"
          ],
          "title": "Execution Status",
          "type": "string"
        },
        "executor_decision": {
          "enum": [
            "would_execute",
            "execute",
            "defer",
            "reject",
            "skip"
          ],
          "title": "Executor Decision",
          "type": "string"
        },
        "failed_reason_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failed Reason Optional"
        },
        "gap_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap Fingerprint"
        },
        "implies_publication_readiness": {
          "default": false,
          "title": "Implies Publication Readiness",
          "type": "boolean"
        },
        "ingested_artifact_path_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ingested Artifact Path Optional"
        },
        "is_verification_evidence": {
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "planned_spec_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planned Spec Fingerprint"
        },
        "rejected_reason_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejected Reason Optional"
        },
        "safety_notes": {
          "items": {
            "type": "string"
          },
          "title": "Safety Notes",
          "type": "array"
        },
        "spec_id": {
          "minLength": 1,
          "title": "Spec Id",
          "type": "string"
        },
        "spec_type": {
          "enum": [
            "experiment_spec",
            "proof_obligation_spec",
            "retrieval_expansion_request"
          ],
          "title": "Spec Type",
          "type": "string"
        },
        "target_claim_id_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Claim Id Optional"
        }
      },
      "required": [
        "item_id",
        "spec_id",
        "spec_type",
        "executor_decision",
        "execution_status"
      ],
      "title": "PlannedSpecExecutionItem",
      "type": "object"
    }
  },
  "$id": "https://schemas.factori.local/0.69.0/planned-spec-execution-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Non-evidence planned local spec execution report.",
  "properties": {
    "autonomous_plan_rebuilt": {
      "default": false,
      "title": "Autonomous Plan Rebuilt",
      "type": "boolean"
    },
    "claim_evidence_map_rebuilt": {
      "default": false,
      "title": "Claim Evidence Map Rebuilt",
      "type": "boolean"
    },
    "created_artifact_paths": {
      "items": {
        "type": "string"
      },
      "title": "Created Artifact Paths",
      "type": "array"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "duplicate_specs_skipped": {
      "default": 0,
      "minimum": 0,
      "title": "Duplicate Specs Skipped",
      "type": "integer"
    },
    "execution_id": {
      "minLength": 1,
      "title": "Execution Id",
      "type": "string"
    },
    "execution_mode": {
      "enum": [
        "dry_run",
        "apply"
      ],
      "title": "Execution Mode",
      "type": "string"
    },
    "execution_status": {
      "enum": [
        "completed",
        "completed_with_deferred_specs",
        "blocked",
        "failed",
        "dry_run_completed"
      ],
      "title": "Execution Status",
      "type": "string"
    },
    "executions_marked_no_progress": {
      "default": 0,
      "minimum": 0,
      "title": "Executions Marked No Progress",
      "type": "integer"
    },
    "experiment_artifacts_created": {
      "default": 0,
      "minimum": 0,
      "title": "Experiment Artifacts Created",
      "type": "integer"
    },
    "experiment_specs_executed": {
      "default": 0,
      "minimum": 0,
      "title": "Experiment Specs Executed",
      "type": "integer"
    },
    "experiment_specs_found": {
      "default": 0,
      "minimum": 0,
      "title": "Experiment Specs Found",
      "type": "integer"
    },
    "gap_attempt_history_updated": {
      "default": false,
      "title": "Gap Attempt History Updated",
      "type": "boolean"
    },
    "human_intervention_reason_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Human Intervention Reason Optional"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "ingested_artifact_paths": {
      "items": {
        "type": "string"
      },
      "title": "Ingested Artifact Paths",
      "type": "array"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/PlannedSpecExecutionItem"
      },
      "title": "Items",
      "type": "array"
    },
    "manuscript_refreshed": {
      "default": false,
      "title": "Manuscript Refreshed",
      "type": "boolean"
    },
    "proof_artifacts_created": {
      "default": 0,
      "minimum": 0,
      "title": "Proof Artifacts Created",
      "type": "integer"
    },
    "proof_specs_executed": {
      "default": 0,
      "minimum": 0,
      "title": "Proof Specs Executed",
      "type": "integer"
    },
    "proof_specs_found": {
      "default": 0,
      "minimum": 0,
      "title": "Proof Specs Found",
      "type": "integer"
    },
    "publication_ready": {
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "release_rechecked": {
      "default": false,
      "title": "Release Rechecked",
      "type": "boolean"
    },
    "requires_human_intervention": {
      "default": false,
      "title": "Requires Human Intervention",
      "type": "boolean"
    },
    "retrieval_artifacts_created": {
      "default": 0,
      "minimum": 0,
      "title": "Retrieval Artifacts Created",
      "type": "integer"
    },
    "retrieval_specs_executed": {
      "default": 0,
      "minimum": 0,
      "title": "Retrieval Specs Executed",
      "type": "integer"
    },
    "retrieval_specs_found": {
      "default": 0,
      "minimum": 0,
      "title": "Retrieval Specs Found",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "spec_count": {
      "default": 0,
      "minimum": 0,
      "title": "Spec Count",
      "type": "integer"
    },
    "spec_executor_backend": {
      "default": "deterministic_local",
      "enum": [
        "deterministic_local",
        "fake",
        "external_tool"
      ],
      "title": "Spec Executor Backend",
      "type": "string"
    },
    "specs_attempted": {
      "default": 0,
      "minimum": 0,
      "title": "Specs Attempted",
      "type": "integer"
    },
    "specs_deferred": {
      "default": 0,
      "minimum": 0,
      "title": "Specs Deferred",
      "type": "integer"
    },
    "specs_executed": {
      "default": 0,
      "minimum": 0,
      "title": "Specs Executed",
      "type": "integer"
    },
    "specs_failed": {
      "default": 0,
      "minimum": 0,
      "title": "Specs Failed",
      "type": "integer"
    },
    "specs_rejected": {
      "default": 0,
      "minimum": 0,
      "title": "Specs Rejected",
      "type": "integer"
    },
    "unique_specs_executed": {
      "default": 0,
      "minimum": 0,
      "title": "Unique Specs Executed",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "execution_id",
    "execution_mode",
    "execution_status"
  ],
  "title": "PlannedSpecExecutionReport",
  "type": "object",
  "x-factori-protocol-version": "0.69.0",
  "x-factori-source-model": "factori.schemas.PlannedSpecExecutionReport",
  "x-factori-verification-evidence": false
}
