{
  "$id": "https://schemas.factori.local/0.88.0/llm-route-planning-config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded configuration for non-fake LLM route and execution-spec planning.",
  "properties": {
    "backend": {
      "minLength": 1,
      "title": "Backend",
      "type": "string"
    },
    "fail_on_silent_fallback": {
      "default": true,
      "title": "Fail On Silent Fallback",
      "type": "boolean"
    },
    "max_planning_calls": {
      "default": 12,
      "minimum": 1,
      "title": "Max Planning Calls",
      "type": "integer"
    },
    "max_source_substrates": {
      "default": 12,
      "minimum": 1,
      "title": "Max Source Substrates",
      "type": "integer"
    },
    "require_non_fake_backends": {
      "default": false,
      "title": "Require Non Fake Backends",
      "type": "boolean"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "backend"
  ],
  "title": "LLMRoutePlanningConfig",
  "type": "object",
  "x-factori-protocol-version": "0.88.0",
  "x-factori-source-model": "factori.schemas.LLMRoutePlanningConfig",
  "x-factori-verification-evidence": false
}
