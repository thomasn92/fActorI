{
  "$id": "https://schemas.factori.local/0.90.0/autonomous-plan-execution-action.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One deterministic autonomous plan execution action.",
  "properties": {
    "action_id": {
      "minLength": 1,
      "title": "Action Id",
      "type": "string"
    },
    "after_hash_optional": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "After Hash Optional"
    },
    "applied": {
      "default": false,
      "title": "Applied",
      "type": "boolean"
    },
    "before_hash_optional": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Before Hash Optional"
    },
    "created_artifact_path_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created Artifact Path Optional"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "deferred_reason_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deferred Reason Optional"
    },
    "dry_run": {
      "title": "Dry Run",
      "type": "boolean"
    },
    "execution_decision": {
      "enum": [
        "would_apply",
        "apply",
        "noop",
        "defer",
        "reject",
        "skip"
      ],
      "title": "Execution Decision",
      "type": "string"
    },
    "execution_status": {
      "enum": [
        "planned",
        "completed",
        "deferred",
        "rejected",
        "failed",
        "skipped"
      ],
      "title": "Execution Status",
      "type": "string"
    },
    "gap_fingerprint": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gap Fingerprint"
    },
    "gap_type": {
      "enum": [
        "needs_python_experiment",
        "needs_formal_proof",
        "needs_retrieval_expansion",
        "needs_claim_downgrade",
        "needs_claim_removal",
        "needs_manuscript_refresh",
        "sufficiently_supported_for_bounded_draft"
      ],
      "title": "Gap Type",
      "type": "string"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "plan_item_fingerprint": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Item Fingerprint"
    },
    "plan_item_id": {
      "minLength": 1,
      "title": "Plan Item Id",
      "type": "string"
    },
    "planned_spec_fingerprint_optional": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Planned Spec Fingerprint Optional"
    },
    "recommended_action": {
      "minLength": 1,
      "title": "Recommended Action",
      "type": "string"
    },
    "rejected_reason_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejected Reason Optional"
    },
    "safety_notes": {
      "items": {
        "type": "string"
      },
      "title": "Safety Notes",
      "type": "array"
    },
    "source_gap_fingerprint_optional": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Gap Fingerprint Optional"
    },
    "strategy_family_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Strategy Family Optional"
    },
    "strategy_fingerprint_optional": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Strategy Fingerprint Optional"
    },
    "target_claim_id_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Claim Id Optional"
    },
    "target_section_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Section Optional"
    }
  },
  "required": [
    "action_id",
    "plan_item_id",
    "gap_type",
    "recommended_action",
    "execution_decision",
    "execution_status",
    "dry_run"
  ],
  "title": "AutonomousPlanExecutionAction",
  "type": "object",
  "x-factori-protocol-version": "0.90.0",
  "x-factori-source-model": "factori.schemas.AutonomousPlanExecutionAction",
  "x-factori-verification-evidence": false
}
