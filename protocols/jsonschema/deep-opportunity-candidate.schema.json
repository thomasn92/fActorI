  "required": [
    "opportunity_id",
    "run_id",
    "source_pair_id",
    "domain_id",
    "method_id",
    "domain_name",
    "method_name",
    "research_question",
    "hypothesis",
    "theory_or_model_object",
    "mathematical_or_computational_form",
    "experiment_or_proof_plan",
    "benchmark_plan",
    "baseline_candidates",
    "expected_metrics",
    "failure_modes",
    "negative_controls",
    "data_regime",
    "verification_path",
    "paper_shape",
    "novelty_risk",
    "underuse_hypothesis",
    "retrieval_support_summary",
    "recommended_next_stage"
  ],
  "title": "DeepOpportunityCandidate",
  "type": "object",
  "x-factori-protocol-version": "0.64.0",
  "x-factori-source-model": "factori.schemas.DeepOpportunityCandidate",
  "x-factori-verification-evidence": false
}
