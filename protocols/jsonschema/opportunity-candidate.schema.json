          "type": "array"
        },
        "data_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Data Requirements",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "example_domains": {
          "items": {
            "type": "string"
          },
          "title": "Example Domains",
          "type": "array"
        },
        "method_family": {
          "minLength": 1,
          "title": "Method Family",
          "type": "string"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "typical_baselines": {
          "items": {
            "type": "string"
          },
