{
  "$defs": {
    "DomainPrimitive": {
      "additionalProperties": false,
      "description": "One deterministic Stage 0 primitive extracted from a broad research domain.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "example_instantiations": {
          "items": {
            "type": "string"
          },
          "title": "Example Instantiations",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "primitive_id": {
          "minLength": 1,
          "title": "Primitive Id",
          "type": "string"
        },
        "primitive_type": {
          "minLength": 1,
          "title": "Primitive Type",
          "type": "string"
        },
        "symbolic_tags": {
          "items": {
            "type": "string"
          },
          "title": "Symbolic Tags",
          "type": "array"
        }
      },
      "required": [
        "primitive_id",
        "domain",
        "name",
        "primitive_type",
        "description"
      ],
      "title": "DomainPrimitive",
      "type": "object"
    },
    "MethodLens": {
      "additionalProperties": false,
