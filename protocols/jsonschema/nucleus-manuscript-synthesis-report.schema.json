            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "is_verification_evidence": {
          "const": false,
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "publication_ready": {
          "const": false,
          "default": false,
          "title": "Publication Ready",
          "type": "boolean"
        },
        "recommended_revisions": {
          "items": {
            "type": "string"
          },
