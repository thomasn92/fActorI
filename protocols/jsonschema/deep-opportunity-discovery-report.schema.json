{
  "$defs": {
    "BackendKind": {
      "description": "Authority classification for scientific and infrastructure backends.",
      "enum": [
        "fake",
        "fixture",
        "deterministic_template",
        "curated_catalog",
        "heuristic",
        "llm_openai",
        "llm_other",
        "retrieval_real",
        "local_execution",
        "symbolic_checker",
        "human"
      ],
      "title": "BackendKind",
      "type": "string"
    },
    "DeepOpportunityCandidate": {
      "additionalProperties": false,
      "description": "Concrete non-fake LLM opportunity grounded in atlas and retrieval context.",
      "properties": {
        "baseline_candidates": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Baseline Candidates",
          "type": "array"
        },
        "benchmark_plan": {
          "minLength": 1,
          "title": "Benchmark Plan",
          "type": "string"
        },
        "creates_scientific_validation": {
          "const": false,
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "data_regime": {
          "minLength": 1,
          "title": "Data Regime",
          "type": "string"
        },
        "domain_id": {
          "minLength": 1,
          "title": "Domain Id",
          "type": "string"
        },
        "domain_name": {
          "minLength": 1,
          "title": "Domain Name",
          "type": "string"
        },
        "expected_metrics": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Expected Metrics",
          "type": "array"
        },
        "experiment_or_proof_plan": {
          "minLength": 1,
          "title": "Experiment Or Proof Plan",
          "type": "string"
        },
        "failure_modes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Failure Modes",
          "type": "array"
        },
        "false_bridge_risks": {
          "items": {
            "type": "string"
          },
          "title": "False Bridge Risks",
          "type": "array"
        },
        "hypothesis": {
          "minLength": 1,
          "title": "Hypothesis",
          "type": "string"
        },
        "implies_publication_readiness": {
          "const": false,
          "default": false,
          "title": "Implies Publication Readiness",
          "type": "boolean"
        },
        "is_verification_evidence": {
          "const": false,
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "mathematical_or_computational_form": {
          "minLength": 1,
          "title": "Mathematical Or Computational Form",
          "type": "string"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "method_name": {
          "minLength": 1,
          "title": "Method Name",
          "type": "string"
        },
        "negative_controls": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Negative Controls",
          "type": "array"
        },
        "novelty_risk": {
          "minLength": 1,
          "title": "Novelty Risk",
          "type": "string"
        },
        "opportunity_id": {
          "minLength": 1,
          "title": "Opportunity Id",
          "type": "string"
        },
        "paper_shape": {
          "minLength": 1,
          "title": "Paper Shape",
          "type": "string"
        },
        "publication_ready": {
          "const": false,
          "default": false,
          "title": "Publication Ready",
          "type": "boolean"
        },
        "recommended_next_stage": {
          "minLength": 1,
          "title": "Recommended Next Stage",
          "type": "string"
        },
        "research_question": {
          "minLength": 1,
          "title": "Research Question",
          "type": "string"
        },
        "retrieval_contradictions": {
          "items": {
            "type": "string"
          },
          "title": "Retrieval Contradictions",
          "type": "array"
        },
        "retrieval_support_summary": {
          "minLength": 1,
          "title": "Retrieval Support Summary",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "source_pair_id": {
          "minLength": 1,
          "title": "Source Pair Id",
          "type": "string"
        },
        "tautology_risks": {
          "items": {
            "type": "string"
          },
          "title": "Tautology Risks",
