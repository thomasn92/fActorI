        "novelty_risk",
        "underuse_hypothesis",
        "retrieval_support_summary",
        "recommended_next_stage"
      ],
      "title": "DeepOpportunityCandidate",
      "type": "object"
    },
    "DeepOpportunityDiscoveryConfig": {
      "additionalProperties": false,
      "description": "Bounded configuration for retrieval-contextualized LLM opportunity generation.",
      "properties": {
        "backend": {
          "minLength": 1,
          "title": "Backend",
          "type": "string"
        },
        "fail_on_silent_fallback": {
          "default": true,
          "title": "Fail On Silent Fallback",
          "type": "boolean"
        },
        "max_generation_calls": {
          "default": 30,
          "minimum": 1,
          "title": "Max Generation Calls",
          "type": "integer"
        },
        "max_opportunities_per_domain_family": {
          "default": 6,
          "minimum": 1,
          "title": "Max Opportunities Per Domain Family",
          "type": "integer"
        },
        "max_opportunities_per_method_family": {
          "default": 6,
          "minimum": 1,
          "title": "Max Opportunities Per Method Family",
          "type": "integer"
        },
        "max_pairs": {
          "default": 30,
          "minimum": 1,
          "title": "Max Pairs",
          "type": "integer"
        },
        "max_retrieval_sources_per_pair": {
          "default": 5,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Retrieval Sources Per Pair",
          "type": "integer"
        },
        "max_selected_opportunities": {
          "default": 40,
          "minimum": 1,
          "title": "Max Selected Opportunities",
          "type": "integer"
        },
        "min_domain_family_coverage": {
          "default": 8,
          "minimum": 1,
          "title": "Min Domain Family Coverage",
          "type": "integer"
        },
        "min_method_family_coverage": {
          "default": 8,
          "minimum": 1,
          "title": "Min Method Family Coverage",
          "type": "integer"
        },
        "near_duplicate_suppression": {
          "default": true,
          "title": "Near Duplicate Suppression",
          "type": "boolean"
        },
        "opportunities_per_pair": {
          "default": 3,
          "maximum": 4,
          "minimum": 2,
          "title": "Opportunities Per Pair",
          "type": "integer"
        },
        "require_non_fake_backends": {
          "default": false,
          "title": "Require Non Fake Backends",
          "type": "boolean"
        },
        "retrieval_mode": {
          "enum": [
            "mocked_retrieval",
            "real_retrieval"
          ],
          "title": "Retrieval Mode",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "source_mode": {
          "default": "atlas_scan",
          "enum": [
            "atlas_scan",
            "targeted_brief"
          ],
          "title": "Source Mode",
          "type": "string"
        },
        "targeted_brief_path_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Targeted Brief Path Optional"
        }
      },
      "required": [
        "run_id",
        "backend",
        "retrieval_mode"
      ],
      "title": "DeepOpportunityDiscoveryConfig",
      "type": "object"
    },
    "DeepOpportunityScore": {
      "additionalProperties": false,
      "description": "Non-fake LLM scientific score for one concrete opportunity.",
      "properties": {
        "baseline_strength": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Baseline Strength",
          "type": "number"
        },
        "expected_signal": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Expected Signal",
          "type": "number"
        },
        "failure_mode_value": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Failure Mode Value",
          "type": "number"
        },
        "false_bridge_penalty": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "False Bridge Penalty",
          "type": "number"
        },
        "final_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Final Score",
          "type": "number"
        },
        "novelty_risk_penalty": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Novelty Risk Penalty",
          "type": "number"
        },
        "opportunity_id": {
          "minLength": 1,
          "title": "Opportunity Id",
          "type": "string"
        },
        "paper_coherence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Paper Coherence",
          "type": "number"
        },
        "question_specificity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Question Specificity",
          "type": "number"
        },
        "retrieval_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Retrieval Confidence",
          "type": "number"
        },
        "scientific_fit": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Scientific Fit",
          "type": "number"
        },
        "score_explanation": {
          "minLength": 1,
          "title": "Score Explanation",
          "type": "string"
        },
        "tautology_penalty": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Tautology Penalty",
          "type": "number"
        },
        "tractability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Tractability",
          "type": "number"
        },
        "verification_feasibility": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Verification Feasibility",
          "type": "number"
        }
      },
      "required": [
        "opportunity_id",
        "scientific_fit",
        "tractability",
        "question_specificity",
        "baseline_strength",
        "verification_feasibility",
        "expected_signal",
        "failure_mode_value",
        "paper_coherence",
        "novelty_risk_penalty",
        "false_bridge_penalty",
        "tautology_penalty",
        "retrieval_confidence",
        "final_score",
        "score_explanation"
      ],
      "title": "DeepOpportunityScore",
      "type": "object"
    },
