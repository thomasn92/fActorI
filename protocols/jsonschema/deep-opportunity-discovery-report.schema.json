  "$id": "https://schemas.factori.local/0.78.0/deep-opportunity-discovery-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Append-only retrieval-contextualized LLM opportunity discovery report.",
  "properties": {
    "attempted_pair_count": {
      "minimum": 0,
      "title": "Attempted Pair Count",
      "type": "integer"
    },
    "backend_records": {
      "items": {
        "$ref": "#/$defs/StageBackendRecord"
      },
      "title": "Backend Records",
      "type": "array"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/DeepOpportunityCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "config": {
      "$ref": "#/$defs/DeepOpportunityDiscoveryConfig"
    },
    "creates_scientific_validation": {
      "const": false,
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "discovery_id": {
      "minLength": 1,
      "title": "Discovery Id",
      "type": "string"
    },
    "discovery_status": {
      "enum": [
        "completed",
        "completed_with_warnings",
        "failed"
      ],
      "title": "Discovery Status",
      "type": "string"
    },
    "domain_family_coverage": {
      "minimum": 0,
      "title": "Domain Family Coverage",
      "type": "integer"
    },
    "generated_opportunity_count": {
      "minimum": 0,
      "title": "Generated Opportunity Count",
      "type": "integer"
    },
    "implies_publication_readiness": {
      "const": false,
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "const": false,
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "method_family_coverage": {
      "minimum": 0,
      "title": "Method Family Coverage",
      "type": "integer"
    },
    "near_duplicate_suppressed_count": {
      "minimum": 0,
      "title": "Near Duplicate Suppressed Count",
      "type": "integer"
    },
    "production_ready": {
      "title": "Production Ready",
      "type": "boolean"
    },
    "publication_ready": {
      "const": false,
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "raw_artifact_paths": {
      "items": {
        "type": "string"
      },
      "title": "Raw Artifact Paths",
      "type": "array"
    },
    "rejected_opportunity_count": {
      "minimum": 0,
      "title": "Rejected Opportunity Count",
