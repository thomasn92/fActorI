{
  "$defs": {
    "GenerationMutationOperator": {
      "description": "Winner-conditioned operators for later creative-search generations.",
      "enum": [
        "robustness_refinement",
        "robustness_parsimony_hybrid",
        "robustness_representation_hybrid",
        "adversarial_boundary_stress",
        "negative_control"
      ],
      "title": "GenerationMutationOperator",
      "type": "string"
    }
  },
  "$id": "https://schemas.factori.local/0.57.0/generation-mutation-candidate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One semantically de-duplicated generation mutation candidate.",
  "properties": {
    "baseline": {
      "minLength": 1,
      "title": "Baseline",
      "type": "string"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "cycle_index": {
      "minimum": 2,
      "title": "Cycle Index",
      "type": "integer"
    },
    "domain": {
      "minLength": 1,
      "title": "Domain",
      "type": "string"
    },
    "equations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Equations",
      "type": "array"
    },
    "expected_result_pattern": {
      "minLength": 1,
      "title": "Expected Result Pattern",
      "type": "string"
    },
    "experiment_design": {
      "minLength": 1,
      "title": "Experiment Design",
      "type": "string"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "model_object": {
      "minLength": 1,
      "title": "Model Object",
      "type": "string"
    },
    "mutation_id": {
      "minLength": 1,
      "title": "Mutation Id",
      "type": "string"
    },
    "operator": {
      "$ref": "#/$defs/GenerationMutationOperator"
    },
    "publication_ready": {
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "research_question": {
      "minLength": 1,
      "title": "Research Question",
      "type": "string"
    },
    "risk_or_failure_mode": {
      "minLength": 1,
      "title": "Risk Or Failure Mode",
      "type": "string"
    },
    "selected_for_substrate_build": {
      "default": false,
      "title": "Selected For Substrate Build",
      "type": "boolean"
    },
    "semantic_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Semantic Fingerprint",
      "type": "string"
    },
    "source_idea_node_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Idea Node Ids",
      "type": "array"
    },
    "source_substrate_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Substrate Ids",
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "why_scientifically_distinct": {
      "minLength": 1,
      "title": "Why Scientifically Distinct",
      "type": "string"
    }
  },
  "required": [
    "mutation_id",
    "cycle_index",
    "operator",
    "title",
    "domain",
    "research_question",
    "model_object",
    "equations",
    "baseline",
    "experiment_design",
    "expected_result_pattern",
    "why_scientifically_distinct",
    "risk_or_failure_mode",
    "semantic_fingerprint"
  ],
  "title": "GenerationMutationCandidate",
  "type": "object",
  "x-factori-protocol-version": "0.57.0",
  "x-factori-source-model": "factori.schemas.GenerationMutationCandidate",
  "x-factori-verification-evidence": false
}
