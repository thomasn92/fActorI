{
  "$id": "https://schemas.factori.local/0.48.0/empirical-boundary-assessment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Synthetic/empirical boundary diagnostic assessment.",
  "properties": {
    "empirical_section_present": {
      "title": "Empirical Section Present",
      "type": "boolean"
    },
    "findings": {
      "items": {
        "type": "string"
      },
      "title": "Findings",
      "type": "array"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Score",
      "type": "number"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "score",
    "passed",
    "empirical_section_present"
  ],
  "title": "EmpiricalBoundaryAssessment",
  "type": "object",
  "x-factori-protocol-version": "0.48.0",
  "x-factori-source-model": "factori.schemas.EmpiricalBoundaryAssessment",
  "x-factori-verification-evidence": false
}
