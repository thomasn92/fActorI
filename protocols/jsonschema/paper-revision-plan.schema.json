{
  "$defs": {
    "PaperRevisionActionKind": {
      "description": "Conservative deterministic revision actions.",
      "enum": [
        "AddCentralMessage",
        "ClarifyProblemStatement",
        "AddBoundedLiteratureGap",
        "DowngradeUnsupportedClaimLanguage",
        "RemoveInventedCitation",
        "AddCitationLimitation",
        "MoveTechnicalLemmaToAppendix",
        "ClarifySyntheticOnlyBoundary",
        "AddMissingLimitation",
        "AddSourceMapWarning",
        "NoActionNeeded"
      ],
      "title": "PaperRevisionActionKind",
      "type": "string"
    },
    "SectionRevisionPlan": {
      "additionalProperties": false,
      "description": "Safe deterministic revision actions for one section.",
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/PaperRevisionActionKind"
          },
          "title": "Actions",
          "type": "array"
        },
        "creates_scientific_validation": {
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "is_verification_evidence": {
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "safe_to_apply": {
          "default": true,
          "title": "Safe To Apply",
          "type": "boolean"
        },
        "section_id": {
          "minLength": 1,
          "title": "Section Id",
          "type": "string"
        },
        "section_title": {
          "minLength": 1,
          "title": "Section Title",
          "type": "string"
        }
      },
      "required": [
        "section_id",
        "section_title"
      ],
      "title": "SectionRevisionPlan",
      "type": "object"
    }
  },
  "$id": "https://schemas.factori.local/0.10.0/paper-revision-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Deterministic non-authoritative paper revision plan.",
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/PaperRevisionActionKind"
      },
      "title": "Actions",
      "type": "array"
    },
    "blocking_actions": {
      "items": {
        "$ref": "#/$defs/PaperRevisionActionKind"
      },
      "title": "Blocking Actions",
      "type": "array"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "critic_report_id": {
      "minLength": 1,
      "title": "Critic Report Id",
      "type": "string"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "plan_id": {
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "safe_to_apply": {
      "title": "Safe To Apply",
      "type": "boolean"
    },
    "section_plans": {
      "items": {
        "$ref": "#/$defs/SectionRevisionPlan"
      },
      "title": "Section Plans",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "plan_id",
    "run_id",
    "critic_report_id",
    "safe_to_apply"
  ],
  "title": "PaperRevisionPlan",
  "type": "object",
  "x-factori-protocol-version": "0.10.0",
  "x-factori-source-model": "factori.schemas.PaperRevisionPlan",
  "x-factori-verification-evidence": false
}
