        "source_idea_node_id_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Idea Node Id Optional"
        },
        "source_method_lens_id_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Method Lens Id Optional"
        },
        "source_mutation_axis_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
