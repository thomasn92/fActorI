      "type": "object"
    },
    "ScientificSubstrateResultSchema": {
      "additionalProperties": false,
      "description": "Expected result table and support rule for a substrate experiment.",
      "properties": {
        "baseline_metric_names": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Baseline Metric Names",
          "type": "array"
        },
        "claim_not_supported_if": {
          "minLength": 1,
          "title": "Claim Not Supported If",
          "type": "string"
        },
        "claim_supported_if": {
          "minLength": 1,
          "title": "Claim Supported If",
          "type": "string"
        },
        "comparison_direction": {
          "minLength": 1,
          "title": "Comparison Direction",
          "type": "string"
        },
        "method_metric_names": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Method Metric Names",
          "type": "array"
        },
        "required_table_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Table Columns",
          "type": "array"
        }
      },
      "required": [
        "baseline_metric_names",
        "method_metric_names",
        "comparison_direction",
        "required_table_columns",
        "claim_supported_if",
        "claim_not_supported_if"
      ],
      "title": "ScientificSubstrateResultSchema",
      "type": "object"
    },
    "ScientificSubstrateVariable": {
      "additionalProperties": false,
      "description": "One variable or notation item in a concrete scientific substrate.",
      "properties": {
        "definition": {
          "minLength": 1,
          "title": "Definition",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "symbol": {
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "definition",
        "role"
      ],
      "title": "ScientificSubstrateVariable",
      "type": "object"
    }
  },
