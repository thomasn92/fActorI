          "items": {
            "$ref": "#/$defs/ScientificSubstrateAssumption"
          },
          "minItems": 1,
          "title": "Assumptions",
          "type": "array"
        },
        "baseline": {
          "minLength": 1,
          "title": "Baseline",
          "type": "string"
        },
        "central_tension": {
          "minLength": 1,
          "title": "Central Tension",
          "type": "string"
        },
        "concrete_model_object": {
          "$ref": "#/$defs/ScientificSubstrateModelObject"
        },
        "creates_scientific_validation": {
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "dgp_or_dataset": {
          "minLength": 1,
          "title": "Dgp Or Dataset",
          "type": "string"
        },
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "domain_problem": {
          "minLength": 1,
          "title": "Domain Problem",
          "type": "string"
        },
        "evidence_boundary": {
          "minLength": 1,
          "title": "Evidence Boundary",
          "type": "string"
        },
        "experiment_design": {
          "$ref": "#/$defs/ScientificSubstrateExperimentDesign"
        },
        "failure_modes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Failure Modes",
          "type": "array"
        },
        "implies_publication_readiness": {
          "default": false,
          "title": "Implies Publication Readiness",
          "type": "boolean"
        },
        "is_verification_evidence": {
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "measurable_hypothesis": {
          "minLength": 1,
          "title": "Measurable Hypothesis",
          "type": "string"
        },
        "mechanism": {
          "minLength": 1,
          "title": "Mechanism",
          "type": "string"
