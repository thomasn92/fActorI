    "ScientificSubstrateAssumption": {
      "additionalProperties": false,
      "description": "One explicit modeling or experimental assumption.",
      "properties": {
        "assumption_id": {
          "minLength": 1,
          "title": "Assumption Id",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "violation_consequence": {
          "minLength": 1,
          "title": "Violation Consequence",
          "type": "string"
        }
      },
      "required": [
        "assumption_id",
        "statement",
        "rationale",
        "violation_consequence"
      ],
      "title": "ScientificSubstrateAssumption",
      "type": "object"
    },
    "ScientificSubstrateExperimentDesign": {
      "additionalProperties": false,
      "description": "Experiment design tied to one substrate and bounded target claim.",
      "properties": {
        "ablation_or_stress_test": {
          "minLength": 1,
          "title": "Ablation Or Stress Test",
          "type": "string"
        },
        "baseline": {
          "minLength": 1,
          "title": "Baseline",
          "type": "string"
        },
        "data_regime": {
          "minLength": 1,
          "title": "Data Regime",
          "type": "string"
        },
        "dgp": {
          "minLength": 1,
          "title": "Dgp",
          "type": "string"
        },
        "failure_criterion": {
          "minLength": 1,
          "title": "Failure Criterion",
          "type": "string"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "metrics": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "seed_plan": {
          "minLength": 1,
          "title": "Seed Plan",
          "type": "string"
        },
        "success_criterion": {
          "minLength": 1,
          "title": "Success Criterion",
          "type": "string"
        },
        "target_claim": {
          "minLength": 1,
          "title": "Target Claim",
          "type": "string"
        },
        "train_test_split_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Test Split Optional"
        }
      },
      "required": [
        "target_claim",
        "data_regime",
        "dgp",
        "baseline",
        "method",
        "metrics",
        "seed_plan",
        "ablation_or_stress_test",
        "success_criterion",
        "failure_criterion"
      ],
