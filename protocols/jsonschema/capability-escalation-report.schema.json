{
  "$defs": {
    "CapabilityEscalationItem": {
      "additionalProperties": false,
      "description": "Disposition of one deferred proof/retrieval escalation candidate.",
      "properties": {
        "backend_allowed_by_policy": {
          "title": "Backend Allowed By Policy",
          "type": "boolean"
        },
        "created_artifact_path_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created Artifact Path Optional"
        },
        "creates_scientific_validation": {
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "deferred_reason": {
          "minLength": 1,
          "title": "Deferred Reason",
          "type": "string"
        },
        "execution_status": {
          "enum": [
            "created_context_artifact",
            "created_formal_artifact",
            "expanded_local_sources",
            "no_match_found",
            "rejected_policy",
            "failed",
            "deferred"
          ],
          "title": "Execution Status",
          "type": "string"
        },
        "failure_reason_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Reason Optional"
        },
        "gap_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap Fingerprint"
        },
        "gap_type": {
          "minLength": 1,
          "title": "Gap Type",
          "type": "string"
        },
        "implies_publication_readiness": {
          "default": false,
          "title": "Implies Publication Readiness",
          "type": "boolean"
        },
        "ingested_artifact_path_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ingested Artifact Path Optional"
        },
        "is_verification_evidence": {
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "publication_ready": {
          "default": false,
          "title": "Publication Ready",
          "type": "boolean"
        },
        "safety_notes": {
          "items": {
            "type": "string"
          },
          "title": "Safety Notes",
          "type": "array"
        },
        "selected_backend": {
          "minLength": 1,
          "title": "Selected Backend",
          "type": "string"
        },
        "target_claim_id_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Claim Id Optional"
        },
        "target_section_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Section Optional"
        }
      },
      "required": [
        "item_id",
        "gap_type",
        "deferred_reason",
        "selected_backend",
        "backend_allowed_by_policy",
        "execution_status"
      ],
      "title": "CapabilityEscalationItem",
      "type": "object"
    }
  },
  "$id": "https://schemas.factori.local/0.64.0/capability-escalation-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Append-only non-evidence capability escalation report.",
  "properties": {
    "attempted_gap_count": {
      "default": 0,
      "minimum": 0,
      "title": "Attempted Gap Count",
      "type": "integer"
    },
    "autonomous_plan_rebuilt": {
      "default": false,
      "title": "Autonomous Plan Rebuilt",
      "type": "boolean"
    },
    "candidate_deferred_gap_count": {
      "default": 0,
      "minimum": 0,
      "title": "Candidate Deferred Gap Count",
      "type": "integer"
    },
    "claim_evidence_map_rebuilt": {
      "default": false,
      "title": "Claim Evidence Map Rebuilt",
      "type": "boolean"
    },
    "created_artifact_paths": {
      "items": {
        "type": "string"
      },
      "title": "Created Artifact Paths",
      "type": "array"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "deferred_after_escalation_count": {
      "default": 0,
      "minimum": 0,
      "title": "Deferred After Escalation Count",
      "type": "integer"
    },
    "escalation_id": {
      "minLength": 1,
      "title": "Escalation Id",
      "type": "string"
    },
    "escalation_status": {
      "enum": [
        "completed",
        "completed_with_deferred_gaps",
        "no_candidate_deferred_gaps",
        "blocked_policy",
        "failed"
      ],
      "title": "Escalation Status",
      "type": "string"
    },
    "external_tools_allowed": {
      "default": false,
      "title": "External Tools Allowed",
      "type": "boolean"
    },
    "failed_escalation_count": {
      "default": 0,
      "minimum": 0,
      "title": "Failed Escalation Count",
      "type": "integer"
    },
    "human_intervention_reason_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Human Intervention Reason Optional"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "ingested_artifact_paths": {
      "items": {
        "type": "string"
      },
      "title": "Ingested Artifact Paths",
      "type": "array"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/CapabilityEscalationItem"
      },
      "title": "Items",
      "type": "array"
    },
    "network_allowed": {
      "default": false,
      "title": "Network Allowed",
      "type": "boolean"
    },
    "policy_path": {
      "minLength": 1,
      "title": "Policy Path",
      "type": "string"
    },
    "proof_escalation_attempt_count": {
      "default": 0,
      "minimum": 0,
      "title": "Proof Escalation Attempt Count",
      "type": "integer"
    },
    "publication_ready": {
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "release_rechecked": {
      "default": false,
      "title": "Release Rechecked",
      "type": "boolean"
    },
    "requires_human_intervention": {
      "default": false,
      "title": "Requires Human Intervention",
      "type": "boolean"
    },
    "retrieval_escalation_attempt_count": {
      "default": 0,
      "minimum": 0,
      "title": "Retrieval Escalation Attempt Count",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "source_gap_attempt_history_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Gap Attempt History Path"
    },
    "source_loop_report_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Loop Report Path"
    },
    "successful_escalation_count": {
      "default": 0,
      "minimum": 0,
      "title": "Successful Escalation Count",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "escalation_id",
    "policy_path",
    "escalation_status"
  ],
  "title": "CapabilityEscalationReport",
  "type": "object",
  "x-factori-protocol-version": "0.64.0",
  "x-factori-source-model": "factori.schemas.CapabilityEscalationReport",
  "x-factori-verification-evidence": false
}
