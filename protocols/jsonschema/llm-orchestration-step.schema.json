{
  "$defs": {
    "LLMOrchestrationStepStatus": {
      "description": "Status for one gated LLM orchestration step.",
      "enum": [
        "Pending",
        "Skipped",
        "Succeeded",
        "SucceededWithWarnings",
        "Blocked",
        "Failed"
      ],
      "title": "LLMOrchestrationStepStatus",
      "type": "string"
    }
  },
  "$id": "https://schemas.factori.local/0.13.0/llm-orchestration-step.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One step in the gated LLM paper workflow.",
  "properties": {
    "artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Ids",
      "type": "array"
    },
    "completed_at": {
      "minLength": 1,
      "title": "Completed At",
      "type": "string"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "started_at": {
      "format": "date-time",
      "minLength": 1,
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/LLMOrchestrationStepStatus"
    },
    "step_name": {
      "minLength": 1,
      "title": "Step Name",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "step_name",
    "status",
    "summary",
    "started_at",
    "completed_at"
  ],
  "title": "LLMOrchestrationStep",
  "type": "object",
  "x-factori-protocol-version": "0.13.0",
  "x-factori-source-model": "factori.schemas.LLMOrchestrationStep",
  "x-factori-verification-evidence": false
}
