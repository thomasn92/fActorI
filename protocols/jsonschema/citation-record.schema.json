{
  "$id": "https://schemas.factori.local/0.15.0/citation-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Retrieval-backed citation metadata for literature context only.",
  "properties": {
    "abstract_or_snippet": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Abstract Or Snippet"
    },
    "allowed_citation_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Allowed Citation Key"
    },
    "authors": {
      "items": {
        "type": "string"
      },
      "title": "Authors",
      "type": "array"
    },
    "citation_id": {
      "minLength": 1,
      "title": "Citation Id",
      "type": "string"
    },
    "citation_key": {
      "minLength": 1,
      "title": "Citation Key",
      "type": "string"
    },
    "claims_literature_coverage": {
      "default": false,
      "title": "Claims Literature Coverage",
      "type": "boolean"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "doi": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doi"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "proves_novelty": {
      "default": false,
      "title": "Proves Novelty",
      "type": "boolean"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "raw_metadata_hash": {
      "minLength": 1,
      "title": "Raw Metadata Hash",
      "type": "string"
    },
    "retrieval_backend": {
      "default": "unknown",
      "minLength": 1,
      "title": "Retrieval Backend",
      "type": "string"
    },
    "retrieved_at": {
      "format": "date-time",
      "minLength": 1,
      "title": "Retrieved At",
      "type": "string"
    },
    "source_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Artifact Id"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_status": {
      "default": "unverified_metadata",
      "enum": [
        "retrieved",
        "user_provided",
        "fixture",
        "rejected",
        "stale",
        "unverified_metadata"
      ],
      "title": "Source Status",
      "type": "string"
    },
    "source_type": {
      "default": "retrieval_metadata",
      "minLength": 1,
      "title": "Source Type",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "trust_level": {
      "default": "metadata_only",
      "minLength": 1,
      "title": "Trust Level",
      "type": "string"
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    },
    "venue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Venue"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "year": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Year"
    }
  },
  "required": [
    "citation_id",
    "citation_key",
    "source_id",
    "title",
    "provider",
    "retrieved_at",
    "raw_metadata_hash"
  ],
  "title": "CitationRecord",
  "type": "object",
  "x-factori-protocol-version": "0.15.0",
  "x-factori-source-model": "factori.schemas.CitationRecord",
  "x-factori-verification-evidence": false
}
