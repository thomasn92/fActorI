{
  "$defs": {
    "VarianceAugmentationBatch": {
      "additionalProperties": false,
      "description": "Candidates generated from one promoted opportunity seed.",
      "properties": {
        "candidate_count": {
          "minimum": 0,
          "title": "Candidate Count",
          "type": "integer"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/VarianceAugmentedCandidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "method_lens": {
          "minLength": 1,
          "title": "Method Lens",
          "type": "string"
        },
        "opportunity_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Opportunity Score",
          "type": "number"
        },
        "selected_candidate_count": {
          "minimum": 0,
          "title": "Selected Candidate Count",
          "type": "integer"
        },
        "source_method_lens_id": {
          "minLength": 1,
          "title": "Source Method Lens Id",
          "type": "string"
        },
        "source_opportunity_id": {
          "minLength": 1,
          "title": "Source Opportunity Id",
          "type": "string"
        },
        "source_seed_id": {
          "minLength": 1,
          "title": "Source Seed Id",
          "type": "string"
        }
      },
      "required": [
        "source_seed_id",
        "source_opportunity_id",
        "source_method_lens_id",
        "method_lens",
        "opportunity_score",
        "candidate_count",
        "selected_candidate_count"
      ],
      "title": "VarianceAugmentationBatch",
      "type": "object"
    },
    "VarianceAugmentationConfig": {
      "additionalProperties": false,
      "description": "Deterministic limits for opportunity-seeded candidate generation.",
      "properties": {
        "candidates_per_seed": {
          "default": 4,
          "maximum": 10,
          "minimum": 1,
          "title": "Candidates Per Seed",
          "type": "integer"
        },
        "generator_backend": {
          "const": "deterministic",
          "default": "deterministic",
          "title": "Generator Backend",
          "type": "string"
        },
        "max_selected_candidates": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Selected Candidates",
          "type": "integer"
        },
        "max_total_candidates": {
          "default": 40,
          "maximum": 200,
          "minimum": 1,
          "title": "Max Total Candidates",
          "type": "integer"
        }
      },
      "title": "VarianceAugmentationConfig",
      "type": "object"
    },
    "VarianceAugmentedCandidate": {
      "additionalProperties": false,
      "description": "One context-only research branch lifted from an opportunity seed.",
      "properties": {
        "baseline": {
          "minLength": 1,
          "title": "Baseline",
          "type": "string"
        },
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "creates_scientific_validation": {
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "data_regime": {
          "minLength": 1,
          "title": "Data Regime",
          "type": "string"
        },
        "difficulty_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Difficulty Score",
          "type": "number"
        },
        "diversity_tags": {
          "items": {
            "type": "string"
          },
          "title": "Diversity Tags",
          "type": "array"
        },
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "easy_win_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Easy Win Score",
          "type": "number"
        },
        "expected_substrate_type": {
          "minLength": 1,
          "title": "Expected Substrate Type",
          "type": "string"
        },
        "experiment_or_proof_plan": {
          "minLength": 1,
          "title": "Experiment Or Proof Plan",
          "type": "string"
        },
        "failure_mode": {
          "minLength": 1,
          "title": "Failure Mode",
          "type": "string"
        },
        "hypothesis": {
          "minLength": 1,
          "title": "Hypothesis",
          "type": "string"
        },
        "implies_publication_readiness": {
          "default": false,
          "title": "Implies Publication Readiness",
          "type": "boolean"
        },
        "is_verification_evidence": {
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "method_lens": {
          "minLength": 1,
          "title": "Method Lens",
          "type": "string"
        },
        "model_hint": {
          "minLength": 1,
          "title": "Model Hint",
          "type": "string"
        },
        "novelty_risk": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Novelty Risk",
          "type": "number"
        },
        "paper_shape": {
          "minLength": 1,
          "title": "Paper Shape",
          "type": "string"
        },
        "publication_ready": {
          "default": false,
          "title": "Publication Ready",
          "type": "boolean"
        },
        "research_question": {
          "minLength": 1,
          "title": "Research Question",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "scientific_interest_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Scientific Interest Score",
          "type": "number"
        },
        "selected_for_idea_tree": {
          "default": false,
          "title": "Selected For Idea Tree",
          "type": "boolean"
        },
        "source_method_lens_id": {
          "minLength": 1,
          "title": "Source Method Lens Id",
          "type": "string"
        },
        "source_opportunity_id": {
          "minLength": 1,
          "title": "Source Opportunity Id",
          "type": "string"
        },
        "source_seed_id": {
          "minLength": 1,
          "title": "Source Seed Id",
          "type": "string"
        },
        "theory_object": {
          "minLength": 1,
          "title": "Theory Object",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "variant_family": {
          "enum": [
            "mechanism_variant",
            "robustness_variant",
            "counterexample_variant",
            "benchmark_variant",
            "representation_variant"
          ],
          "title": "Variant Family",
          "type": "string"
        },
        "verification_path": {
          "minLength": 1,
          "title": "Verification Path",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "run_id",
        "source_seed_id",
        "source_opportunity_id",
        "source_method_lens_id",
        "domain",
        "method_lens",
        "variant_family",
        "title",
        "research_question",
        "hypothesis",
        "theory_object",
        "model_hint",
        "experiment_or_proof_plan",
        "baseline",
        "failure_mode",
        "paper_shape",
        "verification_path",
        "data_regime",
        "expected_substrate_type",
        "novelty_risk",
        "difficulty_score",
        "scientific_interest_score",
        "easy_win_score"
      ],
      "title": "VarianceAugmentedCandidate",
      "type": "object"
    },
    "VarianceDiversityDiagnostic": {
      "additionalProperties": false,
      "description": "Deterministic coverage and duplication diagnostics over augmented branches.",
      "properties": {
        "baseline_duplicate_count": {
          "minimum": 0,
          "title": "Baseline Duplicate Count",
          "type": "integer"
        },
        "candidate_count": {
          "minimum": 0,
          "title": "Candidate Count",
          "type": "integer"
        },
        "diversity_score": {
          "enum": [
            "low",
            "moderate",
            "high"
          ],
          "title": "Diversity Score",
          "type": "string"
        },
        "method_lens_coverage": {
          "minimum": 0,
          "title": "Method Lens Coverage",
          "type": "integer"
        },
        "model_object_duplicate_count": {
          "minimum": 0,
          "title": "Model Object Duplicate Count",
          "type": "integer"
        },
        "overrepresented_phrases": {
          "items": {
            "type": "string"
          },
          "title": "Overrepresented Phrases",
          "type": "array"
        },
        "research_question_duplicate_count": {
          "minimum": 0,
          "title": "Research Question Duplicate Count",
          "type": "integer"
        },
        "seed_count": {
          "minimum": 0,
          "title": "Seed Count",
          "type": "integer"
        },
        "selected_candidate_count": {
          "minimum": 0,
          "title": "Selected Candidate Count",
          "type": "integer"
        },
        "underrepresented_method_lenses": {
          "items": {
            "type": "string"
          },
          "title": "Underrepresented Method Lenses",
          "type": "array"
        }
      },
      "required": [
        "candidate_count",
        "seed_count",
        "method_lens_coverage",
        "research_question_duplicate_count",
        "model_object_duplicate_count",
        "baseline_duplicate_count",
        "diversity_score",
        "selected_candidate_count"
      ],
      "title": "VarianceDiversityDiagnostic",
      "type": "object"
    }
  },
  "$id": "https://schemas.factori.local/0.59.0/variance-augmentation-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Append-only opportunity-seeded variance generation or application report.",
  "properties": {
    "applied_candidate_ids": {
      "items": {
        "type": "string"
      },
      "title": "Applied Candidate Ids",
      "type": "array"
    },
    "applied_to_idea_tree": {
      "default": false,
      "title": "Applied To Idea Tree",
      "type": "boolean"
    },
    "augmentation_id": {
      "minLength": 1,
      "title": "Augmentation Id",
      "type": "string"
    },
    "batches": {
      "items": {
        "$ref": "#/$defs/VarianceAugmentationBatch"
      },
      "title": "Batches",
      "type": "array"
    },
    "candidate_count": {
      "minimum": 0,
      "title": "Candidate Count",
      "type": "integer"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/VarianceAugmentedCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "config": {
      "$ref": "#/$defs/VarianceAugmentationConfig"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "diversity_diagnostic": {
      "$ref": "#/$defs/VarianceDiversityDiagnostic"
    },
    "domain": {
      "minLength": 1,
      "title": "Domain",
      "type": "string"
    },
    "idea_tree_nodes_added": {
      "default": 0,
      "minimum": 0,
      "title": "Idea Tree Nodes Added",
      "type": "integer"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "method_lens_candidate_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Method Lens Candidate Counts",
      "type": "object"
    },
    "publication_ready": {
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "seed_count": {
      "minimum": 0,
      "title": "Seed Count",
      "type": "integer"
    },
    "selected_candidate_count": {
      "minimum": 0,
      "title": "Selected Candidate Count",
      "type": "integer"
    },
    "source_augmentation_report_path_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Augmentation Report Path Optional"
    },
    "source_opportunity_discovery_path": {
      "minLength": 1,
      "title": "Source Opportunity Discovery Path",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "augmentation_id",
    "source_opportunity_discovery_path",
    "domain",
    "config",
    "seed_count",
    "candidate_count",
    "selected_candidate_count",
    "diversity_diagnostic"
  ],
  "title": "VarianceAugmentationReport",
  "type": "object",
  "x-factori-protocol-version": "0.59.0",
  "x-factori-source-model": "factori.schemas.VarianceAugmentationReport",
  "x-factori-verification-evidence": false
}
