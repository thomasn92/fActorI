{
  "$id": "https://schemas.factori.local/0.82.0/idea-node-feature-vector.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Deterministic lexical and domain feature vector for an idea-tree node.",
  "properties": {
    "active_feature_names": {
      "items": {
        "type": "string"
      },
      "title": "Active Feature Names",
      "type": "array"
    },
    "baseline_features": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Baseline Features",
      "type": "object"
    },
    "claim_type_features": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Claim Type Features",
      "type": "object"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "data_regime_features": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Data Regime Features",
      "type": "object"
    },
    "domain_features": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Domain Features",
      "type": "object"
    },
    "experiment_features": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Experiment Features",
      "type": "object"
    },
    "feature_values": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Feature Values",
      "type": "object"
    },
    "has_DGP": {
      "default": false,
      "title": "Has Dgp",
      "type": "boolean"
    },
    "has_ablation": {
      "default": false,
      "title": "Has Ablation",
      "type": "boolean"
    },
    "has_algorithm": {
      "default": false,
      "title": "Has Algorithm",
      "type": "boolean"
    },
    "has_baseline": {
      "default": false,
      "title": "Has Baseline",
      "type": "boolean"
    },
    "has_concrete_model": {
      "default": false,
      "title": "Has Concrete Model",
      "type": "boolean"
    },
    "has_equation": {
      "default": false,
      "title": "Has Equation",
      "type": "boolean"
    },
    "has_metric": {
      "default": false,
      "title": "Has Metric",
      "type": "boolean"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "mathematical_object_features": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Mathematical Object Features",
      "type": "object"
    },
    "method_features": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Method Features",
      "type": "object"
    },
    "model_features": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Model Features",
      "type": "object"
    },
    "node_id": {
      "minLength": 1,
      "title": "Node Id",
      "type": "string"
    },
    "publication_ready": {
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "risk_features": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Risk Features",
      "type": "object"
    },
    "stage_origin": {
      "minLength": 1,
      "title": "Stage Origin",
      "type": "string"
    },
    "status": {
      "enum": [
        "root",
        "generated",
        "expanded",
        "survived",
        "pruned",
        "selected",
        "final",
        "deferred"
      ],
      "title": "Status",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "uses_PCA_or_representation_axis": {
      "default": false,
      "title": "Uses Pca Or Representation Axis",
      "type": "boolean"
    },
    "uses_agent_based_model": {
      "default": false,
      "title": "Uses Agent Based Model",
      "type": "boolean"
    },
    "uses_dimensionality_reduction": {
      "default": false,
      "title": "Uses Dimensionality Reduction",
      "type": "boolean"
    },
    "uses_distance_decay": {
      "default": false,
      "title": "Uses Distance Decay",
      "type": "boolean"
    },
    "uses_experiment_form": {
      "default": false,
      "title": "Uses Experiment Form",
      "type": "boolean"
    },
    "uses_gravity_model": {
      "default": false,
      "title": "Uses Gravity Model",
      "type": "boolean"
    },
    "uses_kernel_model": {
      "default": false,
      "title": "Uses Kernel Model",
      "type": "boolean"
    },
    "uses_matrix_factorization": {
      "default": false,
      "title": "Uses Matrix Factorization",
      "type": "boolean"
    },
    "uses_private_data": {
      "default": false,
      "title": "Uses Private Data",
      "type": "boolean"
    },
    "uses_public_data": {
      "default": false,
      "title": "Uses Public Data",
      "type": "boolean"
    },
    "uses_robustness_model": {
      "default": false,
      "title": "Uses Robustness Model",
      "type": "boolean"
    },
    "uses_spatial_interaction_model": {
      "default": false,
      "title": "Uses Spatial Interaction Model",
      "type": "boolean"
    },
    "uses_stress_testing": {
      "default": false,
      "title": "Uses Stress Testing",
      "type": "boolean"
    },
    "uses_synthetic_data": {
      "default": false,
      "title": "Uses Synthetic Data",
      "type": "boolean"
    },
    "uses_theorem_form": {
      "default": false,
      "title": "Uses Theorem Form",
      "type": "boolean"
    },
    "uses_uncertainty_model": {
      "default": false,
      "title": "Uses Uncertainty Model",
      "type": "boolean"
    }
  },
  "required": [
    "node_id",
    "title",
    "stage_origin",
    "status",
    "feature_values"
  ],
  "title": "IdeaNodeFeatureVector",
  "type": "object",
  "x-factori-protocol-version": "0.82.0",
  "x-factori-source-model": "factori.schemas.IdeaNodeFeatureVector",
  "x-factori-verification-evidence": false
}
