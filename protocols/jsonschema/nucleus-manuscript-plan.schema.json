        "CentralMessage",
        "ProblemFraming",
        "BackgroundLiteraturePositioning",
        "ModelFrame",
        "MainBodyResult",
        "DerivativeOrCorollary",
        "TechnicalLemma",
        "AppendixOnlyProof",
        "NumericalValidation",
        "EmpiricalDiscussion",
        "SyntheticBoundary",
        "LimitationsDiscussion"
      ],
      "title": "NarrativeSectionRole",
      "type": "string"
    },
