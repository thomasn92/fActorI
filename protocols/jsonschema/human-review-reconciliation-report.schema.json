{
  "$defs": {
    "HumanReviewReconciliationItem": {
      "additionalProperties": false,
      "description": "Deterministic disposition of one human-review requested change.",
      "properties": {
        "applied_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applied Text"
        },
        "creates_scientific_validation": {
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "implies_publication_readiness": {
          "default": false,
          "title": "Implies Publication Readiness",
          "type": "boolean"
        },
        "is_verification_evidence": {
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "applied_safe_text_revision",
            "applied_boundary_clarification",
            "applied_existing_evidence_reference",
            "rejected_unsupported_claim",
            "rejected_forbidden_authority_claim",
            "deferred_requires_proof_artifact",
            "deferred_requires_experiment_artifact",
            "deferred_requires_retrieval_expansion",
            "deferred_requires_human_decision"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "requested_change": {
          "minLength": 1,
          "title": "Requested Change",
          "type": "string"
        },
        "requires_new_evidence": {
          "default": false,
          "title": "Requires New Evidence",
          "type": "boolean"
        },
        "supporting_artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Artifact Ids",
          "type": "array"
        },
        "supporting_citation_keys": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Citation Keys",
          "type": "array"
        },
        "target_section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Section"
        }
      },
      "required": [
        "requested_change",
        "outcome",
        "rationale"
      ],
      "title": "HumanReviewReconciliationItem",
      "type": "object"
    }
  },
  "$id": "https://schemas.factori.local/0.60.0/human-review-reconciliation-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded human-review manuscript reconciliation report.",
  "properties": {
    "applied_change_count": {
      "minimum": 0,
      "title": "Applied Change Count",
      "type": "integer"
    },
    "change_outcomes": {
      "items": {
        "$ref": "#/$defs/HumanReviewReconciliationItem"
      },
      "title": "Change Outcomes",
      "type": "array"
    },
    "citation_safety_rechecked_after_reconciliation": {
      "default": false,
      "title": "Citation Safety Rechecked After Reconciliation",
      "type": "boolean"
    },
    "claim_evidence_map_rechecked_after_reconciliation": {
      "default": false,
      "title": "Claim Evidence Map Rechecked After Reconciliation",
      "type": "boolean"
    },
    "claim_support_rechecked_after_reconciliation": {
      "default": false,
      "title": "Claim Support Rechecked After Reconciliation",
      "type": "boolean"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "cycle_number": {
      "default": 1,
      "minimum": 1,
      "title": "Cycle Number",
      "type": "integer"
    },
    "deferred_change_count": {
      "minimum": 0,
      "title": "Deferred Change Count",
      "type": "integer"
    },
    "human_review_artifact_path": {
      "minLength": 1,
      "title": "Human Review Artifact Path",
      "type": "string"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "reconciled_manuscript_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reconciled Manuscript Path"
    },
    "reconciliation_status": {
      "enum": [
        "no_action_needed",
        "reconciled",
        "reconciled_with_rejections_or_deferrals",
        "blocked",
        "failed"
      ],
      "title": "Reconciliation Status",
      "type": "string"
    },
    "rejected_change_count": {
      "minimum": 0,
      "title": "Rejected Change Count",
      "type": "integer"
    },
    "release_rechecked_after_reconciliation": {
      "default": false,
      "title": "Release Rechecked After Reconciliation",
      "type": "boolean"
    },
    "remaining_requested_changes": {
      "items": {
        "type": "string"
      },
      "title": "Remaining Requested Changes",
      "type": "array"
    },
    "request_set_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Set Id"
    },
    "requested_change_count": {
      "minimum": 0,
      "title": "Requested Change Count",
      "type": "integer"
    },
    "requires_new_evidence_count": {
      "minimum": 0,
      "title": "Requires New Evidence Count",
      "type": "integer"
    },
    "review_status": {
      "minLength": 1,
      "title": "Review Status",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "sections_modified": {
      "items": {
        "type": "string"
      },
      "title": "Sections Modified",
      "type": "array"
    },
    "source_manuscript_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Manuscript Path"
    }
  },
  "required": [
    "run_id",
    "human_review_artifact_path",
    "review_status",
    "reconciliation_status",
    "requested_change_count",
    "applied_change_count",
    "rejected_change_count",
    "deferred_change_count",
    "requires_new_evidence_count"
  ],
  "title": "HumanReviewReconciliationReport",
  "type": "object",
  "x-factori-protocol-version": "0.60.0",
  "x-factori-source-model": "factori.schemas.HumanReviewReconciliationReport",
  "x-factori-verification-evidence": false
}
