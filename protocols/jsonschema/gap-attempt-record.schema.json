{
  "$id": "https://schemas.factori.local/0.68.0/gap-attempt-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One stable gap-attempt history record.",
  "properties": {
    "attempt_count": {
      "default": 0,
      "minimum": 0,
      "title": "Attempt Count",
      "type": "integer"
    },
    "created_artifact_paths": {
      "items": {
        "type": "string"
      },
      "title": "Created Artifact Paths",
      "type": "array"
    },
    "created_spec_fingerprints": {
      "items": {
        "type": "string"
      },
      "title": "Created Spec Fingerprints",
      "type": "array"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "current_gap_status": {
      "default": "open",
      "enum": [
        "open",
        "resolved",
        "deferred",
        "exhausted_no_progress",
        "exhausted_initial_strategy",
        "exhausted_all_strategies",
        "deferred_after_diversification",
        "blocked"
      ],
      "title": "Current Gap Status",
      "type": "string"
    },
    "deferred_attempt_count": {
      "default": 0,
      "minimum": 0,
      "title": "Deferred Attempt Count",
      "type": "integer"
    },
    "diversified_strategy_count": {
      "default": 0,
      "minimum": 0,
      "title": "Diversified Strategy Count",
      "type": "integer"
    },
    "exhaustion_reason_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exhaustion Reason Optional"
    },
    "expected_artifact_type": {
      "minLength": 1,
      "title": "Expected Artifact Type",
      "type": "string"
    },
    "failed_attempt_count": {
      "default": 0,
      "minimum": 0,
      "title": "Failed Attempt Count",
      "type": "integer"
    },
    "final_deferral_after_strategy_exhaustion": {
      "default": false,
      "title": "Final Deferral After Strategy Exhaustion",
      "type": "boolean"
    },
    "first_seen_iteration_optional": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Seen Iteration Optional"
    },
    "gap_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Gap Fingerprint",
      "type": "string"
    },
    "gap_type": {
      "minLength": 1,
      "title": "Gap Type",
      "type": "string"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "latest_attempt_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Attempt Status"
    },
    "latest_seen_iteration_optional": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Seen Iteration Optional"
    },
    "linked_evidence_artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Linked Evidence Artifact Ids",
      "type": "array"
    },
    "no_op_attempt_count": {
      "default": 0,
      "minimum": 0,
      "title": "No Op Attempt Count",
      "type": "integer"
    },
    "recommended_action": {
      "minLength": 1,
      "title": "Recommended Action",
      "type": "string"
    },
    "resolution_reason_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolution Reason Optional"
    },
    "strategy_attempt_count": {
      "default": 0,
      "minimum": 0,
      "title": "Strategy Attempt Count",
      "type": "integer"
    },
    "strategy_fingerprints_attempted": {
      "items": {
        "type": "string"
      },
      "title": "Strategy Fingerprints Attempted",
      "type": "array"
    },
    "successful_attempt_count": {
      "default": 0,
      "minimum": 0,
      "title": "Successful Attempt Count",
      "type": "integer"
    },
    "target_claim_id_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Claim Id Optional"
    },
    "target_section_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Section Optional"
    }
  },
  "required": [
    "gap_fingerprint",
    "gap_type",
    "recommended_action",
    "expected_artifact_type"
  ],
  "title": "GapAttemptRecord",
  "type": "object",
  "x-factori-protocol-version": "0.68.0",
  "x-factori-source-model": "factori.schemas.GapAttemptRecord",
  "x-factori-verification-evidence": false
}
