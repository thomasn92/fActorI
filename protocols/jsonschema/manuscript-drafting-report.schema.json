{
  "$defs": {
    "ManuscriptDraftStatus": {
      "description": "Section-by-section manuscript draft status; not scientific validation.",
      "enum": [
        "DraftComplete",
        "DraftCompleteWithWarnings",
        "DraftIncompleteUnsafeSections",
        "DraftFailed"
      ],
      "title": "ManuscriptDraftStatus",
      "type": "string"
    },
    "SectionDraftSafetySummary": {
      "additionalProperties": false,
      "description": "Compact safety status for one generated section draft.",
      "properties": {
        "allowed_statement_classes_used": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Statement Classes Used",
          "type": "array"
        },
        "created_or_upgraded_labels": {
          "default": false,
          "title": "Created Or Upgraded Labels",
          "type": "boolean"
        },
        "creates_scientific_validation": {
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "implies_publication_readiness": {
          "default": false,
          "title": "Implies Publication Readiness",
          "type": "boolean"
        },
        "is_verification_evidence": {
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "original_sentence_count": {
          "default": 0,
          "minimum": 0,
          "title": "Original Sentence Count",
          "type": "integer"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "rejected": {
          "title": "Rejected",
          "type": "boolean"
        },
        "removal_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Removal Reasons",
          "type": "array"
        },
        "removed_sentence_count": {
          "default": 0,
          "minimum": 0,
          "title": "Removed Sentence Count",
          "type": "integer"
        },
        "retained_sentence_count": {
          "default": 0,
          "minimum": 0,
          "title": "Retained Sentence Count",
          "type": "integer"
        },
        "safe": {
          "title": "Safe",
          "type": "boolean"
        },
        "safe_scaffold_sentences_retained": {
          "items": {
            "type": "string"
          },
          "title": "Safe Scaffold Sentences Retained",
          "type": "array"
        },
        "safety_status": {
          "minLength": 1,
          "title": "Safety Status",
          "type": "string"
        },
        "section_id": {
          "minLength": 1,
          "title": "Section Id",
          "type": "string"
        },
        "section_status": {
          "default": "retained",
          "title": "Section Status",
          "type": "string"
        },
        "unsafe_sentences_removed": {
          "items": {
            "type": "string"
          },
          "title": "Unsafe Sentences Removed",
          "type": "array"
        },
        "unsupported_sentences": {
          "items": {
            "type": "string"
          },
          "title": "Unsupported Sentences",
          "type": "array"
        },
        "used_citation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Used Citation Ids",
          "type": "array"
        },
        "used_citation_keys": {
          "items": {
            "type": "string"
          },
          "title": "Used Citation Keys",
          "type": "array"
        },
        "used_claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Used Claim Ids",
          "type": "array"
        },
        "used_evidence_artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Used Evidence Artifact Ids",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "section_id",
        "safety_status",
        "safe",
        "rejected"
      ],
      "title": "SectionDraftSafetySummary",
      "type": "object"
    }
  },
  "$id": "https://schemas.factori.local/0.17.0/manuscript-drafting-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Machine-readable section drafting report.",
  "properties": {
    "assembly_report_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assembly Report Artifact Id"
    },
    "citation_registry_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Citation Registry Artifact Id"
    },
    "citation_safety_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Citation Safety Artifact Id"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "draft_status": {
      "$ref": "#/$defs/ManuscriptDraftStatus"
    },
    "drafting_plan_id": {
      "minLength": 1,
      "title": "Drafting Plan Id",
      "type": "string"
    },
    "fake": {
      "default": true,
      "title": "Fake",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "literature_positioning_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Literature Positioning Artifact Id"
    },
    "manuscript_draft_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manuscript Draft Artifact Id"
    },
    "prose_backend": {
      "default": "fake",
      "title": "Prose Backend",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "section_summaries": {
      "items": {
        "$ref": "#/$defs/SectionDraftSafetySummary"
      },
      "title": "Section Summaries",
      "type": "array"
    },
    "sections_safe": {
      "minimum": 0,
      "title": "Sections Safe",
      "type": "integer"
    },
    "sections_total": {
      "minimum": 0,
      "title": "Sections Total",
      "type": "integer"
    },
    "sections_unsafe": {
      "minimum": 0,
      "title": "Sections Unsafe",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "drafting_plan_id",
    "sections_total",
    "sections_safe",
    "sections_unsafe",
    "draft_status",
    "section_summaries"
  ],
  "title": "ManuscriptDraftingReport",
  "type": "object",
  "x-factori-protocol-version": "0.17.0",
  "x-factori-source-model": "factori.schemas.ManuscriptDraftingReport",
  "x-factori-verification-evidence": false
}
