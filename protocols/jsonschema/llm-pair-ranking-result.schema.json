{
  "$id": "https://schemas.factori.local/0.70.0/llm-pair-ranking-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Non-fake LLM scientific judgment for one compatible atlas pair.",
  "properties": {
    "baseline_clarity": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Baseline Clarity",
      "type": "number"
    },
    "false_bridge_risk": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "False Bridge Risk",
      "type": "number"
    },
    "novelty_hypothesis": {
      "minLength": 1,
      "title": "Novelty Hypothesis",
      "type": "string"
    },
    "pair_id": {
      "minLength": 1,
      "title": "Pair Id",
      "type": "string"
    },
    "paper_shape_clarity": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Paper Shape Clarity",
      "type": "number"
    },
    "question_abundance": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Question Abundance",
      "type": "number"
    },
    "rank_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Rank Score",
      "type": "number"
    },
    "ranking_explanation": {
      "minLength": 1,
      "title": "Ranking Explanation",
      "type": "string"
    },
    "recommended_for_deep_discovery": {
      "title": "Recommended For Deep Discovery",
      "type": "boolean"
    },
    "scientific_fit": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Scientific Fit",
      "type": "number"
    },
    "tautology_risk": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Tautology Risk",
      "type": "number"
    },
    "tractability": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Tractability",
      "type": "number"
    },
    "underuse_hypothesis": {
      "minLength": 1,
      "title": "Underuse Hypothesis",
      "type": "string"
    },
    "verification_feasibility": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Verification Feasibility",
      "type": "number"
    }
  },
  "required": [
    "pair_id",
    "rank_score",
    "scientific_fit",
    "tractability",
    "question_abundance",
    "baseline_clarity",
    "verification_feasibility",
    "paper_shape_clarity",
    "false_bridge_risk",
    "tautology_risk",
    "novelty_hypothesis",
    "underuse_hypothesis",
    "ranking_explanation",
    "recommended_for_deep_discovery"
  ],
  "title": "LLMPairRankingResult",
  "type": "object",
  "x-factori-protocol-version": "0.70.0",
  "x-factori-source-model": "factori.schemas.LLMPairRankingResult",
  "x-factori-verification-evidence": false
}
