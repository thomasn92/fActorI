{
  "$id": "https://schemas.factori.local/0.60.0/final-bundle-verification-check.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One read-only integrity or policy check over a final release bundle.",
  "properties": {
    "blocking": {
      "default": false,
      "title": "Blocking",
      "type": "boolean"
    },
    "category": {
      "minLength": 1,
      "title": "Category",
      "type": "string"
    },
    "check_id": {
      "minLength": 1,
      "title": "Check Id",
      "type": "string"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "details": {
      "additionalProperties": true,
      "title": "Details",
      "type": "object"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "message": {
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "warned"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "check_id",
    "category",
    "status",
    "message"
  ],
  "title": "FinalBundleVerificationCheck",
  "type": "object",
  "x-factori-protocol-version": "0.60.0",
  "x-factori-source-model": "factori.schemas.FinalBundleVerificationCheck",
  "x-factori-verification-evidence": false
}
