{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to an artifact stored on the local filesystem.",
      "properties": {
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "producing_commit_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producing Commit Hash"
        },
        "type": {
          "$ref": "#/$defs/ArtifactType"
        }
      },
      "required": [
        "id",
        "type",
        "path",
        "content_hash"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "description": "Artifact categories mapped to the local run directory structure.",
      "enum": [
        "candidate",
        "score",
        "report",
        "literature",
        "lean",
        "experiment",
        "log",
        "latex"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
