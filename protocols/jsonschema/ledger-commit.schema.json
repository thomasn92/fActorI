  "$id": "https://schemas.factori.local/0.47.0/ledger-commit.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Append-only provenance commit.",
  "properties": {
    "action_type": {
      "$ref": "#/$defs/ControllerActionType"
    },
    "artifact_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "candidate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Id"
    },
    "commit_hash": {
      "title": "Commit Hash",
      "type": "string"
    },
    "parent_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Hash"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "minLength": 1,
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "commit_hash",
    "run_id",
    "action_type",
    "timestamp"
  ],
  "title": "LedgerCommit",
  "type": "object",
  "x-factori-protocol-version": "0.47.0",
  "x-factori-source-model": "factori.schemas.LedgerCommit",
  "x-factori-verification-evidence": false
}
