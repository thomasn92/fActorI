{
  "$id": "https://schemas.factori.local/0.55.0/final-bundle-replay-summary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Reproducibility replay summary reconstructed without command execution.",
  "properties": {
    "artifact_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifact Hashes",
      "type": "object"
    },
    "bundle_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bundle Id"
    },
    "commands_reexecuted": {
      "default": false,
      "title": "Commands Reexecuted",
      "type": "boolean"
    },
    "commands_used": {
      "items": {
        "type": "string"
      },
      "title": "Commands Used",
      "type": "array"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "external_api_used": {
      "default": false,
      "title": "External Api Used",
      "type": "boolean"
    },
    "external_tools_used": {
      "default": false,
      "title": "External Tools Used",
      "type": "boolean"
    },
    "factori_protocol_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Factori Protocol Version"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "ledger_tip_hash_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ledger Tip Hash Optional"
    },
    "network_used": {
      "default": false,
      "title": "Network Used",
      "type": "boolean"
    },
    "platform": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Platform"
    },
    "publication_ready": {
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "python_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Python Version"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "sandbox_configurations": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Sandbox Configurations",
      "type": "array"
    },
    "uv_lock_paths": {
      "items": {
        "type": "string"
      },
      "title": "Uv Lock Paths",
      "type": "array"
    }
  },
  "title": "FinalBundleReplaySummary",
  "type": "object",
  "x-factori-protocol-version": "0.55.0",
  "x-factori-source-model": "factori.schemas.FinalBundleReplaySummary",
  "x-factori-verification-evidence": false
}
