{
  "$id": "https://schemas.factori.local/0.84.0/llm-pair-ranking-prompt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Secret-free structured prompt contract for one LLM ranking batch.",
  "properties": {
    "backend_name": {
      "minLength": 1,
      "title": "Backend Name",
      "type": "string"
    },
    "batch_index": {
      "minimum": 1,
      "title": "Batch Index",
      "type": "integer"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "novelty_underuse_are_hypotheses": {
      "default": true,
      "title": "Novelty Underuse Are Hypotheses",
      "type": "boolean"
    },
    "pair_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Pair Ids",
      "type": "array"
    },
    "pair_payloads": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "minItems": 1,
      "title": "Pair Payloads",
      "type": "array"
    },
    "prompt_id": {
      "minLength": 1,
      "title": "Prompt Id",
      "type": "string"
    },
    "prompt_text": {
      "minLength": 1,
      "title": "Prompt Text",
      "type": "string"
    },
    "requested_output_schema": {
      "additionalProperties": true,
      "title": "Requested Output Schema",
      "type": "object"
    }
  },
  "required": [
    "prompt_id",
    "batch_index",
    "backend_name",
    "model",
    "pair_ids",
    "pair_payloads",
    "prompt_text",
    "requested_output_schema"
  ],
  "title": "LLMPairRankingPrompt",
  "type": "object",
  "x-factori-protocol-version": "0.84.0",
  "x-factori-source-model": "factori.schemas.LLMPairRankingPrompt",
  "x-factori-verification-evidence": false
}
