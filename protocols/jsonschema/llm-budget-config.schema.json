{
  "$id": "https://schemas.factori.local/0.30.0/llm-budget-config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Explicit budget limits for gated LLM paper orchestration.",
  "properties": {
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "fail_on_budget_unknown": {
      "default": true,
      "title": "Fail On Budget Unknown",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "max_candidate_generation_calls": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Candidate Generation Calls"
    },
    "max_claim_adjudication_calls": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Claim Adjudication Calls"
    },
    "max_estimated_cost_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Estimated Cost Usd"
    },
    "max_prose_calls": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Prose Calls"
    },
    "max_quality_repair_calls": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Quality Repair Calls"
    },
    "max_retries_per_call": {
      "default": 0,
      "maximum": 10,
      "minimum": 0,
      "title": "Max Retries Per Call",
      "type": "integer"
    },
    "max_review_calls": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Review Calls"
    },
    "max_source_relevance_adjudication_calls": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Source Relevance Adjudication Calls"
    },
    "max_total_calls": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Total Calls"
    },
    "max_total_input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Total Input Tokens"
    },
    "max_total_output_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Total Output Tokens"
    },
    "max_wallclock_seconds": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Wallclock Seconds"
    },
    "rate_limit_per_minute": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rate Limit Per Minute"
    }
  },
  "title": "LLMBudgetConfig",
  "type": "object",
  "x-factori-protocol-version": "0.30.0",
  "x-factori-source-model": "factori.schemas.LLMBudgetConfig",
  "x-factori-verification-evidence": false
}
