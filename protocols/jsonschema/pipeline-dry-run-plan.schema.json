{
  "$defs": {
    "DiagnosticSeverity": {
      "description": "Severity assigned to deterministic diagnostic root causes.",
      "enum": [
        "Info",
        "Warning",
        "Blocking"
      ],
      "title": "DiagnosticSeverity",
      "type": "string"
    },
    "DiagnosticStatus": {
      "description": "Overall read-only diagnostic status.",
      "enum": [
        "NoIssues",
        "WarningsOnly",
        "ActionRecommended",
        "Blocked"
      ],
      "title": "DiagnosticStatus",
      "type": "string"
    },
    "DryRunStatus": {
      "description": "Overall read-only pipeline dry-run planning status.",
      "enum": [
        "DryRunRunnable",
        "DryRunRunnableWithWarnings",
        "DryRunBlocked",
        "DryRunInvalid"
      ],
      "title": "DryRunStatus",
      "type": "string"
    },
    "DryRunValidationFinding": {
      "additionalProperties": false,
      "description": "One deterministic dry-run validation finding.",
      "properties": {
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        },
        "finding_id": {
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/DiagnosticSeverity"
        },
        "stage_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage Name"
        }
      },
      "required": [
        "finding_id",
        "severity",
        "message"
      ],
      "title": "DryRunValidationFinding",
      "type": "object"
    },
    "NextStageRecommendation": {
      "additionalProperties": false,
      "description": "Deterministic next-stage suggestion from checkpoint inspection.",
      "properties": {
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "stage_name": {
          "anyOf": [
            {
              "$ref": "#/$defs/PipelineStage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "reason"
      ],
      "title": "NextStageRecommendation",
      "type": "object"
    },
    "PipelineFailurePolicy": {
      "description": "Pipeline behavior after the first blocking or failed stage.",
      "enum": [
        "ContinueSafe",
        "FailFast"
      ],
      "title": "PipelineFailurePolicy",
      "type": "string"
    },
    "PipelineStage": {
      "description": "Supported deterministic one-command pipeline stages.",
      "enum": [
        "run-stage-a",
        "run-stage-b",
        "select-stage-c",
        "run-stage-c",
        "synthesize-abstract",
        "plan-manuscript",
        "build-draft-skeleton",
        "package-research-object",
        "assemble-paper-skeleton",
        "final-audit",
        "prepare-export",
        "replay-verify",
        "diagnose-run"
      ],
      "title": "PipelineStage",
      "type": "string"
    },
    "PlannedOutput": {
      "additionalProperties": false,
      "description": "Expected output from a dry-run planned stage.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "output_kind": {
          "minLength": 1,
          "title": "Output Kind",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "required_for_completion": {
          "default": true,
          "title": "Required For Completion",
          "type": "boolean"
        }
      },
      "required": [
        "output_kind",
        "description"
      ],
      "title": "PlannedOutput",
      "type": "object"
    },
    "PlannedStage": {
      "additionalProperties": false,
      "description": "One stage in a read-only pipeline dry-run plan.",
      "properties": {
        "already_complete": {
          "default": false,
          "title": "Already Complete",
          "type": "boolean"
        },
        "expected_outputs": {
          "items": {
            "$ref": "#/$defs/PlannedOutput"
          },
          "title": "Expected Outputs",
          "type": "array"
        },
        "missing_prerequisites": {
          "items": {
            "$ref": "#/$defs/StagePrerequisite"
          },
          "title": "Missing Prerequisites",
          "type": "array"
        },
        "prerequisites": {
          "items": {
            "$ref": "#/$defs/StagePrerequisite"
          },
          "title": "Prerequisites",
          "type": "array"
        },
        "read_only": {
          "default": false,
          "title": "Read Only",
          "type": "boolean"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "stage_name": {
          "minLength": 1,
          "title": "Stage Name",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PlannedStageStatus"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "stage_name",
        "status",
        "reason"
      ],
      "title": "PlannedStage",
      "type": "object"
    },
    "PlannedStageStatus": {
      "description": "Read-only status of one planned pipeline stage.",
      "enum": [
        "WouldRun",
        "WouldSkip",
        "AlreadyComplete",
        "BlockedByPrerequisite",
        "BlockedByStopAfter",
        "OutOfRange",
        "ReadOnlyCheck"
      ],
      "title": "PlannedStageStatus",
      "type": "string"
    },
    "ReleaseGateStatus": {
      "description": "Final deterministic release gate statuses.",
      "enum": [
        "ReleaseReady",
        "ReleaseBlocked",
        "ReleaseReadyWithWarnings"
      ],
      "title": "ReleaseGateStatus",
      "type": "string"
    },
    "ReplayStatus": {
      "description": "Read-only replay verification statuses.",
      "enum": [
        "ReplayVerified",
        "ReplayVerifiedWithWarnings",
        "ReplayFailed"
      ],
      "title": "ReplayStatus",
      "type": "string"
    },
    "ResumeValidationReport": {
      "additionalProperties": false,
      "description": "Read-only validation of whether a run can resume at a stage.",
      "properties": {
        "blocking_issues": {
          "items": {
            "type": "string"
          },
          "title": "Blocking Issues",
          "type": "array"
        },
        "is_provenance": {
          "default": false,
          "title": "Is Provenance",
          "type": "boolean"
        },
        "ledger_commit_count": {
          "minimum": 0,
          "title": "Ledger Commit Count",
          "type": "integer"
        },
        "ledger_exists": {
          "title": "Ledger Exists",
          "type": "boolean"
        },
        "missing_prerequisites": {
          "items": {
            "$ref": "#/$defs/StagePrerequisite"
          },
          "title": "Missing Prerequisites",
          "type": "array"
        },
        "next_recommended_stage": {
          "$ref": "#/$defs/NextStageRecommendation"
        },
        "prerequisites": {
          "items": {
            "$ref": "#/$defs/StagePrerequisite"
          },
          "title": "Prerequisites",
          "type": "array"
        },
        "read_only": {
          "default": true,
          "title": "Read Only",
          "type": "boolean"
        },
        "resume_status": {
          "$ref": "#/$defs/ResumeValidationStatus"
        },
        "run_exists": {
          "title": "Run Exists",
          "type": "boolean"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "start_at_stage": {
          "$ref": "#/$defs/PipelineStage"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "start_at_stage",
        "resume_status",
        "prerequisites",
        "next_recommended_stage",
        "run_exists",
        "ledger_exists",
        "ledger_commit_count"
      ],
      "title": "ResumeValidationReport",
      "type": "object"
    },
    "ResumeValidationStatus": {
      "description": "Read-only validation status for a requested pipeline resume point.",
      "enum": [
        "ResumeAllowed",
        "ResumeBlocked",
        "ResumeAllowedWithWarnings"
      ],
      "title": "ResumeValidationStatus",
      "type": "string"
    },
    "RunCompletenessStatus": {
      "description": "Disk-inspected deterministic run completeness status.",
      "enum": [
        "NoRunFound",
        "PartialRun",
        "ReadyToResume",
        "CompleteRun",
        "CompleteWithWarnings",
        "BlockedRun",
        "InconsistentRun"
      ],
      "title": "RunCompletenessStatus",
      "type": "string"
    },
    "RunStatusReport": {
      "additionalProperties": false,
      "description": "Read-only run checkpoint report. The ledger remains provenance.",
      "properties": {
        "artifact_manifest_exists": {
          "title": "Artifact Manifest Exists",
          "type": "boolean"
        },
        "blocking_issues": {
          "items": {
            "type": "string"
          },
          "title": "Blocking Issues",
          "type": "array"
        },
        "completed_stages": {
          "items": {
            "$ref": "#/$defs/PipelineStage"
          },
          "title": "Completed Stages",
          "type": "array"
        },
        "completeness_status": {
          "$ref": "#/$defs/RunCompletenessStatus"
        },
        "diagnostic_report_exists": {
          "title": "Diagnostic Report Exists",
          "type": "boolean"
        },
        "diagnostic_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagnosticStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "export_preparation_exists": {
          "title": "Export Preparation Exists",
          "type": "boolean"
        },
        "final_audit_exists": {
          "title": "Final Audit Exists",
          "type": "boolean"
        },
        "is_provenance": {
          "default": false,
          "title": "Is Provenance",
          "type": "boolean"
        },
        "last_completed_stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/PipelineStage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ledger_commit_count": {
          "minimum": 0,
          "title": "Ledger Commit Count",
          "type": "integer"
        },
        "ledger_exists": {
          "title": "Ledger Exists",
          "type": "boolean"
        },
        "missing_stages": {
          "items": {
            "$ref": "#/$defs/PipelineStage"
          },
          "title": "Missing Stages",
          "type": "array"
        },
        "next_recommended_stage": {
          "$ref": "#/$defs/NextStageRecommendation"
        },
        "paper_skeleton_exists": {
          "title": "Paper Skeleton Exists",
          "type": "boolean"
        },
        "read_only": {
          "default": true,
          "title": "Read Only",
          "type": "boolean"
        },
        "release_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseGateStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "replay_report_exists": {
          "title": "Replay Report Exists",
          "type": "boolean"
        },
        "replay_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReplayStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required_artifacts_missing": {
          "items": {
            "type": "string"
          },
          "title": "Required Artifacts Missing",
          "type": "array"
        },
        "required_artifacts_present": {
          "items": {
            "type": "string"
          },
          "title": "Required Artifacts Present",
          "type": "array"
        },
        "research_object_exists": {
          "title": "Research Object Exists",
          "type": "boolean"
        },
        "run_exists": {
          "title": "Run Exists",
          "type": "boolean"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "stage_checkpoints": {
          "items": {
            "$ref": "#/$defs/StageCheckpoint"
          },
          "title": "Stage Checkpoints",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "run_exists",
        "completed_stages",
        "missing_stages",
        "next_recommended_stage",
        "ledger_exists",
        "ledger_commit_count",
        "artifact_manifest_exists",
        "research_object_exists",
        "paper_skeleton_exists",
        "final_audit_exists",
        "export_preparation_exists",
        "replay_report_exists",
        "diagnostic_report_exists",
        "completeness_status"
      ],
      "title": "RunStatusReport",
      "type": "object"
    },
    "StageCheckpoint": {
      "additionalProperties": false,
      "description": "Read-only stage completion inspection derived from files on disk.",
      "properties": {
        "completed": {
          "title": "Completed",
          "type": "boolean"
        },
        "completion_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Completion Evidence",
          "type": "array"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "required_artifacts_missing": {
          "items": {
            "type": "string"
          },
          "title": "Required Artifacts Missing",
          "type": "array"
        },
        "required_artifacts_present": {
          "items": {
            "type": "string"
          },
          "title": "Required Artifacts Present",
          "type": "array"
        },
        "stage_name": {
          "$ref": "#/$defs/PipelineStage"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "stage_name",
        "completed"
      ],
      "title": "StageCheckpoint",
      "type": "object"
    },
    "StagePrerequisite": {
      "additionalProperties": false,
      "description": "One explicit artifact or report prerequisite for a pipeline stage.",
      "properties": {
        "blocking_if_missing": {
          "default": true,
          "title": "Blocking If Missing",
          "type": "boolean"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "required_artifact_path_or_kind": {
          "minLength": 1,
          "title": "Required Artifact Path Or Kind",
          "type": "string"
        },
        "required_prior_stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/PipelineStage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required_report": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Report"
        },
        "stage_name": {
          "$ref": "#/$defs/PipelineStage"
        }
      },
      "required": [
        "stage_name",
        "required_artifact_path_or_kind",
        "message"
      ],
      "title": "StagePrerequisite",
      "type": "object"
    }
  },
  "$id": "https://schemas.factori.local/0.81.0/pipeline-dry-run-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Read-only pipeline execution plan.",
  "properties": {
    "blocking_findings_count": {
      "minimum": 0,
      "title": "Blocking Findings Count",
      "type": "integer"
    },
    "certifies_scientific_validity": {
      "default": false,
      "title": "Certifies Scientific Validity",
      "type": "boolean"
    },
    "domain": {
      "default": "",
      "title": "Domain",
      "type": "string"
    },
    "dry_run": {
      "default": true,
      "title": "Dry Run",
      "type": "boolean"
    },
    "dry_run_status": {
      "$ref": "#/$defs/DryRunStatus"
    },
    "failure_policy": {
      "$ref": "#/$defs/PipelineFailurePolicy",
      "default": "ContinueSafe"
    },
    "method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Method"
    },
    "next_stage": {
      "anyOf": [
        {
          "$ref": "#/$defs/PipelineStage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "not_evidence": {
      "default": true,
      "title": "Not Evidence",
      "type": "boolean"
    },
    "not_ledgered": {
      "default": true,
      "title": "Not Ledgered",
      "type": "boolean"
    },
    "not_provenance": {
      "default": true,
      "title": "Not Provenance",
      "type": "boolean"
    },
    "planned_outputs": {
      "items": {
        "$ref": "#/$defs/PlannedOutput"
      },
      "title": "Planned Outputs",
      "type": "array"
    },
    "planned_stages": {
      "items": {
        "$ref": "#/$defs/PlannedStage"
      },
      "title": "Planned Stages",
      "type": "array"
    },
    "resume_validation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResumeValidationReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "root": {
      "default": ".",
      "title": "Root",
      "type": "string"
    },
    "run_diagnostics": {
      "default": false,
      "title": "Run Diagnostics",
      "type": "boolean"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "run_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStatusReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "selected_stages": {
      "items": {
        "$ref": "#/$defs/PipelineStage"
      },
      "title": "Selected Stages",
      "type": "array"
    },
    "skip_replay": {
      "default": false,
      "title": "Skip Replay",
      "type": "boolean"
    },
    "start_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/PipelineStage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "stop_after": {
      "anyOf": [
        {
          "$ref": "#/$defs/PipelineStage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "validation_findings": {
      "items": {
        "$ref": "#/$defs/DryRunValidationFinding"
      },
      "title": "Validation Findings",
      "type": "array"
    },
    "warnings_count": {
      "minimum": 0,
      "title": "Warnings Count",
      "type": "integer"
    },
    "write_diagnostic_report": {
      "default": false,
      "title": "Write Diagnostic Report",
      "type": "boolean"
    },
    "write_replay_report": {
      "default": false,
      "title": "Write Replay Report",
      "type": "boolean"
    }
  },
  "required": [
    "run_id",
    "dry_run_status",
    "planned_stages",
    "warnings_count",
    "blocking_findings_count"
  ],
  "title": "PipelineDryRunPlan",
  "type": "object",
  "x-factori-protocol-version": "0.81.0",
  "x-factori-source-model": "factori.schemas.PipelineDryRunPlan",
  "x-factori-verification-evidence": false
}
