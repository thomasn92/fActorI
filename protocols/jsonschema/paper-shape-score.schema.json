    "central_message": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Central Message",
      "type": "number"
    },
    "empirical_boundary": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Empirical Boundary",
      "type": "number"
    },
    "literature_positioning": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Literature Positioning",
      "type": "number"
