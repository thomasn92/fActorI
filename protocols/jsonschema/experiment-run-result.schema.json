{
  "$defs": {
    "DataRequirement": {
      "description": "Data access regimes from the MVP data gate.",
      "enum": [
        "NoData",
        "SyntheticOnly",
        "PublicDownload",
        "UserProvided"
      ],
      "title": "DataRequirement",
      "type": "string"
    },
    "ExperimentKind": {
      "description": "Conservative synthetic experiment kinds supported by the gated MVP seam.",
      "enum": [
        "SyntheticSimulation",
        "SyntheticAblation",
        "SyntheticRobustnessCheck",
        "NoDataSanityCheck"
      ],
      "title": "ExperimentKind",
      "type": "string"
    },
    "VerificationLabel": {
      "description": "Verification and epistemic labels required by the specification.",
      "enum": [
        "LeanVerified",
        "ExperimentVerified",
        "SyntheticExperimentVerified",
        "RealDataExperimentVerified",
        "Conjecture",
        "NegativeResult",
        "Limitation",
        "Unsupported"
      ],
      "title": "VerificationLabel",
      "type": "string"
    }
  },
  "$id": "https://schemas.factori.local/0.38.0/experiment-run-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Provider-neutral synthetic experiment result for gated local backends.",
  "properties": {
    "acceptance_criteria": {
      "additionalProperties": true,
      "title": "Acceptance Criteria",
      "type": "object"
    },
    "backend": {
      "minLength": 1,
      "title": "Backend",
      "type": "string"
    },
    "candidate_id": {
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "claim_id": {
      "minLength": 1,
      "title": "Claim Id",
      "type": "string"
    },
    "data_regime": {
      "$ref": "#/$defs/DataRequirement"
    },
    "elapsed_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Elapsed Ms"
    },
    "exit_code": {
      "title": "Exit Code",
      "type": "integer"
    },
    "experiment_id": {
      "minLength": 1,
      "title": "Experiment Id",
      "type": "string"
    },
    "experiment_kind": {
      "$ref": "#/$defs/ExperimentKind"
    },
    "fake": {
      "default": false,
      "title": "Fake",
      "type": "boolean"
    },
    "input_spec_hash": {
      "title": "Input Spec Hash",
      "type": "string"
    },
    "label": {
      "$ref": "#/$defs/VerificationLabel"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metrics",
      "type": "object"
    },
    "output_payload_hash": {
      "title": "Output Payload Hash",
      "type": "string"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "raw_trace_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Trace Artifact Id"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "runner_name": {
      "minLength": 1,
      "title": "Runner Name",
      "type": "string"
    },
    "runner_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runner Version"
    },
    "safety_report_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Safety Report Artifact Id"
    },
    "stderr_hash": {
      "title": "Stderr Hash",
      "type": "string"
    },
    "stdout_hash": {
      "title": "Stdout Hash",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "claim_id",
    "experiment_id",
    "backend",
    "provider",
    "experiment_kind",
    "data_regime",
    "runner_name",
    "exit_code",
    "stdout_hash",
    "stderr_hash",
    "input_spec_hash",
    "output_payload_hash",
    "passed",
    "label",
    "reason"
  ],
  "title": "ExperimentRunResult",
  "type": "object",
  "x-factori-protocol-version": "0.38.0",
  "x-factori-source-model": "factori.schemas.ExperimentRunResult",
  "x-factori-verification-evidence": false
}
