    "run_id",
    "source_substrate_id",
    "source_idea_node_id",
    "source_variant_id",
    "source_opportunity_id",
    "domain_id",
    "method_id",
    "title",
    "primary_claim_draft",
    "allowed_claim_scope",
    "package_rationale",
    "artifact_plans",
    "minimum_required_artifacts",
    "known_gaps",
    "unresolved_obligations",
    "recommended_next_action"
