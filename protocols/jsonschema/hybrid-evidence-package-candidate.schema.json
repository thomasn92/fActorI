      "const": false,
      "default": false,
      "title": "Novelty Proven",
      "type": "boolean"
    },
    "optional_supporting_artifacts": {
      "items": {
        "type": "string"
      },
      "title": "Optional Supporting Artifacts",
      "type": "array"
    },
    "package_id": {
      "minLength": 1,
      "title": "Package Id",
      "type": "string"
    },
    "package_rationale": {
      "minLength": 1,
      "title": "Package Rationale",
      "type": "string"
    },
    "primary_claim_draft": {
      "minLength": 1,
      "title": "Primary Claim Draft",
      "type": "string"
    },
    "publication_ready": {
      "const": false,
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "recommended_next_action": {
      "minLength": 1,
      "title": "Recommended Next Action",
      "type": "string"
    },
    "repair_of_package_id_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
