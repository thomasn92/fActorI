  "title": "HybridEvidencePackageCandidate",
  "type": "object",
  "x-factori-protocol-version": "0.89.0",
  "x-factori-source-model": "factori.schemas.HybridEvidencePackageCandidate",
  "x-factori-verification-evidence": false
