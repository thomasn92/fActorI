  "$id": "https://schemas.factori.local/0.36.0/autonomous-loop-run-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Non-evidence autonomous iterative loop controller report.",
  "properties": {
    "artifacts_created": {
      "items": {
        "type": "string"
      },
      "title": "Artifacts Created",
      "type": "array"
    },
    "completed_at": {
      "minLength": 1,
      "title": "Completed At",
      "type": "string"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "dedup_index_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dedup Index Path"
    },
    "duplicate_specs_skipped": {
      "default": 0,
      "minimum": 0,
      "title": "Duplicate Specs Skipped",
      "type": "integer"
    },
    "duplicate_strategy_count": {
      "default": 0,
      "minimum": 0,
      "title": "Duplicate Strategy Count",
      "type": "integer"
    },
    "final_claim_evidence_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Final Claim Evidence Counts",
      "type": "object"
    },
    "final_gap_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Final Gap Counts",
      "type": "object"
    },
    "final_publication_ready": {
      "default": false,
      "title": "Final Publication Ready",
      "type": "boolean"
    },
    "final_release_status": {
      "minLength": 1,
      "title": "Final Release Status",
      "type": "string"
    },
    "gap_attempt_history_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gap Attempt History Path"
    },
    "gaps_marked_exhausted": {
      "default": 0,
      "minimum": 0,
      "title": "Gaps Marked Exhausted",
      "type": "integer"
    },
    "human_intervention_reason_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Human Intervention Reason Optional"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "initial_claim_evidence_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Initial Claim Evidence Counts",
      "type": "object"
    },
    "initial_gap_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Initial Gap Counts",
      "type": "object"
    },
    "initial_publication_ready": {
      "default": false,
      "title": "Initial Publication Ready",
      "type": "boolean"
    },
    "initial_release_status": {
      "minLength": 1,
      "title": "Initial Release Status",
      "type": "string"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "iterations": {
      "items": {
        "$ref": "#/$defs/AutonomousLoopIterationReport"
      },
      "title": "Iterations",
      "type": "array"
    },
    "iterations_completed": {
      "minimum": 0,
      "title": "Iterations Completed",
      "type": "integer"
    },
    "iterations_without_progress": {
      "default": 0,
      "minimum": 0,
      "title": "Iterations Without Progress",
      "type": "integer"
    },
    "loop_backend": {
      "default": "deterministic",
      "enum": [
        "deterministic",
        "fake",
        "openai"
      ],
      "title": "Loop Backend",
      "type": "string"
    },
    "loop_id": {
      "minLength": 1,
      "title": "Loop Id",
      "type": "string"
    },
    "loop_status": {
      "enum": [
        "completed",
        "completed_with_deferred_gaps",
        "stopped_no_progress",
        "stopped_max_iterations",
        "blocked_requires_human_intervention",
        "failed"
      ],
      "title": "Loop Status",
      "type": "string"
    },
    "max_iterations": {
      "minimum": 1,
      "title": "Max Iterations",
      "type": "integer"
    },
    "publication_ready": {
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "requires_human_intervention": {
      "default": false,
      "title": "Requires Human Intervention",
      "type": "boolean"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "selected_strategy_count": {
      "default": 0,
      "minimum": 0,
      "title": "Selected Strategy Count",
      "type": "integer"
    },
    "started_at": {
      "format": "date-time",
      "minLength": 1,
      "title": "Started At",
      "type": "string"
    },
    "stop_reason": {
      "enum": [
        "no_unsupported_claims",
        "no_automation_ready_items",
        "no_progress",
        "max_iterations_reached",
        "safety_gate_blocked",
        "ledger_invalid",
        "requires_human_intervention",
        "exhausted_gaps",
        "deferred_gaps"
      ],
      "title": "Stop Reason",
      "type": "string"
    },
    "stopped_due_to_exhausted_gaps": {
      "default": false,
      "title": "Stopped Due To Exhausted Gaps",
      "type": "boolean"
    },
    "strategy_diversification_enabled": {
      "default": false,
      "title": "Strategy Diversification Enabled",
      "type": "boolean"
    },
    "strategy_diversification_report_paths": {
      "items": {
        "type": "string"
      },
      "title": "Strategy Diversification Report Paths",
      "type": "array"
    },
    "strategy_option_count": {
      "default": 0,
      "minimum": 0,
      "title": "Strategy Option Count",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "loop_id",
    "loop_status",
    "max_iterations",
    "iterations_completed",
    "stop_reason",
    "started_at",
    "completed_at",
    "initial_release_status",
    "final_release_status"
  ],
  "title": "AutonomousLoopRunReport",
  "type": "object",
  "x-factori-protocol-version": "0.36.0",
  "x-factori-source-model": "factori.schemas.AutonomousLoopRunReport",
  "x-factori-verification-evidence": false
