{
  "$defs": {
    "FinalNucleusType": {
      "description": "Final synthesis nucleus types.",
      "enum": [
        "AbstractNucleus",
        "BranchNucleus"
      ],
      "title": "FinalNucleusType",
      "type": "string"
    },
    "ManuscriptSectionPlan": {
      "additionalProperties": false,
      "description": "Section-level manuscript plan shared by legacy and nucleus-centered drafting.",
      "properties": {
        "allowed_claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Claim Ids",
          "type": "array"
        },
        "artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "bullets": {
          "items": {
            "type": "string"
          },
          "title": "Bullets",
          "type": "array"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "narrative_roles": {
          "items": {
            "$ref": "#/$defs/NarrativeSectionRole"
          },
          "title": "Narrative Roles",
          "type": "array"
        },
        "purpose": {
          "default": "",
          "title": "Purpose",
          "type": "string"
        },
        "required_citations": {
          "items": {
            "type": "string"
          },
          "title": "Required Citations",
          "type": "array"
        },
        "scope_constraints": {
          "items": {
            "type": "string"
          },
          "title": "Scope Constraints",
          "type": "array"
        },
        "section_id": {
          "minLength": 1,
          "title": "Section Id",
          "type": "string"
        },
        "supporting_package_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Package Ids",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "section_id",
        "title",
        "bullets"
      ],
      "title": "ManuscriptSectionPlan",
      "type": "object"
    },
    "NarrativeSectionRole": {
      "description": "Manuscript section roles used by the narrative-quality critic.",
      "enum": [
        "CentralMessage",
        "ProblemFraming",
        "BackgroundLiteraturePositioning",
        "ModelFrame",
        "MainBodyResult",
        "DerivativeOrCorollary",
        "TechnicalLemma",
        "AppendixOnlyProof",
        "NumericalValidation",
        "EmpiricalDiscussion",
        "SyntheticBoundary",
        "LimitationsDiscussion"
      ],
      "title": "NarrativeSectionRole",
      "type": "string"
    }
  },
  "$id": "https://schemas.factori.local/0.78.0/manuscript-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structured manuscript plan.",
  "properties": {
    "allowed_claim_ids": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Claim Ids",
      "type": "array"
    },
    "blocked_claim_ids": {
      "items": {
        "type": "string"
      },
      "title": "Blocked Claim Ids",
      "type": "array"
    },
    "fake": {
      "default": true,
      "title": "Fake",
      "type": "boolean"
    },
    "final_nucleus_id": {
      "minLength": 1,
      "title": "Final Nucleus Id",
      "type": "string"
    },
    "nucleus_type": {
      "$ref": "#/$defs/FinalNucleusType"
    },
    "plan_id": {
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/ManuscriptSectionPlan"
      },
      "title": "Sections",
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "final_nucleus_id",
    "nucleus_type",
    "title",
    "sections",
    "allowed_claim_ids",
    "blocked_claim_ids"
  ],
  "title": "ManuscriptPlan",
  "type": "object",
  "x-factori-protocol-version": "0.78.0",
  "x-factori-source-model": "factori.schemas.ManuscriptPlan",
  "x-factori-verification-evidence": false
}
