{
  "$id": "https://schemas.factori.local/0.85.0/nucleus-manuscript-raw-artifact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Secret-free raw LLM provenance for M105 narrative operations.",
  "properties": {
    "accepted_id_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accepted Id Optional"
    },
    "backend_name": {
      "minLength": 1,
      "title": "Backend Name",
      "type": "string"
    },
    "creates_scientific_validation": {
      "const": false,
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "fallback_used": {
      "default": false,
      "title": "Fallback Used",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "const": false,
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "operation": {
      "enum": [
        "planning",
        "synthesis",
        "critic",
        "revision"
      ],
      "title": "Operation",
      "type": "string"
    },
    "prompt_text": {
      "minLength": 1,
      "title": "Prompt Text",
      "type": "string"
    },
    "publication_ready": {
      "const": false,
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "raw_artifact_id": {
      "minLength": 1,
      "title": "Raw Artifact Id",
      "type": "string"
    },
    "raw_response": {
      "additionalProperties": true,
      "title": "Raw Response",
      "type": "object"
    },
    "rejection_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Rejection Reasons",
      "type": "array"
    },
    "requested_output_schema": {
      "additionalProperties": true,
      "title": "Requested Output Schema",
      "type": "object"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "raw_artifact_id",
    "run_id",
    "operation",
    "backend_name",
    "model",
    "prompt_text",
    "requested_output_schema",
    "raw_response"
  ],
  "title": "NucleusManuscriptRawArtifact",
  "type": "object",
  "x-factori-protocol-version": "0.85.0",
  "x-factori-source-model": "factori.schemas.NucleusManuscriptRawArtifact",
  "x-factori-verification-evidence": false
}
