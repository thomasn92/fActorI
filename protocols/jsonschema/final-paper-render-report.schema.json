{
  "$defs": {
    "LatexCompileCheckReport": {
      "additionalProperties": false,
      "description": "Aggregate render/check report; not evidence or publication readiness.",
      "properties": {
        "config": {
          "$ref": "#/$defs/LatexRenderConfig"
        },
        "creates_scientific_validation": {
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "implies_publication_readiness": {
          "default": false,
          "title": "Implies Publication Readiness",
          "type": "boolean"
        },
        "is_verification_evidence": {
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "render_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/LatexRenderResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "config",
        "passed"
      ],
      "title": "LatexCompileCheckReport",
      "type": "object"
    },
    "LatexRenderConfig": {
      "additionalProperties": false,
      "description": "Configuration for an optional gated LaTeX render/check.",
      "properties": {
        "allow_external_tools": {
          "default": false,
          "title": "Allow External Tools",
          "type": "boolean"
        },
        "backend": {
          "default": "local_latex",
          "title": "Backend",
          "type": "string"
        },
        "latex_executable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latex Executable"
        },
        "render_check_enabled": {
          "default": false,
          "title": "Render Check Enabled",
          "type": "boolean"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 30,
          "maximum": 600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "LatexRenderConfig",
      "type": "object"
    },
    "LatexRenderResult": {
      "additionalProperties": false,
      "description": "Result of an optional LaTeX render/check; presentation only.",
      "properties": {
        "backend": {
          "minLength": 1,
          "title": "Backend",
          "type": "string"
        },
        "creates_scientific_validation": {
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "implies_publication_readiness": {
          "default": false,
          "title": "Implies Publication Readiness",
          "type": "boolean"
        },
        "is_verification_evidence": {
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "pdf_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pdf Hash"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "rendered_pdf_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rendered Pdf Artifact Id"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "stderr_hash": {
          "minLength": 1,
          "title": "Stderr Hash",
          "type": "string"
        },
        "stdout_hash": {
          "minLength": 1,
          "title": "Stdout Hash",
          "type": "string"
        },
        "tex_hash": {
          "minLength": 1,
          "title": "Tex Hash",
          "type": "string"
        },
        "tool_name": {
          "minLength": 1,
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "backend",
        "tool_name",
        "exit_code",
        "stdout_hash",
        "stderr_hash",
        "tex_hash",
        "passed",
        "reason"
      ],
      "title": "LatexRenderResult",
      "type": "object"
    }
  },
  "$id": "https://schemas.factori.local/0.85.0/final-paper-render-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Append-only local PDF rendering report for one verified final paper.",
  "properties": {
    "blocking_findings": {
      "items": {
        "type": "string"
      },
      "title": "Blocking Findings",
      "type": "array"
    },
    "compile_check_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/LatexCompileCheckReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "creates_real_world_validation": {
      "const": false,
      "default": false,
      "title": "Creates Real World Validation",
      "type": "boolean"
    },
    "creates_scientific_validation": {
      "const": false,
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "implies_publication_readiness": {
      "const": false,
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "const": false,
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "production_ready": {
      "default": false,
      "title": "Production Ready",
      "type": "boolean"
    },
    "publication_ready": {
      "const": false,
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "render_status": {
      "enum": [
        "rendered",
        "failed",
        "deferred"
      ],
      "title": "Render Status",
      "type": "string"
    },
    "rendered_pdf_path_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rendered Pdf Path Optional"
    },
    "report_id": {
      "minLength": 1,
      "title": "Report Id",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "source_assembly_report_path_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Assembly Report Path Optional"
    },
    "source_latex_path_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Latex Path Optional"
    },
    "source_verification_report_path_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Verification Report Path Optional"
    },
    "standalone_latex_path_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Standalone Latex Path Optional"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "report_id",
    "run_id",
    "render_status"
  ],
  "title": "FinalPaperRenderReport",
  "type": "object",
  "x-factori-protocol-version": "0.85.0",
  "x-factori-source-model": "factori.schemas.FinalPaperRenderReport",
  "x-factori-verification-evidence": false
}
