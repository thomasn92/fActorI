{
  "$id": "https://schemas.factori.local/0.86.0/llm-route-planning-prompt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Secret-free prompt contract for one LLM route-planning call.",
  "properties": {
    "backend_name": {
      "minLength": 1,
      "title": "Backend Name",
      "type": "string"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "prompt_id": {
      "minLength": 1,
      "title": "Prompt Id",
      "type": "string"
    },
    "prompt_text": {
      "minLength": 1,
      "title": "Prompt Text",
      "type": "string"
    },
    "requested_output_schema": {
      "additionalProperties": true,
      "title": "Requested Output Schema",
      "type": "object"
    },
    "retrieval_context_payload": {
      "additionalProperties": true,
      "title": "Retrieval Context Payload",
      "type": "object"
    },
    "source_metadata_payload": {
      "additionalProperties": true,
      "title": "Source Metadata Payload",
      "type": "object"
    },
    "source_substrate_id": {
      "minLength": 1,
      "title": "Source Substrate Id",
      "type": "string"
    },
    "substrate_payload": {
      "additionalProperties": true,
      "title": "Substrate Payload",
      "type": "object"
    }
  },
  "required": [
    "prompt_id",
    "backend_name",
    "model",
    "source_substrate_id",
    "substrate_payload",
    "source_metadata_payload",
    "retrieval_context_payload",
    "prompt_text",
    "requested_output_schema"
  ],
  "title": "LLMRoutePlanningPrompt",
  "type": "object",
  "x-factori-protocol-version": "0.86.0",
  "x-factori-source-model": "factori.schemas.LLMRoutePlanningPrompt",
  "x-factori-verification-evidence": false
}
