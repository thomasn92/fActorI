{
  "$defs": {
    "BackendKind": {
      "description": "Authority classification for scientific and infrastructure backends.",
      "enum": [
        "fake",
        "fixture",
        "deterministic_template",
        "curated_catalog",
        "heuristic",
        "llm_openai",
        "llm_other",
        "retrieval_real",
        "local_execution",
        "symbolic_checker",
        "human"
      ],
      "title": "BackendKind",
      "type": "string"
    },
    "ScientificStageKind": {
      "description": "Scientific-generation, judgment, execution, and validation stage classes.",
      "enum": [
        "opportunity_discovery",
        "atlas_construction",
        "compatibility_filter",
        "pair_ranking",
        "diversity_selection",
        "idea_tree_construction",
        "variance_generation",
        "substrate_construction",
        "substrate_selection",
        "branch_routing",
        "experiment_design",
        "spec_validation",
        "experiment_code_generation",
        "code_safety_audit",
        "experiment_execution",
        "metric_computation",
        "hybrid_evidence_planning",
        "symbolic_derivation",
        "adjudication",
        "critic_review",
        "literature_retrieval",
        "novelty_assessment",
        "manuscript_synthesis",
        "claim_audit",
        "bundle_verification"
      ],
      "title": "ScientificStageKind",
      "type": "string"
    }
  },
  "$id": "https://schemas.factori.local/0.69.0/stage-backend-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Explicit backend authority record for one pipeline stage.",
  "properties": {
    "allowed_in_production": {
      "title": "Allowed In Production",
      "type": "boolean"
    },
    "artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Ids",
      "type": "array"
    },
    "backend_kind": {
      "$ref": "#/$defs/BackendKind"
    },
    "backend_name": {
      "minLength": 1,
      "title": "Backend Name",
      "type": "string"
    },
    "fallback_disclosed": {
      "default": true,
      "title": "Fallback Disclosed",
      "type": "boolean"
    },
    "fallback_used": {
      "default": false,
      "title": "Fallback Used",
      "type": "boolean"
    },
    "is_execution_or_verification": {
      "title": "Is Execution Or Verification",
      "type": "boolean"
    },
    "is_scientific_generation": {
      "title": "Is Scientific Generation",
      "type": "boolean"
    },
    "is_scientific_judgment": {
      "title": "Is Scientific Judgment",
      "type": "boolean"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "stage_id": {
      "minLength": 1,
      "title": "Stage Id",
      "type": "string"
    },
    "stage_kind": {
      "$ref": "#/$defs/ScientificStageKind"
    }
  },
  "required": [
    "stage_id",
    "stage_kind",
    "backend_kind",
    "backend_name",
    "is_scientific_generation",
    "is_scientific_judgment",
    "is_execution_or_verification",
    "allowed_in_production",
    "reason"
  ],
  "title": "StageBackendRecord",
  "type": "object",
  "x-factori-protocol-version": "0.69.0",
  "x-factori-source-model": "factori.schemas.StageBackendRecord",
  "x-factori-verification-evidence": false
}
