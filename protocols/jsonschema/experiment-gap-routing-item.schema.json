{
  "$id": "https://schemas.factori.local/0.48.0/experiment-gap-routing-item.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One deterministic experiment-gap routing item.",
  "properties": {
    "claim_class": {
      "minLength": 1,
      "title": "Claim Class",
      "type": "string"
    },
    "created_experiment_spec_path_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created Experiment Spec Path Optional"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "existing_experiment_spec_path_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Existing Experiment Spec Path Optional"
    },
    "gap_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Gap Fingerprint",
      "type": "string"
    },
    "gap_type": {
      "enum": [
        "needs_python_experiment",
        "needs_formal_proof",
        "needs_retrieval_expansion",
        "needs_claim_downgrade",
        "needs_claim_removal",
        "needs_manuscript_refresh",
        "sufficiently_supported_for_bounded_draft"
      ],
      "title": "Gap Type",
      "type": "string"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "item_id": {
      "minLength": 1,
      "title": "Item Id",
      "type": "string"
    },
    "rejection_reason_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejection Reason Optional"
    },
    "routing_decision": {
      "minLength": 1,
      "title": "Routing Decision",
      "type": "string"
    },
    "routing_status": {
      "enum": [
        "routed",
        "unrouted_no_template",
        "rejected_policy",
        "deferred_budget_exhausted",
        "deferred_requires_inputs"
      ],
      "title": "Routing Status",
      "type": "string"
    },
    "safety_notes": {
      "items": {
        "type": "string"
      },
      "title": "Safety Notes",
      "type": "array"
    },
    "selected_template_id_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Template Id Optional"
    },
    "target_claim_id": {
      "minLength": 1,
      "title": "Target Claim Id",
      "type": "string"
    },
    "target_section_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Section Optional"
    },
    "template_family_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Template Family Optional"
    }
  },
  "required": [
    "item_id",
    "target_claim_id",
    "gap_fingerprint",
    "claim_class",
    "gap_type",
    "routing_decision",
    "routing_status"
  ],
  "title": "ExperimentGapRoutingItem",
  "type": "object",
  "x-factori-protocol-version": "0.48.0",
  "x-factori-source-model": "factori.schemas.ExperimentGapRoutingItem",
  "x-factori-verification-evidence": false
}
