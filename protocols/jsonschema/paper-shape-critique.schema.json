      "type": "object"
    },
    "PaperShapeScore": {
      "additionalProperties": false,
      "description": "Weighted deterministic paper-shape score; diagnostic only.",
      "properties": {
        "appendix_allocation": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Appendix Allocation",
          "type": "number"
        },
        "central_message": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Central Message",
          "type": "number"
        },
        "empirical_boundary": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Empirical Boundary",
          "type": "number"
        },
        "literature_positioning": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Literature Positioning",
          "type": "number"
        },
        "main_result_focus": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Main Result Focus",
          "type": "number"
        },
        "model_clarity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Model Clarity",
          "type": "number"
        },
        "numerics_purpose": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Numerics Purpose",
          "type": "number"
        },
        "problem_framing": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Problem Framing",
          "type": "number"
        },
        "total": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Total",
          "type": "number"
        }
      },
      "required": [
        "central_message",
        "problem_framing",
        "literature_positioning",
        "model_clarity",
        "main_result_focus",
        "numerics_purpose",
        "empirical_boundary",
        "appendix_allocation",
        "total"
      ],
      "title": "PaperShapeScore",
      "type": "object"
    },
    "PaperShapeStatus": {
      "description": "Diagnostic paper-shape status; not a scientific validation label.",
      "enum": [
        "PaperShaped",
        "PaperShapedWithWarnings",
        "PaperShapeWeak",
        "NotPaperShaped"
      ],
      "title": "PaperShapeStatus",
      "type": "string"
    }
  },
  "$id": "https://schemas.factori.local/0.18.0/paper-shape-critique.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Deterministic paper-shape critique; not verification evidence.",
  "properties": {
    "appendix_allocation_assessment": {
      "$ref": "#/$defs/AppendixAllocationAssessment"
    },
    "central_message_assessment": {
      "$ref": "#/$defs/MainMessageAssessment"
    },
    "contract_id": {
      "minLength": 1,
      "title": "Contract Id",
      "type": "string"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "critique_id": {
      "minLength": 1,
      "title": "Critique Id",
      "type": "string"
    },
    "empirical_boundary_assessment": {
      "$ref": "#/$defs/EmpiricalBoundaryAssessment"
    },
    "fake": {
      "default": true,
      "title": "Fake",
      "type": "boolean"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "literature_positioning_assessment": {
      "$ref": "#/$defs/LiteraturePositioningAssessment"
    },
    "main_result_assessment": {
      "$ref": "#/$defs/MainResultAssessment"
    },
    "missing_items": {
      "items": {
        "type": "string"
      },
      "title": "Missing Items",
      "type": "array"
    },
    "model_notation_assessment": {
      "$ref": "#/$defs/ModelNotationAssessment"
    },
    "numerical_study_assessment": {
      "$ref": "#/$defs/NumericalStudyAssessment"
    },
    "recommended_structural_edits": {
      "items": {
        "type": "string"
      },
      "title": "Recommended Structural Edits",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "score": {
      "$ref": "#/$defs/PaperShapeScore"
    },
    "status": {
      "$ref": "#/$defs/PaperShapeStatus"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "critique_id",
    "run_id",
    "contract_id",
    "status",
    "score",
    "central_message_assessment",
    "literature_positioning_assessment",
    "model_notation_assessment",
    "main_result_assessment",
    "numerical_study_assessment",
    "empirical_boundary_assessment",
    "appendix_allocation_assessment"
  ],
  "title": "PaperShapeCritique",
  "type": "object",
  "x-factori-protocol-version": "0.18.0",
  "x-factori-source-model": "factori.schemas.PaperShapeCritique",
  "x-factori-verification-evidence": false
}
