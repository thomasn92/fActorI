        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "score",
        "passed",
        "empirical_section_present"
      ],
      "title": "EmpiricalBoundaryAssessment",
      "type": "object"
    },
    "LiteraturePositioningAssessment": {
