{
  "$defs": {
    "AppendixAllocationAssessment": {
      "additionalProperties": false,
      "description": "Assessment of appendix allocation for technical material.",
      "properties": {
        "findings": {
          "items": {
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "technical_lemmas_in_main_body": {
          "minimum": 0,
          "title": "Technical Lemmas In Main Body",
          "type": "integer"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "score",
        "passed",
        "technical_lemmas_in_main_body"
      ],
      "title": "AppendixAllocationAssessment",
      "type": "object"
    },
    "EmpiricalBoundaryAssessment": {
