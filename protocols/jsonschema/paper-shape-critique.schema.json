      ],
      "title": "MainMessageAssessment",
      "type": "object"
    },
    "MainResultAssessment": {
      "additionalProperties": false,
      "description": "Assessment of one-main-result discipline.",
      "properties": {
        "findings": {
          "items": {
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "primary_main_results": {
          "minimum": 0,
          "title": "Primary Main Results",
          "type": "integer"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
