{
  "$id": "https://schemas.factori.local/0.86.0/human-review-reconciliation-cycle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable reconciliation-cycle index entry.",
  "properties": {
    "applied_change_count": {
      "minimum": 0,
      "title": "Applied Change Count",
      "type": "integer"
    },
    "cycle_number": {
      "minimum": 1,
      "title": "Cycle Number",
      "type": "integer"
    },
    "deferred_change_count": {
      "minimum": 0,
      "title": "Deferred Change Count",
      "type": "integer"
    },
    "ledger_tip_after_cycle": {
      "minLength": 1,
      "title": "Ledger Tip After Cycle",
      "type": "string"
    },
    "reconciled_manuscript_path": {
      "minLength": 1,
      "title": "Reconciled Manuscript Path",
      "type": "string"
    },
    "reconciliation_report_path": {
      "minLength": 1,
      "title": "Reconciliation Report Path",
      "type": "string"
    },
    "reconciliation_status": {
      "minLength": 1,
      "title": "Reconciliation Status",
      "type": "string"
    },
    "rejected_change_count": {
      "minimum": 0,
      "title": "Rejected Change Count",
      "type": "integer"
    },
    "request_set_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Set Id"
    },
    "requires_new_evidence_count": {
      "minimum": 0,
      "title": "Requires New Evidence Count",
      "type": "integer"
    },
    "reviewer_summary_path": {
      "minLength": 1,
      "title": "Reviewer Summary Path",
      "type": "string"
    },
    "unresolved_request_count": {
      "minimum": 0,
      "title": "Unresolved Request Count",
      "type": "integer"
    }
  },
  "required": [
    "cycle_number",
    "reconciliation_status",
    "reconciliation_report_path",
    "reconciled_manuscript_path",
    "reviewer_summary_path",
    "applied_change_count",
    "rejected_change_count",
    "deferred_change_count",
    "requires_new_evidence_count",
    "unresolved_request_count",
    "ledger_tip_after_cycle"
  ],
  "title": "HumanReviewReconciliationCycle",
  "type": "object",
  "x-factori-protocol-version": "0.86.0",
  "x-factori-source-model": "factori.schemas.HumanReviewReconciliationCycle",
  "x-factori-verification-evidence": false
}
