{
  "$defs": {
    "BackendKind": {
      "description": "Authority classification for scientific and infrastructure backends.",
      "enum": [
        "fake",
        "fixture",
        "deterministic_template",
        "curated_catalog",
        "heuristic",
        "llm_openai",
        "llm_other",
        "retrieval_real",
        "local_execution",
        "symbolic_checker",
        "human"
      ],
      "title": "BackendKind",
      "type": "string"
    },
    "BranchRouteType": {
      "description": "Deterministic next-action classes for concrete scientific branches.",
      "enum": [
        "synthetic_experiment",
        "benchmark_tournament",
        "counterexample_search",
        "symbolic_derivation",
        "applied_math_reduction",
        "proof_plan",
        "literature_novelty_check",
        "defer_insufficient_substrate",
        "reject_false_bridge"
      ],
      "title": "BranchRouteType",
      "type": "string"
    },
    "ExperimentCodeSafetyAudit": {
      "additionalProperties": false,
      "description": "Deterministic AST and policy audit for generated experiment code.",
      "properties": {
        "allowed_imports": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Imports",
          "type": "array"
        },
        "blocked": {
          "title": "Blocked",
          "type": "boolean"
        },
        "code_artifact_id": {
          "minLength": 1,
          "title": "Code Artifact Id",
          "type": "string"
        },
        "creates_scientific_validation": {
          "const": false,
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "filesystem_escape_found": {
          "items": {
            "type": "string"
          },
          "title": "Filesystem Escape Found",
          "type": "array"
        },
        "forbidden_imports_found": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Imports Found",
          "type": "array"
        },
        "is_verification_evidence": {
          "const": false,
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "network_access_found": {
          "items": {
            "type": "string"
          },
          "title": "Network Access Found",
          "type": "array"
        },
        "nondeterminism_risk": {
          "items": {
            "type": "string"
          },
          "title": "Nondeterminism Risk",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "publication_ready": {
          "const": false,
          "default": false,
          "title": "Publication Ready",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "resource_risk": {
          "items": {
            "type": "string"
          },
          "title": "Resource Risk",
          "type": "array"
        },
        "subprocess_found": {
          "items": {
            "type": "string"
          },
          "title": "Subprocess Found",
          "type": "array"
        },
        "unsafe_eval_exec_found": {
          "items": {
            "type": "string"
          },
          "title": "Unsafe Eval Exec Found",
          "type": "array"
        }
      },
      "required": [
        "code_artifact_id",
        "passed",
        "blocked"
      ],
      "title": "ExperimentCodeSafetyAudit",
      "type": "object"
    },
    "GeneratedExperimentResult": {
      "additionalProperties": false,
      "description": "Bounded result classification derived from actual local execution only.",
      "properties": {
        "baseline_summary": {
          "minLength": 1,
          "title": "Baseline Summary",
          "type": "string"
        },
        "control_summary": {
          "minLength": 1,
          "title": "Control Summary",
          "type": "string"
        },
        "creates_real_world_validation": {
          "const": false,
          "default": false,
          "title": "Creates Real World Validation",
          "type": "boolean"
        },
        "creates_scientific_validation": {
          "const": false,
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "evidence_label": {
          "enum": [
            "SyntheticExperimentEvidence",
            "BenchmarkEvidence",
            "CounterexampleEvidence",
            "SymbolicDerivationDraft",
            "SymbolicReductionDraft",
            "ProofPlanDraft",
            "RetrievalNoveltyAssessment",
            "NumericalIllustrationEvidence",
            "NegativeControlEvidence",
            "RobustnessSweepEvidence",
            "NegativeResult",
            "InconclusiveResult",
            "UnsupportedRouteDeferred",
            "RejectedFalseBridge"
          ],
          "title": "Evidence Label",
          "type": "string"
        },
        "failure_criteria_satisfied": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Criteria Satisfied"
        },
        "failure_reason_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Reason Optional"
        },
        "implies_publication_readiness": {
          "const": false,
          "default": false,
          "title": "Implies Publication Readiness",
          "type": "boolean"
        },
        "is_verification_evidence": {
          "const": false,
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "metric_sources": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Metric Sources",
          "type": "object"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "negative_control_summary": {
          "minLength": 1,
          "title": "Negative Control Summary",
          "type": "string"
        },
        "publication_ready": {
          "const": false,
          "default": false,
          "title": "Publication Ready",
          "type": "boolean"
        },
        "result_id": {
          "minLength": 1,
          "title": "Result Id",
          "type": "string"
        },
        "route_type": {
          "$ref": "#/$defs/BranchRouteType"
        },
        "scope_label": {
          "minLength": 1,
          "title": "Scope Label",
          "type": "string"
        },
        "source_route_id": {
          "minLength": 1,
          "title": "Source Route Id",
          "type": "string"
        },
        "source_spec_id": {
          "minLength": 1,
          "title": "Source Spec Id",
          "type": "string"
        },
        "source_substrate_id": {
          "minLength": 1,
          "title": "Source Substrate Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "negative_result",
            "inconclusive",
            "failed",
            "blocked_safety_audit",
            "deferred_non_executable_route"
          ],
          "title": "Status",
          "type": "string"
        },
        "success_criteria_satisfied": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Success Criteria Satisfied"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "result_id",
        "source_spec_id",
        "source_route_id",
        "source_substrate_id",
        "route_type",
        "status",
        "evidence_label",
        "scope_label",
        "baseline_summary",
        "control_summary",
        "negative_control_summary"
      ],
      "title": "GeneratedExperimentResult",
      "type": "object"
    },
    "LLMExperimentCodeArtifact": {
      "additionalProperties": false,
      "description": "One LLM-authored Python experiment proposal; not an execution result.",
      "properties": {
        "backend_kind": {
          "$ref": "#/$defs/BackendKind"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "code_artifact_id": {
          "minLength": 1,
          "title": "Code Artifact Id",
          "type": "string"
        },
        "creates_real_world_validation": {
          "const": false,
          "default": false,
          "title": "Creates Real World Validation",
          "type": "boolean"
        },
        "creates_scientific_validation": {
          "const": false,
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "declared_dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Declared Dependencies",
          "type": "array"
        },
        "entrypoint": {
          "minLength": 1,
          "title": "Entrypoint",
          "type": "string"
        },
        "expected_output_files": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Expected Output Files",
          "type": "array"
        },
        "filesystem_scope": {
          "minLength": 1,
          "title": "Filesystem Scope",
          "type": "string"
        },
        "implies_publication_readiness": {
          "const": false,
          "default": false,
          "title": "Implies Publication Readiness",
          "type": "boolean"
        },
        "is_verification_evidence": {
          "const": false,
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "language": {
          "const": "python",
          "default": "python",
          "title": "Language",
          "type": "string"
        },
        "network_required": {
          "const": false,
          "default": false,
          "title": "Network Required",
          "type": "boolean"
        },
        "publication_ready": {
          "const": false,
          "default": false,
          "title": "Publication Ready",
          "type": "boolean"
        },
        "random_seed": {
          "minimum": 0,
          "title": "Random Seed",
          "type": "integer"
        },
        "required_inputs": {
          "items": {
            "type": "string"
          },
          "title": "Required Inputs",
          "type": "array"
        },
        "route_type": {
          "$ref": "#/$defs/BranchRouteType"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "source_route_id": {
          "minLength": 1,
          "title": "Source Route Id",
          "type": "string"
        },
        "source_spec_id": {
          "minLength": 1,
          "title": "Source Spec Id",
          "type": "string"
        },
        "source_substrate_id": {
          "minLength": 1,
          "title": "Source Substrate Id",
          "type": "string"
        },
        "timeout_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "code_artifact_id",
        "run_id",
        "source_spec_id",
        "source_route_id",
        "source_substrate_id",
        "route_type",
        "backend_kind",
        "entrypoint",
        "code",
        "expected_output_files",
        "random_seed",
        "timeout_seconds",
        "filesystem_scope"
      ],
      "title": "LLMExperimentCodeArtifact",
      "type": "object"
    },
    "MetricExtractionResult": {
      "additionalProperties": false,
      "description": "Metrics parsed only from one successful sandbox output JSON.",
      "properties": {
        "creates_real_world_validation": {
          "const": false,
          "default": false,
          "title": "Creates Real World Validation",
          "type": "boolean"
        },
        "creates_scientific_validation": {
          "const": false,
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "execution_id": {
          "minLength": 1,
          "title": "Execution Id",
          "type": "string"
        },
        "extraction_warnings": {
          "items": {
            "type": "string"
          },
          "title": "Extraction Warnings",
          "type": "array"
        },
        "invalid_metrics": {
          "items": {
            "type": "string"
          },
          "title": "Invalid Metrics",
          "type": "array"
        },
        "is_verification_evidence": {
          "const": false,
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "metric_sources": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Metric Sources",
          "type": "object"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "metrics_extracted": {
          "title": "Metrics Extracted",
          "type": "boolean"
        },
        "missing_metrics": {
          "items": {
            "type": "string"
          },
          "title": "Missing Metrics",
          "type": "array"
        },
        "publication_ready": {
          "const": false,
          "default": false,
          "title": "Publication Ready",
          "type": "boolean"
        },
        "schema_valid": {
          "title": "Schema Valid",
          "type": "boolean"
        }
      },
      "required": [
        "execution_id",
        "metrics_extracted",
        "schema_valid"
      ],
      "title": "MetricExtractionResult",
      "type": "object"
    },
    "SandboxExecutionConfig": {
      "additionalProperties": false,
      "description": "Local isolated-process policy for one audited generated script.",
      "properties": {
        "allowed_dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Dependencies",
          "type": "array"
        },
        "entrypoint": {
          "minLength": 1,
          "title": "Entrypoint",
          "type": "string"
        },
        "execution_backend": {
          "const": "uv_local",
          "default": "uv_local",
          "title": "Execution Backend",
          "type": "string"
        },
        "memory_limit_mb": {
          "maximum": 4096,
          "minimum": 64,
          "title": "Memory Limit Mb",
          "type": "integer"
        },
        "network_disabled": {
          "const": true,
          "default": true,
          "title": "Network Disabled",
          "type": "boolean"
        },
        "output_json_filename": {
          "minLength": 1,
          "title": "Output Json Filename",
          "type": "string"
        },
        "output_limit_bytes": {
          "default": 1048576,
          "minimum": 1024,
          "title": "Output Limit Bytes",
          "type": "integer"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "timeout_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "entrypoint",
        "output_json_filename",
        "timeout_seconds",
        "memory_limit_mb",
        "seed"
      ],
      "title": "SandboxExecutionConfig",
      "type": "object"
    },
    "SandboxExecutionResult": {
      "additionalProperties": false,
      "description": "Observed process outcome for one generated script.",
      "properties": {
        "artifact_paths": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Paths",
          "type": "array"
        },
        "code_artifact_id": {
          "minLength": 1,
          "title": "Code Artifact Id",
          "type": "string"
        },
        "creates_real_world_validation": {
          "const": false,
          "default": false,
          "title": "Creates Real World Validation",
          "type": "boolean"
        },
        "creates_scientific_validation": {
          "const": false,
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "execution_id": {
          "minLength": 1,
          "title": "Execution Id",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "failure_reason_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Reason Optional"
        },
        "is_verification_evidence": {
          "const": false,
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "memory_limit_mb": {
          "minimum": 64,
          "title": "Memory Limit Mb",
          "type": "integer"
        },
        "network_disabled": {
          "const": true,
          "default": true,
          "title": "Network Disabled",
          "type": "boolean"
        },
        "output_json_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Json Path"
        },
        "publication_ready": {
          "const": false,
          "default": false,
          "title": "Publication Ready",
          "type": "boolean"
        },
        "runtime_seconds": {
          "minimum": 0.0,
          "title": "Runtime Seconds",
          "type": "number"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "timed_out",
            "blocked"
