  "$id": "https://schemas.factori.local/0.72.0/generated-experiment-inspection-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Read-only inspection of generated experiment code and execution results.",
  "properties": {
    "backend_records": {
      "items": {
        "$ref": "#/$defs/StageBackendRecord"
      },
      "title": "Backend Records",
      "type": "array"
    },
    "blocked_code_count": {
      "default": 0,
      "minimum": 0,
      "title": "Blocked Code Count",
      "type": "integer"
    },
    "code_artifact_count": {
      "default": 0,
      "minimum": 0,
      "title": "Code Artifact Count",
      "type": "integer"
    },
    "code_artifacts": {
      "items": {
        "$ref": "#/$defs/LLMExperimentCodeArtifact"
      },
      "title": "Code Artifacts",
      "type": "array"
    },
    "creates_real_world_validation": {
      "const": false,
      "default": false,
      "title": "Creates Real World Validation",
      "type": "boolean"
    },
    "creates_scientific_validation": {
      "const": false,
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "deferred_non_executable_route_count": {
      "default": 0,
      "minimum": 0,
      "title": "Deferred Non Executable Route Count",
      "type": "integer"
    },
    "executable_spec_count": {
      "default": 0,
      "minimum": 0,
      "title": "Executable Spec Count",
      "type": "integer"
    },
    "executed_code_count": {
      "default": 0,
      "minimum": 0,
      "title": "Executed Code Count",
      "type": "integer"
    },
    "failed_execution_count": {
      "default": 0,
      "minimum": 0,
      "title": "Failed Execution Count",
      "type": "integer"
    },
    "fixture_metric_count": {
      "default": 0,
      "minimum": 0,
      "title": "Fixture Metric Count",
      "type": "integer"
    },
    "generated_experiment_present": {
      "title": "Generated Experiment Present",
      "type": "boolean"
    },
    "generated_results": {
      "items": {
        "$ref": "#/$defs/GeneratedExperimentResult"
      },
      "title": "Generated Results",
      "type": "array"
    },
    "is_verification_evidence": {
      "const": false,
