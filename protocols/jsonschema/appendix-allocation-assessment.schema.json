{
  "$id": "https://schemas.factori.local/0.21.0/appendix-allocation-assessment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Appendix-allocation diagnostic assessment.",
  "properties": {
    "findings": {
      "items": {
        "type": "string"
      },
      "title": "Findings",
      "type": "array"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Score",
      "type": "number"
    },
    "technical_lemmas_in_main_body": {
      "minimum": 0,
      "title": "Technical Lemmas In Main Body",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "score",
    "passed",
    "technical_lemmas_in_main_body"
  ],
  "title": "AppendixAllocationAssessment",
  "type": "object",
  "x-factori-protocol-version": "0.21.0",
  "x-factori-source-model": "factori.schemas.AppendixAllocationAssessment",
  "x-factori-verification-evidence": false
}
