{
  "$defs": {
    "ArtifactType": {
      "description": "Artifact categories mapped to the local run directory structure.",
      "enum": [
        "candidate",
        "score",
        "report",
        "literature",
        "lean",
        "experiment",
        "log",
        "latex"
      ],
      "title": "ArtifactType",
      "type": "string"
    }
  },
  "$id": "https://schemas.factori.local/0.68.0/artifact-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Content-hashed artifact reference.",
  "properties": {
    "content_hash": {
      "title": "Content Hash",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "path": {
      "minLength": 1,
      "title": "Path",
      "type": "string"
    },
    "producing_commit_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Producing Commit Hash"
    },
    "type": {
      "$ref": "#/$defs/ArtifactType"
    }
  },
  "required": [
    "id",
    "type",
    "path",
    "content_hash"
  ],
  "title": "ArtifactRecord",
  "type": "object",
  "x-factori-protocol-version": "0.68.0",
  "x-factori-source-model": "factori.schemas.ArtifactRef",
  "x-factori-verification-evidence": false
}
