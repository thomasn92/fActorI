{
  "$defs": {
    "ExperimentGapRoutingItem": {
      "additionalProperties": false,
      "description": "One deterministic routing decision from an experiment gap to a template.",
      "properties": {
        "claim_class": {
          "minLength": 1,
          "title": "Claim Class",
          "type": "string"
        },
        "created_experiment_spec_path_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created Experiment Spec Path Optional"
        },
        "creates_scientific_validation": {
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "existing_experiment_spec_path_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Existing Experiment Spec Path Optional"
        },
        "gap_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Gap Fingerprint",
          "type": "string"
        },
        "gap_type": {
          "enum": [
            "needs_python_experiment",
            "needs_formal_proof",
            "needs_retrieval_expansion",
            "needs_claim_downgrade",
            "needs_claim_removal",
            "needs_manuscript_refresh",
            "sufficiently_supported_for_bounded_draft"
          ],
          "title": "Gap Type",
          "type": "string"
        },
        "implies_publication_readiness": {
          "default": false,
          "title": "Implies Publication Readiness",
          "type": "boolean"
        },
        "is_verification_evidence": {
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "rejection_reason_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejection Reason Optional"
        },
        "routing_decision": {
          "minLength": 1,
          "title": "Routing Decision",
          "type": "string"
        },
        "routing_status": {
          "enum": [
            "routed",
            "unrouted_no_template",
            "rejected_policy",
            "deferred_budget_exhausted",
            "deferred_requires_inputs"
          ],
          "title": "Routing Status",
          "type": "string"
        },
        "safety_notes": {
          "items": {
            "type": "string"
          },
          "title": "Safety Notes",
          "type": "array"
        },
        "selected_template_id_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Template Id Optional"
        },
        "target_claim_id": {
          "minLength": 1,
          "title": "Target Claim Id",
          "type": "string"
        },
        "target_section_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Section Optional"
        },
        "template_family_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template Family Optional"
        }
      },
      "required": [
        "item_id",
        "target_claim_id",
        "gap_fingerprint",
        "claim_class",
        "gap_type",
        "routing_decision",
        "routing_status"
      ],
      "title": "ExperimentGapRoutingItem",
      "type": "object"
    }
  },
  "$id": "https://schemas.factori.local/0.89.0/experiment-gap-routing-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Append-only non-evidence experiment-gap routing report.",
  "properties": {
    "autonomous_plan_path": {
      "minLength": 1,
      "title": "Autonomous Plan Path",
      "type": "string"
    },
    "bounded_empirical_gaps_routed": {
      "default": 0,
      "minimum": 0,
      "title": "Bounded Empirical Gaps Routed",
      "type": "integer"
    },
    "claim_evidence_map_path": {
      "minLength": 1,
      "title": "Claim Evidence Map Path",
      "type": "string"
    },
    "created_experiment_spec_count": {
      "default": 0,
      "minimum": 0,
      "title": "Created Experiment Spec Count",
      "type": "integer"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "gap_count": {
      "default": 0,
      "minimum": 0,
      "title": "Gap Count",
      "type": "integer"
    },
    "human_intervention_reason_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Human Intervention Reason Optional"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ExperimentGapRoutingItem"
      },
      "title": "Items",
      "type": "array"
    },
    "publication_ready": {
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "rejected_template_count": {
      "default": 0,
      "minimum": 0,
      "title": "Rejected Template Count",
      "type": "integer"
    },
    "requires_human_intervention": {
      "default": false,
      "title": "Requires Human Intervention",
      "type": "boolean"
    },
    "routed_gap_count": {
      "default": 0,
      "minimum": 0,
      "title": "Routed Gap Count",
      "type": "integer"
    },
    "routing_backend": {
      "default": "deterministic",
      "enum": [
        "deterministic",
        "fake",
        "openai"
      ],
      "title": "Routing Backend",
      "type": "string"
    },
    "routing_id": {
      "minLength": 1,
      "title": "Routing Id",
      "type": "string"
    },
    "routing_status": {
      "minLength": 1,
      "title": "Routing Status",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "selected_template_count": {
      "default": 0,
      "minimum": 0,
      "title": "Selected Template Count",
      "type": "integer"
    },
    "synthetic_template_specs_created": {
      "default": 0,
      "minimum": 0,
      "title": "Synthetic Template Specs Created",
      "type": "integer"
    },
    "template_registry_path": {
      "minLength": 1,
      "title": "Template Registry Path",
      "type": "string"
    },
    "unrouted_gap_count": {
      "default": 0,
      "minimum": 0,
      "title": "Unrouted Gap Count",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "routing_id",
    "routing_status",
    "claim_evidence_map_path",
    "autonomous_plan_path",
    "template_registry_path"
  ],
  "title": "ExperimentGapRoutingReport",
  "type": "object",
  "x-factori-protocol-version": "0.89.0",
  "x-factori-source-model": "factori.schemas.ExperimentGapRoutingReport",
  "x-factori-verification-evidence": false
}
