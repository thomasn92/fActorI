{
  "$id": "https://schemas.factori.local/0.81.0/nucleus-manuscript-config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded configuration for non-fake nucleus-centered manuscript synthesis.",
  "properties": {
    "backend": {
      "minLength": 1,
      "title": "Backend",
      "type": "string"
    },
    "fail_on_silent_fallback": {
      "default": true,
      "title": "Fail On Silent Fallback",
      "type": "boolean"
    },
    "max_revision_attempts": {
      "default": 1,
      "maximum": 3,
      "minimum": 1,
      "title": "Max Revision Attempts",
      "type": "integer"
    },
    "require_non_fake_backends": {
      "default": false,
      "title": "Require Non Fake Backends",
      "type": "boolean"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "backend"
  ],
  "title": "NucleusManuscriptConfig",
  "type": "object",
  "x-factori-protocol-version": "0.81.0",
  "x-factori-source-model": "factori.schemas.NucleusManuscriptConfig",
  "x-factori-verification-evidence": false
}
