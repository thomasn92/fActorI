{
  "$id": "https://schemas.factori.local/0.70.0/retrieved-source-summary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded source metadata supplied as non-evidence retrieval context.",
  "properties": {
    "abstract_or_snippet": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Abstract Or Snippet"
    },
    "authors": {
      "items": {
        "type": "string"
      },
      "title": "Authors",
      "type": "array"
    },
    "claims_literature_coverage": {
      "const": false,
      "default": false,
      "title": "Claims Literature Coverage",
      "type": "boolean"
    },
    "doi": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doi"
    },
    "fake_or_mocked": {
      "title": "Fake Or Mocked",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "const": false,
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "proves_novelty": {
      "const": false,
      "default": false,
      "title": "Proves Novelty",
      "type": "boolean"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "relevance_score": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relevance Score"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "venue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Venue"
    },
    "year": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Year"
    }
  },
  "required": [
    "source_id",
    "title",
    "provider",
    "fake_or_mocked"
  ],
  "title": "RetrievedSourceSummary",
  "type": "object",
  "x-factori-protocol-version": "0.70.0",
  "x-factori-source-model": "factori.schemas.RetrievedSourceSummary",
  "x-factori-verification-evidence": false
}
