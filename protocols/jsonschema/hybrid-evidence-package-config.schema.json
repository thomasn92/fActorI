{
  "$id": "https://schemas.factori.local/0.87.0/hybrid-evidence-package-config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded configuration for non-fake hybrid evidence-package planning.",
  "properties": {
    "adaptive_repair_decision_id_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adaptive Repair Decision Id Optional"
    },
    "backend": {
      "minLength": 1,
      "title": "Backend",
      "type": "string"
    },
    "fail_on_silent_fallback": {
      "default": true,
      "title": "Fail On Silent Fallback",
      "type": "boolean"
    },
    "max_planning_calls": {
      "default": 12,
      "minimum": 1,
      "title": "Max Planning Calls",
      "type": "integer"
    },
    "max_source_substrates": {
      "default": 12,
      "minimum": 1,
      "title": "Max Source Substrates",
      "type": "integer"
    },
    "repair_of_package_id_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repair Of Package Id Optional"
    },
    "require_non_fake_backends": {
      "default": false,
      "title": "Require Non Fake Backends",
      "type": "boolean"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "backend"
  ],
  "title": "HybridEvidencePackageConfig",
  "type": "object",
  "x-factori-protocol-version": "0.87.0",
  "x-factori-source-model": "factori.schemas.HybridEvidencePackageConfig",
  "x-factori-verification-evidence": false
}
