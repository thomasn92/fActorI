{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to an artifact stored on the local filesystem.",
      "properties": {
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "producing_commit_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producing Commit Hash"
        },
        "type": {
          "$ref": "#/$defs/ArtifactType"
        }
      },
      "required": [
        "id",
        "type",
        "path",
        "content_hash"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "description": "Artifact categories mapped to the local run directory structure.",
      "enum": [
        "candidate",
        "score",
        "report",
        "literature",
        "lean",
        "experiment",
        "log",
        "latex"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "BranchStatus": {
      "description": "Branch and run status labels for the MVP.",
      "enum": [
        "Active",
        "PrunedDuplicate",
        "RejectedRedTeam",
        "PrunedUncertain",
        "DeferredRealDataCandidate",
        "RequiresRealData",
        "InsufficientRetrievalAdequacy",
        "StagnationStop",
        "StopFailure",
        "StopSuccess",
        "NeedsHumanTailEscalation",
        "FalseBridge",
        "TrivialTheoremCandidate",
        "StageCReady",
        "BudgetDeferred"
      ],
      "title": "BranchStatus",
      "type": "string"
    },
    "BudgetSelectionReport": {
      "additionalProperties": false,
      "description": "Deterministic budget selector output.",
      "properties": {
        "budget_deferred_candidate_ids": {
          "items": {
            "type": "string"
          },
          "title": "Budget Deferred Candidate Ids",
          "type": "array"
        },
        "cost_aware_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Cost Aware Scores",
          "type": "object"
        },
        "max_stage_c_candidates": {
          "minimum": 0,
          "title": "Max Stage C Candidates",
          "type": "integer"
        },
        "selected_candidate_ids": {
          "items": {
            "type": "string"
          },
          "title": "Selected Candidate Ids",
          "type": "array"
        }
      },
      "required": [
        "max_stage_c_candidates",
        "selected_candidate_ids",
        "budget_deferred_candidate_ids",
        "cost_aware_scores"
      ],
      "title": "BudgetSelectionReport",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "description": "Minimal candidate branch representation.",
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "baseline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline"
        },
        "constraints": {
          "$ref": "#/$defs/ConstraintSet"
        },
        "data_requirement": {
          "$ref": "#/$defs/DataRequirement",
          "default": "NoData"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "experiment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experiment"
        },
        "hypothesis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hypothesis"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "literature": {
          "$ref": "#/$defs/LiteratureState"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "parent_candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Candidate Id"
        },
        "primitives": {
          "items": {
            "type": "string"
          },
          "title": "Primitives",
          "type": "array"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "reviews": {
          "items": {
            "$ref": "#/$defs/ReviewReport"
          },
          "title": "Reviews",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/BranchStatus",
          "default": "Active"
        },
        "symbolic_state": {
          "additionalProperties": true,
          "title": "Symbolic State",
          "type": "object"
        },
        "theory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Theory"
        },
        "variant_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant Type"
        },
        "verification": {
          "$ref": "#/$defs/VerificationState"
        }
      },
      "required": [
        "id",
        "question"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "ConstraintSet": {
      "additionalProperties": false,
      "description": "User constraints over the candidate search space.",
      "properties": {
        "baseline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline"
        },
        "data_requirement": {
          "$ref": "#/$defs/DataRequirement",
          "default": "NoData"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "experiment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experiment"
        },
        "hypothesis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hypothesis"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "primitives": {
          "items": {
            "type": "string"
          },
          "title": "Primitives",
          "type": "array"
        },
        "question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question"
        },
        "theory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Theory"
        }
      },
      "title": "ConstraintSet",
      "type": "object"
    },
    "DataRequirement": {
      "description": "Data access regimes from the MVP data gate.",
      "enum": [
        "NoData",
        "SyntheticOnly",
        "PublicDownload",
        "UserProvided"
      ],
      "title": "DataRequirement",
      "type": "string"
    },
    "LiteratureState": {
      "additionalProperties": false,
      "description": "Retrieval adequacy state for a candidate.",
      "properties": {
        "adversarial": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Adversarial",
          "type": "number"
        },
        "citation": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Citation",
          "type": "number"
        },
        "closest_priors": {
          "items": {
            "type": "string"
          },
          "title": "Closest Priors",
          "type": "array"
        },
        "diversity": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Diversity",
          "type": "number"
        },
        "k": {
          "default": 0,
          "minimum": 0,
          "title": "K",
          "type": "integer"
        },
        "keyword": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Keyword",
          "type": "number"
        },
        "novelty_risk": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Novelty Risk",
          "type": "number"
        },
        "semantic": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Semantic",
          "type": "number"
        }
      },
      "title": "LiteratureState",
      "type": "object"
    },
    "NoveltyAttackResult": {
      "additionalProperties": false,
      "description": "Deterministic novelty attack result for Stage C selection.",
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "near_duplicate_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Near Duplicate Reason"
        },
        "novelty_risk": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Novelty Risk",
          "type": "number"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "rt_novelty": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Rt Novelty",
          "type": "number"
        }
      },
      "required": [
        "candidate_id",
        "rt_novelty",
        "novelty_risk",
        "passed"
      ],
      "title": "NoveltyAttackResult",
      "type": "object"
    },
    "RetrievalAdequacyCertificate": {
      "additionalProperties": false,
      "description": "Skeleton retrieval adequacy certificate.",
      "properties": {
        "adversarial": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Adversarial",
          "type": "number"
        },
        "bounded_signal": {
          "default": true,
          "title": "Bounded Signal",
          "type": "boolean"
        },
        "citation": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Citation",
          "type": "number"
        },
        "claims_literature_coverage": {
          "default": false,
          "title": "Claims Literature Coverage",
          "type": "boolean"
        },
        "diversity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Diversity",
          "type": "number"
        },
        "fake": {
          "default": true,
          "title": "Fake",
          "type": "boolean"
        },
        "keyword": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Keyword",
          "type": "number"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "proves_novelty": {
          "default": false,
          "title": "Proves Novelty",
          "type": "boolean"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "rho_adequacy": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Rho Adequacy",
          "type": "number"
        },
        "semantic": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Semantic",
          "type": "number"
        },
        "source_count": {
          "default": 0,
          "minimum": 0,
          "title": "Source Count",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/BranchStatus"
        },
        "tau_adequacy": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Tau Adequacy",
          "type": "number"
        },
        "weights": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Weights",
          "type": "object"
        }
      },
      "required": [
        "semantic",
        "keyword",
        "citation",
        "diversity",
        "adversarial",
        "weights",
        "rho_adequacy",
        "tau_adequacy",
        "passed",
        "status"
      ],
      "title": "RetrievalAdequacyCertificate",
      "type": "object"
    },
    "ReviewReport": {
      "additionalProperties": false,
      "description": "Structured reviewer critique.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "objections": {
          "items": {
            "type": "string"
          },
          "title": "Objections",
          "type": "array"
        },
        "recommendation": {
          "anyOf": [
            {
              "$ref": "#/$defs/BranchStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reviewer": {
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        },
        "scores": {
          "$ref": "#/$defs/ScoreVector"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "reviewer",
        "summary",
        "scores"
      ],
      "title": "ReviewReport",
      "type": "object"
    },
    "ScoreVector": {
      "additionalProperties": false,
      "description": "Continuous candidate scores in [0, 1].",
      "properties": {
        "difficulty": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Difficulty",
          "type": "number"
        },
        "diversity": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Diversity",
          "type": "number"
        },
        "feasibility": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Feasibility",
          "type": "number"
        },
        "novelty": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Novelty",
          "type": "number"
        },
        "reviewer": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Reviewer",
          "type": "number"
        },
        "uncertainty": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Uncertainty",
          "type": "number"
        },
        "verifiability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Verifiability",
          "type": "number"
        }
      },
      "required": [
        "novelty",
        "feasibility",
        "verifiability"
      ],
      "title": "ScoreVector",
      "type": "object"
    },
    "StageCRedTeamSelectionReport": {
      "additionalProperties": false,
      "description": "Aggregated pre-Stage-C red-team report.",
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "novelty": {
          "$ref": "#/$defs/NoveltyAttackResult"
        },
        "redteam_passed": {
          "title": "Redteam Passed",
          "type": "boolean"
        },
        "retrieval_certificate": {
          "$ref": "#/$defs/RetrievalAdequacyCertificate"
        },
        "rt_baseline": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Rt Baseline",
          "type": "number"
        },
        "rt_bridge": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Rt Bridge",
          "type": "number"
        },
        "rt_retrieval": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Rt Retrieval",
          "type": "number"
        },
        "rt_threshold": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Rt Threshold",
          "type": "number"
        },
        "rt_total": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Rt Total",
          "type": "number"
        },
        "rt_triviality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Rt Triviality",
          "type": "number"
        },
        "stage_c_ready": {
          "title": "Stage C Ready",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/BranchStatus"
        }
      },
      "required": [
        "candidate_id",
        "novelty",
        "rt_bridge",
        "rt_baseline",
        "rt_triviality",
        "rt_retrieval",
        "rt_total",
        "rt_threshold",
        "retrieval_certificate",
        "redteam_passed",
        "stage_c_ready",
        "status"
      ],
      "title": "StageCRedTeamSelectionReport",
      "type": "object"
    },
    "UncertaintyEstimate": {
      "additionalProperties": false,
      "description": "Deterministic score uncertainty estimate.",
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "components": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Components",
          "type": "object"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "s_hat": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "S Hat",
          "type": "number"
        },
        "s_lower": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "S Lower",
          "type": "number"
        },
        "tau_s": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Tau S",
          "type": "number"
        },
        "u_s": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "U S",
          "type": "number"
        }
      },
      "required": [
        "candidate_id",
        "s_hat",
        "u_s",
        "s_lower",
        "tau_s",
        "passed",
        "components"
      ],
      "title": "UncertaintyEstimate",
      "type": "object"
    },
    "VerificationLabel": {
      "description": "Verification and epistemic labels required by the specification.",
      "enum": [
        "LeanVerified",
        "ExperimentVerified",
        "SyntheticExperimentVerified",
        "RealDataExperimentVerified",
        "Conjecture",
        "NegativeResult",
        "Limitation",
        "Unsupported"
      ],
      "title": "VerificationLabel",
      "type": "string"
    },
    "VerificationState": {
      "additionalProperties": false,
      "description": "Current verification labels and evidence artifacts.",
      "properties": {
        "evidence_artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Evidence Artifacts",
          "type": "array"
        },
        "labels": {
          "items": {
            "$ref": "#/$defs/VerificationLabel"
          },
          "title": "Labels",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "VerificationState",
      "type": "object"
    }
  },
  "$id": "https://schemas.factori.local/0.3.0/stage-c-selection-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Typed Stage C candidate-selection result.",
  "properties": {
    "artifacts": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "type": "array"
      },
      "title": "Artifacts",
      "type": "object"
    },
    "budget_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "budget_deferred": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Budget Deferred",
      "type": "array"
    },
    "budget_report": {
      "$ref": "#/$defs/BudgetSelectionReport"
    },
    "deferred_data": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Deferred Data",
      "type": "array"
    },
    "insufficient_retrieval": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Insufficient Retrieval",
      "type": "array"
    },
    "pruned_uncertain": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Pruned Uncertain",
      "type": "array"
    },
    "redteam_reports": {
      "additionalProperties": {
        "$ref": "#/$defs/StageCRedTeamSelectionReport"
      },
      "title": "Redteam Reports",
      "type": "object"
    },
    "rejected_redteam": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Rejected Redteam",
      "type": "array"
    },
    "report_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "report_commit_hash": {
      "title": "Report Commit Hash",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scores": {
      "additionalProperties": {
        "$ref": "#/$defs/ScoreVector"
      },
      "title": "Scores",
      "type": "object"
    },
    "selected_candidates": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Selected Candidates",
      "type": "array"
    },
    "stage_b_survivors": {
      "items": {
        "$ref": "#/$defs/Candidate"
