{
  "$defs": {
    "BackendKind": {
      "description": "Authority classification for scientific and infrastructure backends.",
      "enum": [
        "fake",
        "fixture",
        "deterministic_template",
        "curated_catalog",
        "heuristic",
        "llm_openai",
        "llm_other",
        "retrieval_real",
        "local_execution",
        "symbolic_checker",
        "human"
      ],
      "title": "BackendKind",
      "type": "string"
    },
    "CompatibilityExclusion": {
      "additionalProperties": false,
      "description": "Deterministic negative compatibility finding without opportunity authority.",
      "properties": {
        "decorative_vocabulary_risk": {
          "title": "Decorative Vocabulary Risk",
          "type": "boolean"
        },
        "excluded": {
          "title": "Excluded",
          "type": "boolean"
        },
        "exclusion_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Exclusion Reasons",
          "type": "array"
        },
        "missing_baseline": {
          "title": "Missing Baseline",
          "type": "boolean"
        },
        "missing_data_or_simulation_path": {
          "title": "Missing Data Or Simulation Path",
          "type": "boolean"
        },
        "missing_object_mapping": {
          "title": "Missing Object Mapping",
          "type": "boolean"
        },
        "missing_verification_path": {
          "title": "Missing Verification Path",
          "type": "boolean"
        },
        "pair_id": {
          "minLength": 1,
          "title": "Pair Id",
          "type": "string"
        }
      },
      "required": [
        "pair_id",
        "excluded",
        "missing_object_mapping",
        "missing_baseline",
        "missing_verification_path",
        "missing_data_or_simulation_path",
        "decorative_vocabulary_risk"
      ],
      "title": "CompatibilityExclusion",
      "type": "object"
    },
    "DomainMethodPair": {
      "additionalProperties": false,
      "description": "One domain-method pair after exclusion-only compatibility analysis.",
      "properties": {
        "baseline_candidates": {
          "items": {
            "type": "string"
          },
          "title": "Baseline Candidates",
          "type": "array"
        },
        "compatibility_status": {
          "enum": [
            "compatible",
            "weak_compatible",
            "excluded"
          ],
          "title": "Compatibility Status",
          "type": "string"
        },
        "data_or_simulation_candidates": {
          "items": {
            "type": "string"
          },
          "title": "Data Or Simulation Candidates",
          "type": "array"
        },
        "domain_family": {
          "minLength": 1,
          "title": "Domain Family",
          "type": "string"
        },
        "domain_id": {
          "minLength": 1,
          "title": "Domain Id",
          "type": "string"
        },
        "method_family": {
          "minLength": 1,
          "title": "Method Family",
          "type": "string"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "object_mapping_candidates": {
          "items": {
            "type": "string"
          },
          "title": "Object Mapping Candidates",
          "type": "array"
        },
        "pair_id": {
          "minLength": 1,
          "title": "Pair Id",
          "type": "string"
        },
        "verification_path_candidates": {
          "items": {
            "type": "string"
          },
          "title": "Verification Path Candidates",
          "type": "array"
        }
      },
      "required": [
        "pair_id",
        "domain_id",
        "method_id",
        "domain_family",
        "method_family",
        "compatibility_status"
      ],
      "title": "DomainMethodPair",
      "type": "object"
    },
    "ScientificStageKind": {
      "description": "Scientific-generation, judgment, execution, and validation stage classes.",
      "enum": [
        "opportunity_discovery",
        "atlas_construction",
        "compatibility_filter",
        "pair_ranking",
        "diversity_selection",
        "idea_tree_construction",
        "variance_generation",
        "substrate_construction",
        "substrate_selection",
        "branch_routing",
        "experiment_design",
        "spec_validation",
        "experiment_code_generation",
        "code_safety_audit",
        "experiment_execution",
        "metric_computation",
        "hybrid_evidence_planning",
        "symbolic_derivation",
        "adjudication",
        "adjudication_score_aggregation",
        "critic_review",
        "literature_retrieval",
        "novelty_assessment",
        "manuscript_planning",
        "manuscript_synthesis",
        "manuscript_artifact_assembly",
        "claim_audit",
        "bundle_verification"
      ],
      "title": "ScientificStageKind",
      "type": "string"
    },
    "StageBackendRecord": {
      "additionalProperties": false,
      "description": "Explicit authority classification for one pipeline stage backend.",
      "properties": {
        "allowed_in_production": {
          "title": "Allowed In Production",
          "type": "boolean"
        },
        "artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "backend_kind": {
          "$ref": "#/$defs/BackendKind"
        },
        "backend_name": {
          "minLength": 1,
          "title": "Backend Name",
          "type": "string"
        },
        "fallback_disclosed": {
          "default": true,
          "title": "Fallback Disclosed",
          "type": "boolean"
        },
        "fallback_used": {
          "default": false,
          "title": "Fallback Used",
          "type": "boolean"
        },
        "is_execution_or_verification": {
          "title": "Is Execution Or Verification",
          "type": "boolean"
        },
        "is_scientific_generation": {
          "title": "Is Scientific Generation",
          "type": "boolean"
        },
        "is_scientific_judgment": {
          "title": "Is Scientific Judgment",
          "type": "boolean"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "stage_id": {
          "minLength": 1,
          "title": "Stage Id",
          "type": "string"
        },
        "stage_kind": {
          "$ref": "#/$defs/ScientificStageKind"
        }
      },
      "required": [
        "stage_id",
        "stage_kind",
        "backend_kind",
        "backend_name",
        "is_scientific_generation",
        "is_scientific_judgment",
        "is_execution_or_verification",
        "allowed_in_production",
        "reason"
      ],
      "title": "StageBackendRecord",
      "type": "object"
    }
  },
  "$id": "https://schemas.factori.local/0.87.0/compatibility-filter-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Complete exclusion-only compatibility report over an atlas product.",
  "properties": {
    "backend_records": {
      "items": {
        "$ref": "#/$defs/StageBackendRecord"
      },
      "title": "Backend Records",
      "type": "array"
    },
    "compatibility_status_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Compatibility Status Counts",
      "type": "object"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "excluded_pair_count": {
      "minimum": 0,
      "title": "Excluded Pair Count",
      "type": "integer"
    },
    "exclusions": {
      "items": {
        "$ref": "#/$defs/CompatibilityExclusion"
      },
      "title": "Exclusions",
      "type": "array"
    },
    "filter_id": {
      "minLength": 1,
      "title": "Filter Id",
      "type": "string"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "pairs": {
      "items": {
        "$ref": "#/$defs/DomainMethodPair"
      },
      "title": "Pairs",
      "type": "array"
    },
    "publication_ready": {
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "raw_pair_count": {
      "minimum": 0,
      "title": "Raw Pair Count",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "source_atlas_path": {
      "minLength": 1,
      "title": "Source Atlas Path",
      "type": "string"
    },
    "surviving_pair_count": {
      "minimum": 0,
      "title": "Surviving Pair Count",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "filter_id",
    "source_atlas_path",
    "raw_pair_count",
    "excluded_pair_count",
    "surviving_pair_count"
  ],
  "title": "CompatibilityFilterReport",
  "type": "object",
  "x-factori-protocol-version": "0.87.0",
  "x-factori-source-model": "factori.schemas.CompatibilityFilterReport",
  "x-factori-verification-evidence": false
}
