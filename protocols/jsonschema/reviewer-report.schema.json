{
  "$defs": {
    "ReviewerRecommendation": {
      "description": "Deterministic fake reviewer recommendation labels.",
      "enum": [
        "Accept",
        "WeakAccept",
        "Revise",
        "WeakReject",
        "Reject"
      ],
      "title": "ReviewerRecommendation",
      "type": "string"
    }
  },
  "$id": "https://schemas.factori.local/0.83.0/reviewer-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Stage B structural review without verification authority.",
  "properties": {
    "candidate_id": {
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "clarity_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Clarity Score",
      "type": "number"
    },
    "fake": {
      "default": true,
      "title": "Fake",
      "type": "boolean"
    },
    "feasibility_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Feasibility Score",
      "type": "number"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "novelty_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Novelty Score",
      "type": "number"
    },
    "objections": {
      "items": {
        "type": "string"
      },
      "title": "Objections",
      "type": "array"
    },
    "recommendation": {
      "$ref": "#/$defs/ReviewerRecommendation"
    },
    "reviewer_id": {
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "scientific_approval": {
      "default": false,
      "title": "Scientific Approval",
      "type": "boolean"
    },
    "significance_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Significance Score",
      "type": "number"
    },
    "verifiability_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Verifiability Score",
      "type": "number"
    }
  },
  "required": [
    "reviewer_id",
    "candidate_id",
    "novelty_score",
    "feasibility_score",
    "verifiability_score",
    "clarity_score",
    "significance_score",
    "recommendation"
  ],
  "title": "ReviewerReport",
  "type": "object",
  "x-factori-protocol-version": "0.83.0",
  "x-factori-source-model": "factori.schemas.StageBReviewerReport",
  "x-factori-verification-evidence": false
}
