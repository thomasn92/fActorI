{
  "$defs": {
    "KernelArtifactVerifyResult": {
      "additionalProperties": false,
      "description": "Result returned by artifact integrity verification.",
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "producing_commit_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producing Commit Hash"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "valid": {
          "const": true,
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "valid",
        "run_id",
        "artifact_id",
        "content_hash"
      ],
      "title": "KernelArtifactVerifyResult",
      "type": "object"
    },
    "KernelCanonicalJsonResult": {
      "additionalProperties": false,
      "description": "Result returned by canonical JSON hashing.",
      "properties": {
        "canonical_json": {
          "title": "Canonical Json",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "canonical_json",
        "sha256"
      ],
      "title": "KernelCanonicalJsonResult",
      "type": "object"
    },
    "KernelCheckpointVerifyResult": {
      "additionalProperties": false,
      "description": "Non-authoritative autonomous checkpoint integrity and resume result.",
      "properties": {
        "authority_granted": {
          "const": false,
          "title": "Authority Granted",
          "type": "boolean"
        },
        "checkpoint_chain_valid": {
          "const": true,
          "title": "Checkpoint Chain Valid",
          "type": "boolean"
        },
        "checkpoint_count": {
          "minimum": 1,
          "title": "Checkpoint Count",
          "type": "integer"
        },
        "checkpoint_index_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Checkpoint Index Artifact Id",
          "type": "string"
        },
        "checkpoint_index_producing_commit_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checkpoint Index Producing Commit Hash",
          "type": "string"
        },
        "latest_checkpoint_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Latest Checkpoint Hash",
          "type": "string"
        },
        "latest_completed_stage": {
          "minLength": 1,
          "title": "Latest Completed Stage",
          "type": "string"
        },
        "resume_allowed": {
          "title": "Resume Allowed",
          "type": "boolean"
        },
        "run_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "validated_checkpoint_hashes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Validated Checkpoint Hashes",
          "type": "array"
        },
        "validated_output_count": {
          "minimum": 0,
          "title": "Validated Output Count",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "checkpoint_index_artifact_id",
        "checkpoint_index_producing_commit_hash",
        "checkpoint_count",
        "validated_checkpoint_hashes",
        "latest_checkpoint_hash",
        "latest_completed_stage",
        "validated_output_count",
        "checkpoint_chain_valid",
        "resume_allowed",
        "authority_granted"
      ],
      "title": "KernelCheckpointVerifyResult",
      "type": "object"
    },
    "KernelClaimResolveResult": {
      "additionalProperties": false,
      "description": "Non-authoritative claim admissibility result.",
      "properties": {
        "admissible": {
          "title": "Admissible",
          "type": "boolean"
        },
        "allowed_in_main_text": {
          "title": "Allowed In Main Text",
          "type": "boolean"
        },
        "allowed_section": {
          "minLength": 1,
          "title": "Allowed Section",
          "type": "string"
        },
        "authority_granted": {
          "const": false,
          "title": "Authority Granted",
          "type": "boolean"
        },
        "candidate_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "claim_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_label": {
          "$ref": "#/$defs/VerificationLabel"
        },
        "claim_record_validated": {
          "const": true,
          "title": "Claim Record Validated",
          "type": "boolean"
        },
        "claim_text_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Claim Text Hash",
          "type": "string"
        },
        "evidence_bundle_validated": {
          "title": "Evidence Bundle Validated",
          "type": "boolean"
        },
        "run_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "candidate_id",
        "claim_id",
        "claim_text_hash",
        "claim_label",
        "allowed_in_main_text",
        "allowed_section",
        "claim_record_validated",
        "admissible",
        "evidence_bundle_validated",
        "authority_granted"
      ],
      "title": "KernelClaimResolveResult",
      "type": "object"
    },
    "KernelDiagnostic": {
      "additionalProperties": false,
      "description": "Bounded stable diagnostic returned by a kernel operation.",
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "KernelDiagnostic",
      "type": "object"
    },
    "KernelEmptyResult": {
      "additionalProperties": false,
      "description": "Empty result used by rejected kernel operations.",
      "properties": {},
      "title": "KernelEmptyResult",
      "type": "object"
    },
    "KernelEvidenceAuthorityClass": {
      "description": "Non-authoritative classification returned by evidence.classify.",
      "enum": [
        "Context",
        "Presentation",
        "CapabilityCandidate"
      ],
      "title": "KernelEvidenceAuthorityClass",
      "type": "string"
    },
    "KernelEvidenceCandidateKind": {
      "description": "Candidate family eligible for later strict evidence validation.",
      "enum": [
        "LeanProof",
        "SyntheticExperiment"
      ],
      "title": "KernelEvidenceCandidateKind",
      "type": "string"
    },
    "KernelEvidenceClassifyResult": {
      "additionalProperties": false,
      "description": "Classification result that cannot grant evidence authority.",
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "authority_class": {
          "$ref": "#/$defs/KernelEvidenceAuthorityClass"
        },
        "authority_granted": {
          "const": false,
          "title": "Authority Granted",
          "type": "boolean"
        },
        "candidate_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/KernelEvidenceCandidateKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "compatibility_only": {
          "title": "Compatibility Only",
          "type": "boolean"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "artifact_id",
        "authority_class",
        "compatibility_only",
        "authority_granted"
      ],
      "title": "KernelEvidenceClassifyResult",
      "type": "object"
    },
    "KernelEvidenceValidateBundleResult": {
      "additionalProperties": false,
      "description": "Non-authoritative result of strict persisted bundle validation.",
      "properties": {
        "authority_granted": {
          "const": false,
          "title": "Authority Granted",
          "type": "boolean"
        },
        "bundle_kind": {
          "enum": [
            "LeanProof",
            "SyntheticExperiment"
          ],
          "title": "Bundle Kind",
          "type": "string"
        },
        "bundle_valid": {
          "const": true,
          "title": "Bundle Valid",
          "type": "boolean"
        },
        "candidate_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "claim_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Claim Id",
          "type": "string"
        },
        "producing_commit_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Producing Commit Hash",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "validated_artifact_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Validated Artifact Ids",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "candidate_id",
        "claim_id",
        "bundle_kind",
        "producing_commit_hash",
        "validated_artifact_ids",
        "bundle_valid",
        "authority_granted"
      ],
      "title": "KernelEvidenceValidateBundleResult",
      "type": "object"
    },
    "KernelLedgerVerifyResult": {
      "additionalProperties": false,
      "description": "Result returned by ledger verification.",
      "properties": {
        "commit_count": {
          "minimum": 0,
          "title": "Commit Count",
          "type": "integer"
        },
        "root_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Root Hash"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "tip_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tip Hash"
        },
        "valid": {
          "const": true,
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "valid",
        "run_id",
        "commit_count"
      ],
      "title": "KernelLedgerVerifyResult",
      "type": "object"
    },
    "KernelMode": {
      "description": "Compatibility mode requested for one read-only kernel operation.",
      "enum": [
        "DevelopmentCompatibility",
        "StrictProduction"
      ],
      "title": "KernelMode",
      "type": "string"
    },
    "KernelOperation": {
      "description": "Read-only operations exposed by the initial kernel boundary.",
      "enum": [
        "protocol.validate",
        "hash.canonical_json",
        "artifact.verify",
        "ledger.verify",
        "evidence.classify",
        "evidence.validate_bundle",
        "claim.resolve",
        "checkpoint.verify",
        "replay.verify_core"
      ],
      "title": "KernelOperation",
      "type": "string"
    },
    "KernelProtocolValidateResult": {
      "additionalProperties": false,
      "description": "Result returned by protocol validation.",
      "properties": {
        "protocol_name": {
          "enum": [
            "KernelRequestEnvelope",
            "KernelResponseEnvelope"
          ],
          "title": "Protocol Name",
          "type": "string"
        },
        "valid": {
          "const": true,
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "valid",
        "protocol_name"
      ],
      "title": "KernelProtocolValidateResult",
      "type": "object"
    },
    "KernelReplayVerifyCoreResult": {
      "additionalProperties": false,
      "description": "Non-authoritative persisted replay-core integrity result.",
      "properties": {
        "authority_boundary_valid": {
          "const": true,
          "title": "Authority Boundary Valid",
          "type": "boolean"
        },
        "authority_granted": {
          "const": false,
          "title": "Authority Granted",
          "type": "boolean"
        },
        "claim_evidence_links_checked": {
          "minimum": 0,
          "title": "Claim Evidence Links Checked",
          "type": "integer"
        },
        "claims_checked": {
          "minimum": 0,
          "title": "Claims Checked",
          "type": "integer"
        },
        "core_replay_valid": {
          "const": true,
          "title": "Core Replay Valid",
          "type": "boolean"
        },
        "ledger_artifact_count": {
          "minimum": 0,
          "title": "Ledger Artifact Count",
          "type": "integer"
        },
        "ledger_artifact_inventory_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ledger Artifact Inventory Hash",
          "type": "string"
        },
        "ledger_commit_count": {
          "minimum": 1,
          "title": "Ledger Commit Count",
          "type": "integer"
        },
        "ledger_snapshot_stable": {
          "const": true,
          "title": "Ledger Snapshot Stable",
          "type": "boolean"
        },
        "ledger_tip_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ledger Tip Hash",
          "type": "string"
        },
        "manifest_artifact_id": {
          "const": "artifact-manifest",
          "title": "Manifest Artifact Id",
          "type": "string"
        },
        "manifest_entry_count": {
          "minimum": 1,
          "title": "Manifest Entry Count",
          "type": "integer"
        },
        "manifest_inventory_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Inventory Hash",
          "type": "string"
        },
        "manifest_producing_commit_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Producing Commit Hash",
          "type": "string"
        },
        "required_outputs_checked": {
          "const": 11,
          "title": "Required Outputs Checked",
          "type": "integer"
        },
        "run_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "ledger_tip_hash",
        "ledger_commit_count",
        "ledger_artifact_count",
        "ledger_artifact_inventory_hash",
        "required_outputs_checked",
        "manifest_artifact_id",
        "manifest_producing_commit_hash",
        "manifest_entry_count",
        "manifest_inventory_hash",
        "claims_checked",
        "claim_evidence_links_checked",
        "core_replay_valid",
        "ledger_snapshot_stable",
        "authority_boundary_valid",
        "authority_granted"
      ],
      "title": "KernelReplayVerifyCoreResult",
      "type": "object"
    },
    "KernelResponseStatus": {
      "description": "Transport-level result status; this is not scientific evidence.",
      "enum": [
        "accepted",
        "rejected",
        "error"
      ],
      "title": "KernelResponseStatus",
      "type": "string"
    },
    "VerificationLabel": {
      "description": "Verification and epistemic labels required by the specification.",
      "enum": [
        "LeanVerified",
        "ExperimentVerified",
        "SyntheticExperimentVerified",
        "RealDataExperimentVerified",
        "Conjecture",
        "NegativeResult",
        "Limitation",
        "Unsupported"
      ],
      "title": "VerificationLabel",
      "type": "string"
    }
  },
  "$id": "https://schemas.factori.local/0.86.0/kernel-response-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned response envelope for the read-only research kernel boundary.",
  "properties": {
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/KernelDiagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "kernel_version": {
      "minLength": 1,
      "title": "Kernel Version",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/KernelMode"
    },
    "mutation_performed": {
      "title": "Mutation Performed",
      "type": "boolean"
    },
    "operation": {
      "$ref": "#/$defs/KernelOperation"
    },
    "protocol_version": {
      "minLength": 1,
      "title": "Protocol Version",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/KernelEmptyResult"
        },
        {
          "$ref": "#/$defs/KernelCanonicalJsonResult"
        },
        {
          "$ref": "#/$defs/KernelProtocolValidateResult"
        },
        {
          "$ref": "#/$defs/KernelArtifactVerifyResult"
        },
        {
          "$ref": "#/$defs/KernelLedgerVerifyResult"
        },
        {
          "$ref": "#/$defs/KernelEvidenceClassifyResult"
        },
        {
          "$ref": "#/$defs/KernelEvidenceValidateBundleResult"
        },
        {
          "$ref": "#/$defs/KernelClaimResolveResult"
        },
        {
          "$ref": "#/$defs/KernelCheckpointVerifyResult"
        },
        {
          "$ref": "#/$defs/KernelReplayVerifyCoreResult"
        }
      ],
      "title": "Result"
    },
    "status": {
      "$ref": "#/$defs/KernelResponseStatus"
    }
  },
  "required": [
    "protocol_version",
    "kernel_version",
    "request_id",
    "operation",
    "mode",
    "status",
    "result",
    "diagnostics",
    "mutation_performed"
  ],
  "title": "KernelResponseEnvelope",
  "type": "object",
  "x-factori-protocol-version": "0.86.0",
  "x-factori-source-model": "factori.schemas.KernelResponseEnvelope",
  "x-factori-verification-evidence": false
}
