{
  "$defs": {
    "ScientificCriticRole": {
      "description": "Independent scientific-criticism perspectives for hybrid evidence packages.",
      "enum": [
        "baseline_adversary",
        "tautology_adversary",
        "dgp_rigging_adversary",
        "false_bridge_adversary",
        "claim_scope_adversary",
        "novelty_risk_adversary",
        "paper_coherence_reviewer",
        "technical_soundness_reviewer"
      ],
      "title": "ScientificCriticRole",
      "type": "string"
    }
  },
  "$id": "https://schemas.factori.local/0.79.0/scientific-critic-raw-artifact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Secret-free raw prompt/response provenance for critic or adjudication calls.",
  "properties": {
    "accepted_id_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accepted Id Optional"
    },
    "backend_name": {
      "minLength": 1,
      "title": "Backend Name",
      "type": "string"
    },
    "creates_scientific_validation": {
      "const": false,
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "critic_role_optional": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScientificCriticRole"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fallback_used": {
      "default": false,
      "title": "Fallback Used",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "const": false,
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "operation": {
      "enum": [
        "critic_review",
        "cross_package_adjudication"
      ],
      "title": "Operation",
      "type": "string"
    },
    "package_id_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Package Id Optional"
    },
    "prompt_text": {
      "minLength": 1,
      "title": "Prompt Text",
      "type": "string"
    },
    "publication_ready": {
      "const": false,
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "raw_artifact_id": {
      "minLength": 1,
      "title": "Raw Artifact Id",
      "type": "string"
    },
    "raw_response": {
      "additionalProperties": true,
      "title": "Raw Response",
      "type": "object"
    },
    "rejection_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Rejection Reasons",
      "type": "array"
    },
    "requested_output_schema": {
      "additionalProperties": true,
      "title": "Requested Output Schema",
      "type": "object"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "raw_artifact_id",
    "run_id",
    "operation",
    "backend_name",
    "model",
    "prompt_text",
    "requested_output_schema",
    "raw_response"
  ],
  "title": "ScientificCriticRawArtifact",
  "type": "object",
  "x-factori-protocol-version": "0.79.0",
  "x-factori-source-model": "factori.schemas.ScientificCriticRawArtifact",
  "x-factori-verification-evidence": false
}
