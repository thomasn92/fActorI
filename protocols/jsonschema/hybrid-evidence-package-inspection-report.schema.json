{
  "$defs": {
    "BackendKind": {
      "description": "Authority classification for scientific and infrastructure backends.",
      "enum": [
        "fake",
        "fixture",
        "deterministic_template",
        "curated_catalog",
        "heuristic",
        "llm_openai",
        "llm_other",
        "retrieval_real",
        "local_execution",
        "symbolic_checker",
        "human"
      ],
      "title": "BackendKind",
      "type": "string"
    },
    "EvidenceArtifactPlan": {
      "additionalProperties": false,
      "description": "One planned support artifact inside a hybrid evidence package.",
      "properties": {
        "allowed_evidence_labels": {
          "items": {
            "enum": [
              "SyntheticExperimentEvidence",
              "BenchmarkEvidence",
              "CounterexampleEvidence",
              "SymbolicDerivationDraft",
              "SymbolicReductionDraft",
              "ProofPlanDraft",
              "RetrievalNoveltyAssessment",
              "NumericalIllustrationEvidence",
              "NegativeControlEvidence",
              "RobustnessSweepEvidence",
              "NegativeResult",
              "InconclusiveResult",
              "UnsupportedRouteDeferred",
              "RejectedFalseBridge"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Evidence Labels",
          "type": "array"
        },
        "artifact_plan_id": {
          "minLength": 1,
          "title": "Artifact Plan Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/EvidenceArtifactType"
        },
        "baseline_or_comparator_plan": {
          "items": {
            "type": "string"
          },
          "title": "Baseline Or Comparator Plan",
          "type": "array"
        },
        "checker_requirements_optional": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checker Requirements Optional"
        },
        "claim_component_supported": {
          "minLength": 1,
          "title": "Claim Component Supported",
          "type": "string"
        },
        "control_plan_optional": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Control Plan Optional"
        },
        "creates_real_world_validation": {
          "const": false,
          "default": false,
          "title": "Creates Real World Validation",
          "type": "boolean"
        },
        "creates_scientific_validation": {
          "const": false,
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "execution_backend_required": {
          "minLength": 1,
          "title": "Execution Backend Required",
          "type": "string"
        },
        "failure_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Failure Criteria",
          "type": "array"
        },
        "forbidden_claims": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Forbidden Claims",
          "type": "array"
        },
        "input_contract": {
          "additionalProperties": true,
          "title": "Input Contract",
          "type": "object"
        },
        "is_verification_evidence": {
          "const": false,
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "metric_plan_optional": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Plan Optional"
        },
        "negative_control_plan_optional": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Negative Control Plan Optional"
        },
        "output_contract": {
          "additionalProperties": true,
          "title": "Output Contract",
          "type": "object"
        },
        "publication_ready": {
          "const": false,
          "default": false,
          "title": "Publication Ready",
          "type": "boolean"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "requires_code_generation": {
          "title": "Requires Code Generation",
          "type": "boolean"
        },
        "requires_llm_drafting": {
          "title": "Requires Llm Drafting",
          "type": "boolean"
        },
        "requires_local_execution": {
          "title": "Requires Local Execution",
          "type": "boolean"
        },
        "requires_retrieval": {
          "title": "Requires Retrieval",
          "type": "boolean"
        },
        "requires_symbolic_checker": {
          "title": "Requires Symbolic Checker",
          "type": "boolean"
        },
        "retrieval_requirements_optional": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Requirements Optional"
        },
        "success_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Success Criteria",
          "type": "array"
        },
        "symbolic_obligations_optional": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbolic Obligations Optional"
        }
      },
      "required": [
        "artifact_plan_id",
        "artifact_type",
        "purpose",
        "claim_component_supported",
        "input_contract",
        "output_contract",
        "execution_backend_required",
        "requires_code_generation",
        "requires_local_execution",
        "requires_retrieval",
        "requires_symbolic_checker",
        "requires_llm_drafting",
        "allowed_evidence_labels",
        "forbidden_claims",
        "success_criteria",
        "failure_criteria"
      ],
      "title": "EvidenceArtifactPlan",
      "type": "object"
    },
    "EvidenceArtifactType": {
      "description": "Hybrid evidence-package artifact roles.",
      "enum": [
        "symbolic_reduction",
        "symbolic_derivation",
        "proof_plan",
        "numerical_illustration",
        "synthetic_experiment",
        "benchmark_tournament",
        "counterexample_search",
        "literature_novelty_check",
        "negative_control",
        "robustness_sweep",
        "defer_unavailable_checker",
        "defer_insufficient_support",
        "reject_false_bridge"
      ],
      "title": "EvidenceArtifactType",
      "type": "string"
    },
    "HybridEvidencePackageCandidate": {
      "additionalProperties": false,
      "description": "LLM-authored hybrid evidence package for one selected scientific substrate.",
      "properties": {
        "adaptive_repair_decision_id_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adaptive Repair Decision Id Optional"
        },
        "allowed_claim_scope": {
          "minLength": 1,
          "title": "Allowed Claim Scope",
          "type": "string"
        },
        "artifact_dependency_graph": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Artifact Dependency Graph",
          "type": "object"
        },
        "artifact_plans": {
          "items": {
            "$ref": "#/$defs/EvidenceArtifactPlan"
          },
          "minItems": 1,
          "title": "Artifact Plans",
          "type": "array"
        },
        "claim_support_map": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Claim Support Map",
          "type": "object"
        },
        "creates_real_world_validation": {
          "const": false,
          "default": false,
          "title": "Creates Real World Validation",
          "type": "boolean"
        },
        "creates_scientific_validation": {
          "const": false,
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "creates_verified_theorem": {
          "const": false,
          "default": false,
          "title": "Creates Verified Theorem",
          "type": "boolean"
        },
        "domain_id": {
          "minLength": 1,
          "title": "Domain Id",
          "type": "string"
        },
        "implies_publication_readiness": {
          "const": false,
          "default": false,
          "title": "Implies Publication Readiness",
          "type": "boolean"
        },
        "is_verification_evidence": {
          "const": false,
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "known_gaps": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Known Gaps",
          "type": "array"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "minimum_required_artifacts": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Minimum Required Artifacts",
          "type": "array"
        },
        "novelty_proven": {
          "const": false,
          "default": false,
          "title": "Novelty Proven",
          "type": "boolean"
        },
        "optional_supporting_artifacts": {
          "items": {
            "type": "string"
          },
          "title": "Optional Supporting Artifacts",
          "type": "array"
        },
        "package_id": {
          "minLength": 1,
          "title": "Package Id",
          "type": "string"
        },
        "package_rationale": {
          "minLength": 1,
          "title": "Package Rationale",
          "type": "string"
        },
        "primary_claim_draft": {
          "minLength": 1,
          "title": "Primary Claim Draft",
          "type": "string"
        },
        "publication_ready": {
          "const": false,
          "default": false,
          "title": "Publication Ready",
          "type": "boolean"
        },
        "recommended_next_action": {
          "minLength": 1,
          "title": "Recommended Next Action",
          "type": "string"
        },
        "repair_of_package_id_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repair Of Package Id Optional"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "source_idea_node_id": {
          "minLength": 1,
          "title": "Source Idea Node Id",
          "type": "string"
        },
        "source_opportunity_id": {
          "minLength": 1,
          "title": "Source Opportunity Id",
          "type": "string"
        },
        "source_substrate_id": {
          "minLength": 1,
          "title": "Source Substrate Id",
          "type": "string"
        },
        "source_variant_id": {
          "minLength": 1,
          "title": "Source Variant Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "unresolved_obligations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Unresolved Obligations",
          "type": "array"
        }
      },
      "required": [
        "package_id",
        "run_id",
        "source_substrate_id",
        "source_idea_node_id",
        "source_variant_id",
        "source_opportunity_id",
        "domain_id",
        "method_id",
        "title",
        "primary_claim_draft",
        "allowed_claim_scope",
        "package_rationale",
        "artifact_plans",
        "minimum_required_artifacts",
        "known_gaps",
        "unresolved_obligations",
        "recommended_next_action"
      ],
      "title": "HybridEvidencePackageCandidate",
      "type": "object"
    },
    "HybridEvidencePackageScore": {
      "additionalProperties": false,
      "description": "Non-fake LLM score for one hybrid evidence package.",
      "properties": {
        "artifact_coherence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Artifact Coherence",
          "type": "number"
        },
        "baseline_quality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Baseline Quality",
          "type": "number"
        },
        "claim_specificity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Claim Specificity",
          "type": "number"
        },
        "control_quality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Control Quality",
          "type": "number"
        },
        "execution_feasibility": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Execution Feasibility",
          "type": "number"
        },
        "false_bridge_penalty": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "False Bridge Penalty",
          "type": "number"
        },
        "final_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Final Score",
          "type": "number"
        },
        "negative_control_quality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Negative Control Quality",
          "type": "number"
        },
        "package_id": {
          "minLength": 1,
          "title": "Package Id",
          "type": "string"
        },
        "paper_shape_clarity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Paper Shape Clarity",
          "type": "number"
        },
        "retrieval_need_clarity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Retrieval Need Clarity",
          "type": "number"
        },
        "scope_risk_penalty": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Scope Risk Penalty",
          "type": "number"
        },
        "score_explanation": {
          "minLength": 1,
          "title": "Score Explanation",
          "type": "string"
        },
        "symbolic_obligation_clarity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Symbolic Obligation Clarity",
          "type": "number"
        },
        "tautology_penalty": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Tautology Penalty",
          "type": "number"
        },
        "verification_feasibility": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Verification Feasibility",
          "type": "number"
        }
      },
      "required": [
        "package_id",
        "claim_specificity",
        "artifact_coherence",
        "verification_feasibility",
        "baseline_quality",
        "control_quality",
        "negative_control_quality",
        "symbolic_obligation_clarity",
        "retrieval_need_clarity",
        "execution_feasibility",
        "paper_shape_clarity",
        "false_bridge_penalty",
        "tautology_penalty",
        "scope_risk_penalty",
        "final_score",
        "score_explanation"
      ],
      "title": "HybridEvidencePackageScore",
      "type": "object"
    },
    "ScientificStageKind": {
      "description": "Scientific-generation, judgment, execution, and validation stage classes.",
      "enum": [
        "opportunity_discovery",
        "atlas_construction",
        "compatibility_filter",
        "pair_ranking",
        "diversity_selection",
        "idea_tree_construction",
        "variance_generation",
        "substrate_construction",
        "substrate_selection",
        "branch_routing",
        "experiment_design",
        "spec_validation",
        "experiment_code_generation",
        "code_safety_audit",
        "experiment_execution",
        "metric_computation",
        "hybrid_evidence_planning",
        "symbolic_derivation",
        "adjudication",
        "adjudication_score_aggregation",
        "critic_review",
        "literature_retrieval",
        "novelty_assessment",
        "manuscript_planning",
        "manuscript_synthesis",
        "manuscript_artifact_assembly",
        "claim_audit",
        "bundle_verification"
      ],
      "title": "ScientificStageKind",
      "type": "string"
    },
    "StageBackendRecord": {
      "additionalProperties": false,
      "description": "Explicit authority classification for one pipeline stage backend.",
      "properties": {
        "allowed_in_production": {
          "title": "Allowed In Production",
          "type": "boolean"
        },
        "artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "backend_kind": {
          "$ref": "#/$defs/BackendKind"
        },
        "backend_name": {
          "minLength": 1,
          "title": "Backend Name",
          "type": "string"
        },
        "fallback_disclosed": {
          "default": true,
          "title": "Fallback Disclosed",
          "type": "boolean"
        },
        "fallback_used": {
          "default": false,
          "title": "Fallback Used",
          "type": "boolean"
        },
        "is_execution_or_verification": {
          "title": "Is Execution Or Verification",
          "type": "boolean"
        },
        "is_scientific_generation": {
          "title": "Is Scientific Generation",
          "type": "boolean"
        },
        "is_scientific_judgment": {
          "title": "Is Scientific Judgment",
          "type": "boolean"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "stage_id": {
          "minLength": 1,
          "title": "Stage Id",
          "type": "string"
        },
        "stage_kind": {
          "$ref": "#/$defs/ScientificStageKind"
        }
      },
      "required": [
        "stage_id",
        "stage_kind",
        "backend_kind",
        "backend_name",
        "is_scientific_generation",
        "is_scientific_judgment",
        "is_execution_or_verification",
        "allowed_in_production",
        "reason"
      ],
      "title": "StageBackendRecord",
      "type": "object"
    }
  },
  "$id": "https://schemas.factori.local/0.84.0/hybrid-evidence-package-inspection-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Read-only inspection of the latest hybrid evidence-package plan.",
  "properties": {
    "artifact_plan_count": {
      "default": 0,
      "minimum": 0,
      "title": "Artifact Plan Count",
      "type": "integer"
    },
    "artifact_type_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Artifact Type Counts",
      "type": "object"
    },
    "artifact_type_coverage": {
      "default": 0,
      "minimum": 0,
      "title": "Artifact Type Coverage",
      "type": "integer"
    },
    "backend_records": {
      "items": {
        "$ref": "#/$defs/StageBackendRecord"
      },
      "title": "Backend Records",
      "type": "array"
    },
    "creates_real_world_validation": {
      "const": false,
      "default": false,
      "title": "Creates Real World Validation",
      "type": "boolean"
    },
    "creates_scientific_validation": {
      "const": false,
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "hybrid_evidence_package_present": {
      "title": "Hybrid Evidence Package Present",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "const": false,
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "latest_report_id_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Report Id Optional"
    },
    "package_count": {
      "default": 0,
      "minimum": 0,
      "title": "Package Count",
      "type": "integer"
    },
    "packages": {
      "items": {
        "$ref": "#/$defs/HybridEvidencePackageCandidate"
      },
      "title": "Packages",
      "type": "array"
    },
    "planning_status_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Planning Status Optional"
    },
    "production_ready": {
      "default": false,
      "title": "Production Ready",
      "type": "boolean"
    },
    "publication_ready": {
      "const": false,
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "rejected_package_count": {
      "default": 0,
      "minimum": 0,
      "title": "Rejected Package Count",
      "type": "integer"
    },
    "repaired_package_count": {
      "default": 0,
      "minimum": 0,
      "title": "Repaired Package Count",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "scores": {
      "items": {
        "$ref": "#/$defs/HybridEvidencePackageScore"
      },
      "title": "Scores",
      "type": "array"
    },
    "selected_substrate_count": {
      "default": 0,
      "minimum": 0,
      "title": "Selected Substrate Count",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "hybrid_evidence_package_present"
  ],
  "title": "HybridEvidencePackageInspectionReport",
  "type": "object",
  "x-factori-protocol-version": "0.84.0",
  "x-factori-source-model": "factori.schemas.HybridEvidencePackageInspectionReport",
  "x-factori-verification-evidence": false
}
