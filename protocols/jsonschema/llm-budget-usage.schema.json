{
  "$id": "https://schemas.factori.local/0.61.0/llm-budget-usage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Planned or observed LLM usage accounting.",
  "properties": {
    "candidate_generation_calls": {
      "default": 0,
      "minimum": 0,
      "title": "Candidate Generation Calls",
      "type": "integer"
    },
    "claim_adjudication_calls": {
      "default": 0,
      "minimum": 0,
      "title": "Claim Adjudication Calls",
      "type": "integer"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "estimated_cost_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Cost Usd"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "prose_calls": {
      "default": 0,
      "minimum": 0,
      "title": "Prose Calls",
      "type": "integer"
    },
    "quality_repair_calls": {
      "default": 0,
      "minimum": 0,
      "title": "Quality Repair Calls",
      "type": "integer"
    },
    "rate_limit_per_minute": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rate Limit Per Minute"
    },
    "review_calls": {
      "default": 0,
      "minimum": 0,
      "title": "Review Calls",
      "type": "integer"
    },
    "source_relevance_adjudication_calls": {
      "default": 0,
      "minimum": 0,
      "title": "Source Relevance Adjudication Calls",
      "type": "integer"
    },
    "total_calls": {
      "default": 0,
      "minimum": 0,
      "title": "Total Calls",
      "type": "integer"
    },
    "total_input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Input Tokens"
    },
    "total_output_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Output Tokens"
    },
    "unknown_cost": {
      "default": false,
      "title": "Unknown Cost",
      "type": "boolean"
    },
    "unknown_token_usage": {
      "default": false,
      "title": "Unknown Token Usage",
      "type": "boolean"
    }
  },
  "title": "LLMBudgetUsage",
  "type": "object",
  "x-factori-protocol-version": "0.61.0",
  "x-factori-source-model": "factori.schemas.LLMBudgetUsage",
  "x-factori-verification-evidence": false
}
