{
  "$id": "https://schemas.factori.local/0.10.0/literature-positioning-assessment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Literature-positioning diagnostic assessment.",
  "properties": {
    "findings": {
      "items": {
