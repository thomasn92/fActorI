{
  "$id": "https://schemas.factori.local/0.89.0/mutation-tournament-entry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One original or mutation substrate branch in a mutation tournament.",
  "properties": {
    "baseline_metric": {
      "default": 0.0,
      "title": "Baseline Metric",
      "type": "number"
    },
    "branch_role": {
      "enum": [
        "original_winner",
        "mutation"
      ],
      "title": "Branch Role",
      "type": "string"
    },
    "complexity_adjusted_score": {
      "default": 0.0,
      "title": "Complexity Adjusted Score",
      "type": "number"
    },
    "complexity_penalty_optional": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Complexity Penalty Optional"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "entry_id": {
      "minLength": 1,
      "title": "Entry Id",
      "type": "string"
    },
    "experiment_artifact_path_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Experiment Artifact Path Optional"
    },
    "experiment_bundle_id": {
      "minLength": 1,
      "title": "Experiment Bundle Id",
      "type": "string"
    },
    "experiment_spec_path_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Experiment Spec Path Optional"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "improvement_ratio": {
      "default": 0.0,
      "title": "Improvement Ratio",
      "type": "number"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "method_metric": {
      "default": 0.0,
      "title": "Method Metric",
      "type": "number"
    },
    "outcome_label": {
      "enum": [
        "original_winner_baseline",
        "mutation_improved",
        "mutation_matched",
        "mutation_failed",
        "mutation_inconclusive"
      ],
      "title": "Outcome Label",
      "type": "string"
    },
    "primary_metric": {
      "default": 0.0,
      "title": "Primary Metric",
      "type": "number"
    },
    "publication_ready": {
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "raw_score": {
      "default": 0.0,
      "title": "Raw Score",
      "type": "number"
    },
    "result_label_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Label Optional"
    },
    "robustness_metric_optional": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Robustness Metric Optional"
    },
    "sandbox_report_path_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sandbox Report Path Optional"
    },
    "score": {
      "default": 0.0,
      "title": "Score",
      "type": "number"
    },
    "selected_as_second_generation_winner": {
      "default": false,
      "title": "Selected As Second Generation Winner",
      "type": "boolean"
    },
    "status": {
      "enum": [
        "completed",
        "negative_result",
        "inconclusive",
        "failed",
        "not_run"
      ],
      "title": "Status",
      "type": "string"
    },
    "substrate_id": {
      "minLength": 1,
      "title": "Substrate Id",
      "type": "string"
    },
    "substrate_model_type": {
      "minLength": 1,
      "title": "Substrate Model Type",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "entry_id",
    "substrate_id",
    "title",
    "substrate_model_type",
    "branch_role",
    "experiment_bundle_id",
    "status",
    "outcome_label"
  ],
  "title": "MutationTournamentEntry",
  "type": "object",
  "x-factori-protocol-version": "0.89.0",
  "x-factori-source-model": "factori.schemas.MutationTournamentEntry",
  "x-factori-verification-evidence": false
}
