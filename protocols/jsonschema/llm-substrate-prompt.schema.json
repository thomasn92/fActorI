{
  "$id": "https://schemas.factori.local/0.84.0/llm-substrate-prompt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Secret-free prompt contract for one selected LLM variance node.",
  "properties": {
    "backend_name": {
      "minLength": 1,
      "title": "Backend Name",
      "type": "string"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "opportunity_payload": {
      "additionalProperties": true,
      "title": "Opportunity Payload",
      "type": "object"
    },
    "prompt_id": {
      "minLength": 1,
      "title": "Prompt Id",
      "type": "string"
    },
    "prompt_text": {
      "minLength": 1,
      "title": "Prompt Text",
      "type": "string"
    },
    "requested_output_schema": {
      "additionalProperties": true,
      "title": "Requested Output Schema",
      "type": "object"
    },
    "retrieval_context_payload": {
      "additionalProperties": true,
      "title": "Retrieval Context Payload",
      "type": "object"
    },
    "source_payload": {
      "additionalProperties": true,
      "title": "Source Payload",
      "type": "object"
    },
    "source_variant_id": {
      "minLength": 1,
      "title": "Source Variant Id",
      "type": "string"
    }
  },
  "required": [
    "prompt_id",
    "backend_name",
    "model",
    "source_variant_id",
    "source_payload",
    "opportunity_payload",
    "retrieval_context_payload",
    "prompt_text",
    "requested_output_schema"
  ],
  "title": "LLMSubstratePrompt",
  "type": "object",
  "x-factori-protocol-version": "0.84.0",
  "x-factori-source-model": "factori.schemas.LLMSubstratePrompt",
  "x-factori-verification-evidence": false
}
