{
  "$id": "https://schemas.factori.local/0.89.0/mutation-tournament-spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Execution plan for a second-generation mutation substrate tournament.",
  "properties": {
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "execution_backend": {
      "const": "uv_local",
      "default": "uv_local",
      "title": "Execution Backend",
      "type": "string"
    },
    "experiment_spec_paths": {
      "items": {
        "type": "string"
      },
      "title": "Experiment Spec Paths",
      "type": "array"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "mutation_substrate_ids": {
      "items": {
        "type": "string"
      },
      "title": "Mutation Substrate Ids",
      "type": "array"
    },
    "mutation_tournament_id": {
      "minLength": 1,
      "title": "Mutation Tournament Id",
      "type": "string"
    },
    "original_winner_substrate_id": {
      "minLength": 1,
      "title": "Original Winner Substrate Id",
      "type": "string"
    },
    "publication_ready": {
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "selection_policy": {
      "minLength": 1,
      "title": "Selection Policy",
      "type": "string"
    },
    "source_creative_mutation_report_path_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Creative Mutation Report Path Optional"
    },
    "source_scientific_substrate_build_path_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Scientific Substrate Build Path Optional"
    },
    "source_substrate_tournament_result_path_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Substrate Tournament Result Path Optional"
    },
    "substrate_count": {
      "minimum": 0,
      "title": "Substrate Count",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "mutation_tournament_id",
    "original_winner_substrate_id",
    "selection_policy",
    "substrate_count"
  ],
  "title": "MutationTournamentSpec",
  "type": "object",
  "x-factori-protocol-version": "0.89.0",
  "x-factori-source-model": "factori.schemas.MutationTournamentSpec",
  "x-factori-verification-evidence": false
}
