{
  "$defs": {
    "BackendKind": {
      "description": "Authority classification for scientific and infrastructure backends.",
      "enum": [
        "fake",
        "fixture",
        "deterministic_template",
        "curated_catalog",
        "heuristic",
        "llm_openai",
        "llm_other",
        "retrieval_real",
        "local_execution",
        "symbolic_checker",
        "human"
      ],
      "title": "BackendKind",
      "type": "string"
    },
    "LLMScientificSubstrateCandidate": {
      "additionalProperties": false,
      "description": "One LLM-authored concrete scientific substrate candidate.",
      "properties": {
        "assumptions": {
          "items": {
            "$ref": "#/$defs/ScientificSubstrateAssumption"
          },
          "minItems": 1,
          "title": "Assumptions",
          "type": "array"
        },
        "baseline_candidates": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Baseline Candidates",
          "type": "array"
        },
        "benchmark_design": {
          "minLength": 1,
          "title": "Benchmark Design",
          "type": "string"
        },
        "central_tension": {
          "minLength": 1,
          "title": "Central Tension",
          "type": "string"
        },
        "concrete_model_object": {
          "$ref": "#/$defs/ScientificSubstrateModelObject"
        },
        "creates_scientific_validation": {
          "const": false,
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "domain_id": {
          "minLength": 1,
          "title": "Domain Id",
          "type": "string"
        },
        "domain_problem": {
          "minLength": 1,
          "title": "Domain Problem",
          "type": "string"
        },
        "expected_metrics": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Expected Metrics",
          "type": "array"
        },
        "experiment_or_proof_design": {
          "$ref": "#/$defs/ScientificSubstrateExperimentDesign"
        },
        "failure_modes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Failure Modes",
          "type": "array"
        },
        "false_bridge_risk": {
          "minLength": 1,
          "title": "False Bridge Risk",
          "type": "string"
        },
        "hypothesis": {
          "minLength": 1,
          "title": "Hypothesis",
          "type": "string"
        },
        "implies_publication_readiness": {
          "const": false,
          "default": false,
          "title": "Implies Publication Readiness",
          "type": "boolean"
        },
        "is_verification_evidence": {
          "const": false,
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "mathematical_or_computational_form": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Mathematical Or Computational Form",
          "type": "array"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "negative_controls": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Negative Controls",
          "type": "array"
        },
        "novelty_risk": {
          "minLength": 1,
          "title": "Novelty Risk",
          "type": "string"
        },
        "publication_ready": {
          "const": false,
          "default": false,
          "title": "Publication Ready",
          "type": "boolean"
        },
        "result_schema": {
          "$ref": "#/$defs/ScientificSubstrateResultSchema"
        },
        "route_hint": {
          "enum": [
            "synthetic_experiment",
            "benchmark_tournament",
            "counterexample_search",
            "symbolic_derivation",
            "applied_math_reduction",
            "proof_plan",
            "literature_novelty_check",
            "defer_insufficient_substrate",
            "reject_false_bridge"
          ],
          "title": "Route Hint",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "scope_boundary": {
          "minLength": 1,
          "title": "Scope Boundary",
          "type": "string"
        },
        "source_idea_node_id": {
          "minLength": 1,
          "title": "Source Idea Node Id",
          "type": "string"
        },
        "source_opportunity_id": {
          "minLength": 1,
          "title": "Source Opportunity Id",
          "type": "string"
        },
        "source_pair_id": {
          "minLength": 1,
          "title": "Source Pair Id",
          "type": "string"
        },
        "source_variant_id": {
          "minLength": 1,
          "title": "Source Variant Id",
          "type": "string"
        },
        "substrate_id": {
          "minLength": 1,
          "title": "Substrate Id",
          "type": "string"
        },
        "tautology_risk": {
          "minLength": 1,
          "title": "Tautology Risk",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "variables_and_notation": {
          "items": {
            "$ref": "#/$defs/ScientificSubstrateVariable"
          },
          "minItems": 1,
          "title": "Variables And Notation",
          "type": "array"
        },
        "verification_path": {
          "minLength": 1,
          "title": "Verification Path",
          "type": "string"
        }
      },
      "required": [
        "substrate_id",
        "run_id",
        "source_idea_node_id",
        "source_variant_id",
        "source_opportunity_id",
        "source_pair_id",
        "domain_id",
        "method_id",
        "title",
        "domain_problem",
        "central_tension",
        "concrete_model_object",
        "mathematical_or_computational_form",
        "variables_and_notation",
        "assumptions",
        "hypothesis",
        "baseline_candidates",
        "experiment_or_proof_design",
        "benchmark_design",
        "negative_controls",
        "result_schema",
        "expected_metrics",
        "failure_modes",
        "limitations",
        "scope_boundary",
        "verification_path",
        "route_hint",
        "novelty_risk",
        "false_bridge_risk",
        "tautology_risk"
      ],
      "title": "LLMScientificSubstrateCandidate",
      "type": "object"
    },
    "LLMSubstrateConstructionScore": {
      "additionalProperties": false,
      "description": "Non-fake LLM score for one constructed scientific substrate.",
      "properties": {
        "assumption_clarity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Assumption Clarity",
          "type": "number"
        },
        "baseline_quality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Baseline Quality",
          "type": "number"
        },
        "failure_mode_quality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Failure Mode Quality",
          "type": "number"
        },
        "false_bridge_penalty": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "False Bridge Penalty",
          "type": "number"
        },
        "final_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Final Score",
          "type": "number"
        },
        "metric_clarity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Metric Clarity",
          "type": "number"
        },
        "model_concreteness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Model Concreteness",
          "type": "number"
        },
        "negative_control_quality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Negative Control Quality",
          "type": "number"
        },
        "paper_coherence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Paper Coherence",
          "type": "number"
        },
        "scope_risk_penalty": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Scope Risk Penalty",
          "type": "number"
        },
        "score_explanation": {
          "minLength": 1,
          "title": "Score Explanation",
          "type": "string"
        },
        "substrate_id": {
          "minLength": 1,
          "title": "Substrate Id",
          "type": "string"
        },
        "tautology_penalty": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Tautology Penalty",
          "type": "number"
        },
        "verification_feasibility": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Verification Feasibility",
          "type": "number"
        }
      },
      "required": [
        "substrate_id",
        "model_concreteness",
        "baseline_quality",
        "verification_feasibility",
        "assumption_clarity",
        "metric_clarity",
        "negative_control_quality",
        "failure_mode_quality",
        "paper_coherence",
        "false_bridge_penalty",
        "tautology_penalty",
        "scope_risk_penalty",
        "final_score",
        "score_explanation"
      ],
      "title": "LLMSubstrateConstructionScore",
      "type": "object"
    },
    "ScientificStageKind": {
      "description": "Scientific-generation, judgment, execution, and validation stage classes.",
      "enum": [
        "opportunity_discovery",
        "atlas_construction",
        "compatibility_filter",
        "pair_ranking",
        "diversity_selection",
        "idea_tree_construction",
        "variance_generation",
        "substrate_construction",
        "substrate_selection",
        "branch_routing",
        "experiment_design",
        "spec_validation",
        "experiment_code_generation",
        "code_safety_audit",
        "experiment_execution",
        "metric_computation",
        "hybrid_evidence_planning",
        "symbolic_derivation",
        "adjudication",
        "adjudication_score_aggregation",
        "critic_review",
        "literature_retrieval",
        "novelty_assessment",
        "manuscript_planning",
        "manuscript_synthesis",
        "manuscript_artifact_assembly",
        "claim_audit",
        "bundle_verification"
      ],
      "title": "ScientificStageKind",
      "type": "string"
    },
    "ScientificSubstrateAssumption": {
      "additionalProperties": false,
      "description": "One explicit modeling or experimental assumption.",
      "properties": {
        "assumption_id": {
          "minLength": 1,
          "title": "Assumption Id",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "violation_consequence": {
          "minLength": 1,
          "title": "Violation Consequence",
          "type": "string"
        }
      },
      "required": [
        "assumption_id",
        "statement",
        "rationale",
        "violation_consequence"
      ],
      "title": "ScientificSubstrateAssumption",
      "type": "object"
    },
    "ScientificSubstrateExperimentDesign": {
      "additionalProperties": false,
      "description": "Experiment design tied to one substrate and bounded target claim.",
      "properties": {
        "ablation_or_stress_test": {
          "minLength": 1,
          "title": "Ablation Or Stress Test",
          "type": "string"
        },
        "baseline": {
          "minLength": 1,
          "title": "Baseline",
          "type": "string"
        },
        "data_regime": {
          "minLength": 1,
          "title": "Data Regime",
          "type": "string"
        },
        "dgp": {
          "minLength": 1,
          "title": "Dgp",
          "type": "string"
        },
        "failure_criterion": {
          "minLength": 1,
          "title": "Failure Criterion",
          "type": "string"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "metrics": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "seed_plan": {
          "minLength": 1,
          "title": "Seed Plan",
          "type": "string"
        },
        "success_criterion": {
          "minLength": 1,
          "title": "Success Criterion",
          "type": "string"
        },
        "target_claim": {
          "minLength": 1,
          "title": "Target Claim",
          "type": "string"
        },
        "train_test_split_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Test Split Optional"
        }
      },
      "required": [
        "target_claim",
        "data_regime",
        "dgp",
        "baseline",
        "method",
        "metrics",
        "seed_plan",
        "ablation_or_stress_test",
        "success_criterion",
        "failure_criterion"
      ],
      "title": "ScientificSubstrateExperimentDesign",
      "type": "object"
    },
    "ScientificSubstrateModelObject": {
      "additionalProperties": false,
      "description": "Concrete model object for a generated scientific substrate.",
      "properties": {
        "algorithm_optional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Algorithm Optional"
        },
        "equations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Equations",
          "type": "array"
        },
        "identifiability_notes": {
          "minLength": 1,
          "title": "Identifiability Notes",
          "type": "string"
        },
        "model_type": {
          "minLength": 1,
          "title": "Model Type",
          "type": "string"
        },
        "parameter_interpretation": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Parameter Interpretation",
          "type": "array"
        },
        "what_would_falsify_it": {
          "minLength": 1,
          "title": "What Would Falsify It",
          "type": "string"
        }
      },
      "required": [
        "model_type",
        "equations",
        "parameter_interpretation",
        "identifiability_notes",
        "what_would_falsify_it"
      ],
      "title": "ScientificSubstrateModelObject",
      "type": "object"
    },
    "ScientificSubstrateResultSchema": {
      "additionalProperties": false,
      "description": "Expected result table and support rule for a substrate experiment.",
      "properties": {
        "baseline_metric_names": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Baseline Metric Names",
          "type": "array"
        },
        "claim_not_supported_if": {
          "minLength": 1,
          "title": "Claim Not Supported If",
          "type": "string"
        },
        "claim_supported_if": {
          "minLength": 1,
          "title": "Claim Supported If",
          "type": "string"
        },
        "comparison_direction": {
          "minLength": 1,
          "title": "Comparison Direction",
          "type": "string"
        },
        "method_metric_names": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Method Metric Names",
          "type": "array"
        },
        "required_table_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Table Columns",
          "type": "array"
        }
      },
      "required": [
        "baseline_metric_names",
        "method_metric_names",
        "comparison_direction",
        "required_table_columns",
        "claim_supported_if",
        "claim_not_supported_if"
      ],
      "title": "ScientificSubstrateResultSchema",
      "type": "object"
    },
    "ScientificSubstrateVariable": {
      "additionalProperties": false,
      "description": "One variable or notation item in a concrete scientific substrate.",
      "properties": {
        "definition": {
          "minLength": 1,
          "title": "Definition",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "symbol": {
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "definition",
        "role"
      ],
      "title": "ScientificSubstrateVariable",
      "type": "object"
    },
    "StageBackendRecord": {
      "additionalProperties": false,
      "description": "Explicit authority classification for one pipeline stage backend.",
      "properties": {
        "allowed_in_production": {
          "title": "Allowed In Production",
          "type": "boolean"
        },
        "artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "backend_kind": {
          "$ref": "#/$defs/BackendKind"
        },
        "backend_name": {
          "minLength": 1,
          "title": "Backend Name",
          "type": "string"
        },
        "fallback_disclosed": {
          "default": true,
          "title": "Fallback Disclosed",
          "type": "boolean"
        },
        "fallback_used": {
          "default": false,
          "title": "Fallback Used",
          "type": "boolean"
        },
        "is_execution_or_verification": {
          "title": "Is Execution Or Verification",
          "type": "boolean"
        },
        "is_scientific_generation": {
          "title": "Is Scientific Generation",
          "type": "boolean"
        },
        "is_scientific_judgment": {
          "title": "Is Scientific Judgment",
          "type": "boolean"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "stage_id": {
          "minLength": 1,
          "title": "Stage Id",
          "type": "string"
        },
        "stage_kind": {
          "$ref": "#/$defs/ScientificStageKind"
        }
      },
      "required": [
        "stage_id",
        "stage_kind",
        "backend_kind",
        "backend_name",
        "is_scientific_generation",
        "is_scientific_judgment",
        "is_execution_or_verification",
        "allowed_in_production",
        "reason"
      ],
      "title": "StageBackendRecord",
      "type": "object"
    }
  },
  "$id": "https://schemas.factori.local/0.83.0/llm-substrate-construction-inspection-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Read-only inspection of the latest LLM substrate construction report.",
  "properties": {
    "backend_records": {
      "items": {
        "$ref": "#/$defs/StageBackendRecord"
      },
      "title": "Backend Records",
      "type": "array"
    },
    "constructed_substrate_count": {
      "default": 0,
      "minimum": 0,
      "title": "Constructed Substrate Count",
      "type": "integer"
    },
    "construction_status_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Construction Status Optional"
    },
    "creates_scientific_validation": {
      "const": false,
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "domain_family_coverage": {
      "default": 0,
      "minimum": 0,
      "title": "Domain Family Coverage",
      "type": "integer"
    },
    "implies_publication_readiness": {
      "const": false,
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "const": false,
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "latest_report_id_optional": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Report Id Optional"
    },
    "llm_substrate_construction_present": {
      "title": "Llm Substrate Construction Present",
      "type": "boolean"
    },
    "method_family_coverage": {
      "default": 0,
      "minimum": 0,
      "title": "Method Family Coverage",
      "type": "integer"
    },
    "near_duplicate_suppressed_count": {
      "default": 0,
      "minimum": 0,
      "title": "Near Duplicate Suppressed Count",
      "type": "integer"
    },
    "production_ready": {
      "default": false,
      "title": "Production Ready",
      "type": "boolean"
    },
    "publication_ready": {
      "const": false,
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "rejected_substrate_count": {
      "default": 0,
      "minimum": 0,
      "title": "Rejected Substrate Count",
      "type": "integer"
    },
    "repaired_substrate_count": {
      "default": 0,
      "minimum": 0,
      "title": "Repaired Substrate Count",
      "type": "integer"
    },
    "route_hint_coverage": {
      "default": 0,
      "minimum": 0,
      "title": "Route Hint Coverage",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "selected_scores": {
      "items": {
        "$ref": "#/$defs/LLMSubstrateConstructionScore"
      },
      "title": "Selected Scores",
      "type": "array"
    },
    "selected_substrate_count": {
      "default": 0,
      "minimum": 0,
      "title": "Selected Substrate Count",
      "type": "integer"
    },
    "selected_substrates": {
      "items": {
        "$ref": "#/$defs/LLMScientificSubstrateCandidate"
      },
      "title": "Selected Substrates",
      "type": "array"
    },
    "source_variant_count": {
      "default": 0,
      "minimum": 0,
      "title": "Source Variant Count",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "llm_substrate_construction_present"
  ],
  "title": "LLMSubstrateConstructionInspectionReport",
  "type": "object",
  "x-factori-protocol-version": "0.83.0",
  "x-factori-source-model": "factori.schemas.LLMSubstrateConstructionInspectionReport",
  "x-factori-verification-evidence": false
}
