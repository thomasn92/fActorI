{
  "$id": "https://schemas.factori.local/0.69.0/compatibility-exclusion.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One deterministic negative compatibility finding without opportunity authority.",
  "properties": {
    "decorative_vocabulary_risk": {
      "title": "Decorative Vocabulary Risk",
      "type": "boolean"
    },
    "excluded": {
      "title": "Excluded",
      "type": "boolean"
    },
    "exclusion_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Exclusion Reasons",
      "type": "array"
    },
    "missing_baseline": {
      "title": "Missing Baseline",
      "type": "boolean"
    },
    "missing_data_or_simulation_path": {
      "title": "Missing Data Or Simulation Path",
      "type": "boolean"
    },
    "missing_object_mapping": {
      "title": "Missing Object Mapping",
      "type": "boolean"
    },
    "missing_verification_path": {
      "title": "Missing Verification Path",
      "type": "boolean"
    },
    "pair_id": {
      "minLength": 1,
      "title": "Pair Id",
      "type": "string"
    }
  },
  "required": [
    "pair_id",
    "excluded",
    "missing_object_mapping",
    "missing_baseline",
    "missing_verification_path",
    "missing_data_or_simulation_path",
    "decorative_vocabulary_risk"
  ],
  "title": "CompatibilityExclusion",
  "type": "object",
  "x-factori-protocol-version": "0.69.0",
  "x-factori-source-model": "factori.schemas.CompatibilityExclusion",
  "x-factori-verification-evidence": false
}
