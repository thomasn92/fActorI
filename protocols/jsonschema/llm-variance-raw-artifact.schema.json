        }
      },
      "required": [
        "prompt_id",
        "backend_name",
        "model",
        "source_opportunity_id",
        "requested_variant_count",
        "source_payload",
        "retrieval_context_payload",
        "prompt_text",
        "requested_output_schema"
      ],
      "title": "LLMVariancePrompt",
      "type": "object"
    }
  },
  "$id": "https://schemas.factori.local/0.86.0/llm-variance-raw-artifact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Secret-free raw prompt and response provenance for one variance call.",
  "properties": {
    "accepted_variant_ids": {
      "items": {
        "type": "string"
