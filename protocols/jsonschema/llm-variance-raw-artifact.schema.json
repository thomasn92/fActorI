          "title": "Model",
          "type": "string"
        },
        "prompt_id": {
          "minLength": 1,
          "title": "Prompt Id",
          "type": "string"
        },
        "prompt_text": {
          "minLength": 1,
          "title": "Prompt Text",
          "type": "string"
        },
        "requested_output_schema": {
          "additionalProperties": true,
          "title": "Requested Output Schema",
          "type": "object"
        },
        "requested_variant_count": {
