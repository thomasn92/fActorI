      "type": "boolean"
    },
    "fallback_used": {
      "default": false,
      "title": "Fallback Used",
      "type": "boolean"
    },
    "implies_publication_readiness": {
      "const": false,
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "const": false,
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "prompt": {
      "$ref": "#/$defs/LLMVariancePrompt"
