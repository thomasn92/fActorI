{
  "$defs": {
    "SourceRelevanceAdjudication": {
      "additionalProperties": false,
      "description": "Bounded source-relevance judgment; never verification evidence.",
      "properties": {
        "accepted_for_background_context": {
          "title": "Accepted For Background Context",
          "type": "boolean"
        },
        "adjudicated_relevance_label": {
          "enum": [
            "highly_relevant_background",
            "partially_relevant_background",
            "weakly_relevant",
            "irrelevant",
            "metadata_insufficient",
            "duplicate",
            "unsafe_or_invalid_source"
          ],
          "title": "Adjudicated Relevance Label",
          "type": "string"
        },
        "adjudicated_relevance_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Adjudicated Relevance Score",
          "type": "number"
        },
        "adjudicator_backend": {
          "minLength": 1,
          "title": "Adjudicator Backend",
          "type": "string"
        },
        "adjudicator_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudicator Model"
        },
        "candidate_title_or_problem": {
          "minLength": 1,
          "title": "Candidate Title Or Problem",
          "type": "string"
        },
        "claims_literature_coverage": {
          "default": false,
          "title": "Claims Literature Coverage",
          "type": "boolean"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "creates_scientific_validation": {
          "default": false,
          "title": "Creates Scientific Validation",
          "type": "boolean"
        },
        "deterministic_relevance_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Deterministic Relevance Score",
          "type": "number"
        },
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "implies_publication_readiness": {
          "default": false,
          "title": "Implies Publication Readiness",
          "type": "boolean"
        },
        "is_verification_evidence": {
          "default": false,
          "title": "Is Verification Evidence",
          "type": "boolean"
        },
        "proves_novelty": {
          "default": false,
          "title": "Proves Novelty",
          "type": "boolean"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "reasoning_brief": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reasoning Brief",
          "type": "string"
        },
        "rejection_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejection Reason"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "title",
        "source_hash",
        "query",
        "domain",
        "candidate_title_or_problem",
        "deterministic_relevance_score",
        "adjudicated_relevance_label",
        "adjudicated_relevance_score",
        "accepted_for_background_context",
        "reasoning_brief",
        "confidence",
        "adjudicator_backend"
      ],
      "title": "SourceRelevanceAdjudication",
      "type": "object"
    }
  },
  "$id": "https://schemas.factori.local/0.20.0/retrieval-quality-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded source-quality and relevance filtering report.",
  "properties": {
    "accepted_source_count": {
      "minimum": 0,
      "title": "Accepted Source Count",
      "type": "integer"
    },
    "accepted_source_ids": {
      "items": {
        "type": "string"
      },
      "title": "Accepted Source Ids",
      "type": "array"
    },
    "adequacy_status": {
      "default": "not_evaluated",
      "enum": [
        "not_evaluated",
        "insufficient_sources",
        "bounded_context_only",
        "adequate_for_background_context"
      ],
      "title": "Adequacy Status",
      "type": "string"
    },
    "adjudicated_source_count": {
      "default": 0,
      "minimum": 0,
      "title": "Adjudicated Source Count",
      "type": "integer"
    },
    "adjudication_items": {
      "items": {
        "$ref": "#/$defs/SourceRelevanceAdjudication"
      },
      "title": "Adjudication Items",
      "type": "array"
    },
    "claims_literature_coverage": {
      "default": false,
      "title": "Claims Literature Coverage",
      "type": "boolean"
    },
    "coverage_limitations": {
      "items": {
        "type": "string"
      },
      "title": "Coverage Limitations",
      "type": "array"
    },
    "creates_scientific_validation": {
      "default": false,
      "title": "Creates Scientific Validation",
      "type": "boolean"
    },
    "deterministic_accept_count": {
      "default": 0,
      "minimum": 0,
      "title": "Deterministic Accept Count",
      "type": "integer"
    },
    "deterministic_reject_count": {
      "default": 0,
      "minimum": 0,
      "title": "Deterministic Reject Count",
      "type": "integer"
    },
    "duplicate_count": {
      "default": 0,
      "minimum": 0,
      "title": "Duplicate Count",
      "type": "integer"
    },
    "hard_reject_count": {
      "default": 0,
      "minimum": 0,
      "title": "Hard Reject Count",
      "type": "integer"
    },
    "implies_publication_readiness": {
      "default": false,
      "title": "Implies Publication Readiness",
      "type": "boolean"
    },
    "is_verification_evidence": {
      "default": false,
      "title": "Is Verification Evidence",
      "type": "boolean"
    },
    "llm_accepted_count": {
      "default": 0,
      "minimum": 0,
      "title": "Llm Accepted Count",
      "type": "integer"
    },
    "llm_rejected_count": {
      "default": 0,
      "minimum": 0,
      "title": "Llm Rejected Count",
      "type": "integer"
    },
    "low_relevance_count": {
      "default": 0,
      "minimum": 0,
      "title": "Low Relevance Count",
      "type": "integer"
    },
    "mean_relevance_score": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Mean Relevance Score",
      "type": "number"
    },
    "metadata_incomplete_count": {
      "default": 0,
      "minimum": 0,
      "title": "Metadata Incomplete Count",
      "type": "integer"
    },
    "min_relevance_score": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Min Relevance Score",
      "type": "number"
    },
    "proves_novelty": {
      "default": false,
      "title": "Proves Novelty",
      "type": "boolean"
    },
    "queries_used": {
      "items": {
        "type": "string"
      },
      "title": "Queries Used",
      "type": "array"
    },
    "rejected_source_count": {
      "minimum": 0,
      "title": "Rejected Source Count",
      "type": "integer"
    },
    "rejected_source_ids": {
      "items": {
        "type": "string"
      },
      "title": "Rejected Source Ids",
      "type": "array"
    },
    "rejection_reasons": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Rejection Reasons",
      "type": "object"
    },
    "retrieval_backend": {
      "minLength": 1,
      "title": "Retrieval Backend",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "source_relevance_adjudication_calls": {
      "default": 0,
      "minimum": 0,
      "title": "Source Relevance Adjudication Calls",
      "type": "integer"
    },
    "source_relevance_adjudication_enabled": {
      "default": false,
      "title": "Source Relevance Adjudication Enabled",
      "type": "boolean"
    },
    "source_relevance_adjudicator_backend": {
      "default": "off",
      "title": "Source Relevance Adjudicator Backend",
      "type": "string"
    },
    "source_relevance_adjudicator_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Relevance Adjudicator Model"
    },
    "total_retrieved_sources": {
      "minimum": 0,
      "title": "Total Retrieved Sources",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "retrieval_backend",
    "total_retrieved_sources",
    "accepted_source_count",
    "rejected_source_count"
  ],
  "title": "RetrievalQualityReport",
  "type": "object",
  "x-factori-protocol-version": "0.20.0",
  "x-factori-source-model": "factori.schemas.RetrievalQualityReport",
  "x-factori-verification-evidence": false
}
