{
  "$defs": {
    "KernelLeanEvidenceBundle": {
      "additionalProperties": false,
      "description": "Exact persisted artifact members of one real Lean Stage C bundle.",
      "properties": {
        "contract_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Contract Artifact Id",
          "type": "string"
        },
        "kind": {
          "const": "LeanProof",
          "title": "Kind",
          "type": "string"
        },
        "payload_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Payload Artifact Id",
          "type": "string"
        },
        "result_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Result Artifact Id",
          "type": "string"
        },
        "safety_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Safety Artifact Id",
          "type": "string"
        },
        "trace_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Trace Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "contract_artifact_id",
        "payload_artifact_id",
        "trace_artifact_id",
        "result_artifact_id",
        "safety_artifact_id"
      ],
      "title": "KernelLeanEvidenceBundle",
      "type": "object"
    },
    "KernelSyntheticEvidenceBundle": {
      "additionalProperties": false,
      "description": "Exact persisted artifact members of one local synthetic Stage C bundle.",
      "properties": {
        "contract_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Contract Artifact Id",
          "type": "string"
        },
        "input_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Input Artifact Id",
          "type": "string"
        },
        "kind": {
          "const": "SyntheticExperiment",
          "title": "Kind",
          "type": "string"
        },
        "output_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Output Artifact Id",
          "type": "string"
        },
        "result_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Result Artifact Id",
          "type": "string"
        },
        "safety_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Safety Artifact Id",
          "type": "string"
        },
        "trace_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Trace Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "contract_artifact_id",
        "input_artifact_id",
        "trace_artifact_id",
        "output_artifact_id",
        "result_artifact_id",
        "safety_artifact_id"
      ],
      "title": "KernelSyntheticEvidenceBundle",
      "type": "object"
    }
  },
  "$id": "https://schemas.factori.local/0.84.0/kernel-claim-evidence-locator.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Persisted evidence locator revalidated during claim resolution.",
  "properties": {
    "bundle": {
      "discriminator": {
        "mapping": {
          "LeanProof": "#/$defs/KernelLeanEvidenceBundle",
          "SyntheticExperiment": "#/$defs/KernelSyntheticEvidenceBundle"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/KernelLeanEvidenceBundle"
        },
        {
          "$ref": "#/$defs/KernelSyntheticEvidenceBundle"
        }
      ],
      "title": "Bundle"
    },
    "producing_commit_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Producing Commit Hash",
      "type": "string"
    }
  },
  "required": [
    "producing_commit_hash",
    "bundle"
  ],
  "title": "KernelClaimEvidenceLocator",
  "type": "object",
  "x-factori-protocol-version": "0.84.0",
  "x-factori-source-model": "factori.schemas.KernelClaimEvidenceLocator",
  "x-factori-verification-evidence": false
}
