        },
        "kind": {
          "const": "LeanProof",
          "title": "Kind",
          "type": "string"
        },
        "payload_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Payload Artifact Id",
          "type": "string"
        },
        "result_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Result Artifact Id",
          "type": "string"
        },
        "safety_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
