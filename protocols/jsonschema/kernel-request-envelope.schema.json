        "mode": {
          "$ref": "#/$defs/KernelMode"
        },
        "operation": {
          "const": "evidence.validate_bundle",
          "title": "Operation",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/KernelEvidenceValidateBundlePayload"
        },
        "protocol_version": {
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
