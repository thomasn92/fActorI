    "KernelArtifactVerifyPayload": {
      "additionalProperties": false,
      "description": "Payload for read-only verification of one persisted artifact.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "artifact"
      ],
      "title": "KernelArtifactVerifyPayload",
      "type": "object"
    },
    "KernelArtifactVerifyRequest": {
      "additionalProperties": false,
      "description": "Typed request for Python/Rust artifact integrity parity.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/KernelMode"
        },
        "operation": {
          "const": "artifact.verify",
          "title": "Operation",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/KernelArtifactVerifyPayload"
        },
        "protocol_version": {
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "request_id",
        "mode",
        "operation",
        "payload"
      ],
      "title": "KernelArtifactVerifyRequest",
      "type": "object"
    },
    "KernelCanonicalJsonPayload": {
      "additionalProperties": false,
      "description": "Payload for the canonical JSON operation.",
      "properties": {
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "KernelCanonicalJsonPayload",
      "type": "object"
    },
    "KernelCanonicalJsonRequest": {
      "additionalProperties": false,
      "description": "Typed request for Python-compatible canonical JSON and SHA-256.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/KernelMode"
        },
        "operation": {
          "const": "hash.canonical_json",
          "title": "Operation",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/KernelCanonicalJsonPayload"
        },
        "protocol_version": {
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "request_id",
        "mode",
        "operation",
        "payload"
      ],
      "title": "KernelCanonicalJsonRequest",
      "type": "object"
    },
    "KernelCheckpointIndexLocator": {
      "additionalProperties": false,
      "description": "Locator for the latest persisted autonomous checkpoint index.",
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "producing_commit_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Producing Commit Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "producing_commit_hash"
      ],
      "title": "KernelCheckpointIndexLocator",
      "type": "object"
    },
    "KernelCheckpointVerifyPayload": {
      "additionalProperties": false,
      "description": "Locator-only autonomous checkpoint-chain verification request.",
      "properties": {
        "index": {
          "$ref": "#/$defs/KernelCheckpointIndexLocator"
        },
        "run_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "index"
      ],
      "title": "KernelCheckpointVerifyPayload",
      "type": "object"
    },
    "KernelCheckpointVerifyRequest": {
      "additionalProperties": false,
      "description": "Typed request for autonomous checkpoint-chain verification.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/KernelMode"
        },
        "operation": {
          "const": "checkpoint.verify",
          "title": "Operation",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/KernelCheckpointVerifyPayload"
        },
        "protocol_version": {
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "request_id",
        "mode",
        "operation",
        "payload"
      ],
      "title": "KernelCheckpointVerifyRequest",
      "type": "object"
    },
    "KernelClaimEvidenceLocator": {
      "additionalProperties": false,
      "description": "Locator for the persisted bundle revalidated during claim resolution.",
      "properties": {
        "bundle": {
          "discriminator": {
            "mapping": {
              "LeanProof": "#/$defs/KernelLeanEvidenceBundle",
              "SyntheticExperiment": "#/$defs/KernelSyntheticEvidenceBundle"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/KernelLeanEvidenceBundle"
            },
            {
              "$ref": "#/$defs/KernelSyntheticEvidenceBundle"
            }
          ],
          "title": "Bundle"
        },
        "producing_commit_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Producing Commit Hash",
          "type": "string"
        }
      },
      "required": [
        "producing_commit_hash",
        "bundle"
      ],
      "title": "KernelClaimEvidenceLocator",
      "type": "object"
    },
    "KernelClaimResolvePayload": {
      "additionalProperties": false,
      "description": "Locator-only claim admissibility request with no authority-bearing input.",
      "properties": {
        "claim_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_table": {
          "$ref": "#/$defs/KernelClaimTableLocator"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/KernelClaimEvidenceLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "run_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "claim_id",
        "claim_table"
      ],
      "title": "KernelClaimResolvePayload",
      "type": "object"
    },
    "KernelClaimResolveRequest": {
      "additionalProperties": false,
      "description": "Typed request for read-only claim admissibility resolution.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/KernelMode"
        },
        "operation": {
          "const": "claim.resolve",
          "title": "Operation",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/KernelClaimResolvePayload"
        },
        "protocol_version": {
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "request_id",
        "mode",
        "operation",
        "payload"
      ],
      "title": "KernelClaimResolveRequest",
      "type": "object"
    },
    "KernelClaimTableLocator": {
      "additionalProperties": false,
