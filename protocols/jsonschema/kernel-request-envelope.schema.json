    "KernelLeanEvidenceBundle": {
      "additionalProperties": false,
      "description": "Exact persisted artifact members of one real Lean Stage C bundle.",
      "properties": {
        "contract_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
