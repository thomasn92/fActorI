          "title": "Bundle"
        },
        "candidate_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "claim_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Claim Id",
          "type": "string"
        },
        "producing_commit_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Producing Commit Hash",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "candidate_id",
        "claim_id",
        "producing_commit_hash",
        "bundle"
