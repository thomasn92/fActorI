    "KernelEvidenceValidateBundlePayload": {
      "additionalProperties": false,
      "description": "Locator-only request for strict persisted Stage C bundle validation.",
      "properties": {
        "bundle": {
          "discriminator": {
            "mapping": {
              "LeanProof": "#/$defs/KernelLeanEvidenceBundle",
              "SyntheticExperiment": "#/$defs/KernelSyntheticEvidenceBundle"
