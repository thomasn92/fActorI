    },
    {
      "$ref": "#/$defs/KernelClaimResolveRequest"
    },
    {
      "$ref": "#/$defs/KernelCheckpointVerifyRequest"
    },
    {
      "$ref": "#/$defs/KernelReplayVerifyCoreRequest"
    }
  ],
  "title": "KernelRequestEnvelope",
  "x-factori-protocol-version": "0.86.0",
