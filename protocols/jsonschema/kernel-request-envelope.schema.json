    "KernelReplayVerifyCoreRequest": {
      "additionalProperties": false,
      "description": "Typed request for bounded persisted replay-core verification.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/KernelMode"
        },
        "operation": {
          "const": "replay.verify_core",
          "title": "Operation",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/KernelReplayVerifyCorePayload"
        },
        "protocol_version": {
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "request_id",
        "mode",
        "operation",
        "payload"
      ],
      "title": "KernelReplayVerifyCoreRequest",
      "type": "object"
    },
    "KernelSyntheticEvidenceBundle": {
      "additionalProperties": false,
      "description": "Exact persisted artifact members of one local synthetic Stage C bundle.",
      "properties": {
        "contract_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Contract Artifact Id",
          "type": "string"
        },
        "input_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Input Artifact Id",
          "type": "string"
        },
        "kind": {
          "const": "SyntheticExperiment",
          "title": "Kind",
          "type": "string"
        },
        "output_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Output Artifact Id",
          "type": "string"
        },
        "result_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Result Artifact Id",
          "type": "string"
        },
        "safety_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Safety Artifact Id",
          "type": "string"
        },
        "trace_artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Trace Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "contract_artifact_id",
        "input_artifact_id",
        "trace_artifact_id",
        "output_artifact_id",
        "result_artifact_id",
        "safety_artifact_id"
      ],
      "title": "KernelSyntheticEvidenceBundle",
      "type": "object"
    },
    "LedgerCommit": {
      "additionalProperties": false,
      "description": "Immutable ledger commit.",
      "properties": {
        "action_type": {
          "$ref": "#/$defs/ControllerActionType"
        },
        "artifact_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Artifact Refs",
          "type": "array"
        },
        "candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "commit_hash": {
          "title": "Commit Hash",
          "type": "string"
        },
        "parent_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Hash"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "minLength": 1,
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "commit_hash",
        "run_id",
        "action_type",
        "timestamp"
      ],
      "title": "LedgerCommit",
      "type": "object"
    }
  },
  "$id": "https://schemas.factori.local/0.86.0/kernel-request-envelope.schema.json",
