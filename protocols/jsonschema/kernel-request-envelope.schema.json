      "hash.canonical_json": "#/$defs/KernelCanonicalJsonRequest",
      "ledger.verify": "#/$defs/KernelLedgerVerifyRequest",
      "protocol.validate": "#/$defs/KernelProtocolValidateRequest",
      "replay.verify_core": "#/$defs/KernelReplayVerifyCoreRequest"
    },
    "propertyName": "operation"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/KernelCanonicalJsonRequest"
    },
    {
      "$ref": "#/$defs/KernelProtocolValidateRequest"
    },
    {
      "$ref": "#/$defs/KernelArtifactVerifyRequest"
    },
    {
